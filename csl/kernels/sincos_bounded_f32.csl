// Qualified angle[0,7]; forward error and dense grid frozen before SDK.
fn sincos(x:f32,out:[*]f32) void {
 var n:u16=0;var select:f32=x;
 while(select>0.7853981633974483){select-=1.5707963267948966;n+=1;}
 const r:f32=(x-@as(f32,n)*1.5703125)-@as(f32,n)*0.0004838267923332751;
 const z:f32=r*r;
 var s:f32=1.6059044372074283e-10;
 s=-2.5052107943679403e-08+z*s;
 s=2.7557318844628753e-06+z*s;
 s=-0.00019841270113829523+z*s;
 s=0.008333333767950535+z*s;
 s=-0.1666666716337204+z*s;
 s=1.0+z*s;
 s=r*s;
 var c:f32=2.0876755879584152e-09;
 c=-2.755731998149713e-07+z*c;
 c=2.4801587642286904e-05+z*c;
 c=-0.0013888889225199819+z*c;
 c=0.0416666679084301+z*c;
 c=-0.5+z*c;
 c=1.0+z*c;
 out[0]=x;out[1]=r;
 const quadrant:u16=n%4;
 if(quadrant==0){out[2]=s;out[3]=c;}
 else if(quadrant==1){out[2]=c;out[3]=-s;}
 else if(quadrant==2){out[2]=-s;out[3]=-c;}
 else{out[2]=-c;out[3]=s;}
}
