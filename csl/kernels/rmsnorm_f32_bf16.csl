// Ordinary zero-centered RMS. Finite normal synthetic BF16 domain plus zero.
// Each BF16 gain is consumed before its slot is destructively replaced by output.
const math=@import_module("<math>");
fn round_bf16(raw:u32) u16 {
  const odd:u32=(raw>>16)&1;
  return @as(u16,(raw+0x00007fff+odd)>>16);
}
fn compute(data:[*]f32,gain_output:[*]u16,stats:[*]f32) void {
  var squares:f32=0.0;
  for(@range(u16,5120))|i|{squares+=data[i]*data[i];}
  const q:f32=squares/5120.0+0.000001;
  const root:f32=math.sqrt_f32(q);
  const inverse:f32=1.0/root;
  stats[0]=squares;stats[1]=q;stats[2]=root;stats[3]=inverse;
  for(@range(u16,5120))|i|{
    const w:f32=@bitcast(f32,@as(u32,gain_output[i])<<16);
    const normalized:f32=data[i]*inverse;
    const value:f32=normalized*(1.0+w);
    data[i]=value;
    gain_output[i]=round_bf16(@bitcast(u32,value));
  }
}
