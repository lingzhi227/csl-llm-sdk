// Dedicated control-plane tile. Coordinate config is runtime data, so neither
// its x/y nor a unique node identifier specializes the executable program.
param memcpy_params;param spine:bool=false;param mask:u16=0;
param input_colors:[3]u16;param output_colors:[3]u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const envelope=@import_module("transport_header.csl",.{});
const pump_task=@get_local_task_id(19);
var config=@zeros([2]u16);var status=@zeros([32]u32);
var initialized:bool=false;
var next_hop=[3]u16{3,3,3};var output_owner=[3]u16{3,3,3};
var round_robin=@zeros([3]u16);
fn healthy() bool {return status[0]==0;}
fn fail(code:u32) void {if(status[0]==0){status[0]=code;}}
const p0=@import_module("tree_port.csl",.{.enabled=(mask&1)!=0,
 .input_color=input_colors[0],.output_color=output_colors[0],.queue_id=2,
 .rx_resource=2,.tx_resource=5,.rx_task=@get_local_task_id(10),
 .tx_task=@get_local_task_id(13),.error_task=@get_local_task_id(16),
 .on_receive=received0,.on_sent=sent0,.healthy=healthy,.fail=fail});
fn received0() void {received(0,&p0.buffer);}
fn sent0() void {sent(0);}
const p1=@import_module("tree_port.csl",.{.enabled=(mask&2)!=0,
 .input_color=input_colors[1],.output_color=output_colors[1],.queue_id=3,
 .rx_resource=3,.tx_resource=6,.rx_task=@get_local_task_id(11),
 .tx_task=@get_local_task_id(14),.error_task=@get_local_task_id(17),
 .on_receive=received1,.on_sent=sent1,.healthy=healthy,.fail=fail});
fn received1() void {received(1,&p1.buffer);}
fn sent1() void {sent(1);}
const p2=@import_module("tree_port.csl",.{.enabled=(mask&4)!=0,
 .input_color=input_colors[2],.output_color=output_colors[2],.queue_id=4,
 .rx_resource=4,.tx_resource=7,.rx_task=@get_local_task_id(12),
 .tx_task=@get_local_task_id(15),.error_task=@get_local_task_id(18),
 .on_receive=received2,.on_sent=sent2,.healthy=healthy,.fail=fail});
fn received2() void {received(2,&p2.buffer);}
fn sent2() void {sent(2);}
fn enabled(port:u16) bool {return port<3 and (mask&(@as(u16,1)<<port))!=0;}
fn lease(port:u16) u16 {if(port==0){return p0.lease;}if(port==1){return p1.lease;}return p2.lease;}
fn tx_busy(port:u16) bool {if(port==0){return p0.tx_busy;}if(port==1){return p1.tx_busy;}return p2.tx_busy;}
fn buffer(port:u16) [*]u32 {if(port==0){return &p0.buffer;}if(port==1){return &p1.buffer;}return &p2.buffer;}
fn forward(port:u16) void {if(port==0){p0.forward();}else if(port==1){p1.forward();}else{p2.forward();}}
fn release(port:u16) void {if(port==0){p0.release();}else if(port==1){p1.release();}else{p2.release();}}
fn issue(port:u16,data:[*]u32) void {if(port==0){p0.send(data);}else if(port==1){p1.send(data);}else{p2.send(data);}}
fn snapshot_internal() void {
 status[1]=@as(u32,mask);status[2]=@as(u32,config[0]);status[3]=@as(u32,config[1]);
 status[4]=p0.received_count;status[5]=p1.received_count;status[6]=p2.received_count;
 status[7]=p0.sent_count;status[8]=p1.sent_count;status[9]=p2.sent_count;
 for(@range(u16,3))|i|{
  status[10+i]=@as(u32,lease(i));status[13+i]=@as(u32,output_owner[i]);
  status[16+i]=@as(u32,next_hop[i]);
 }
}
fn received(ingress:u16,data:[*]u32) void {
 if(!healthy()){return;}
 if(!envelope.valid(data[0])){fail(301);return;}
 const count=envelope.length(data[0]);
 var i:u16=count+1;while(i<32){if(data[i]!=0){fail(302);return;}i+=1;}
 const x=envelope.x(data[0]);const y=envelope.y(data[0]);
 var target:u16=0;
 if(comptime spine){target=if(y==config[1]) @as(u16,0) else if(y<config[1]) @as(u16,1) else @as(u16,2);}
 else{target=if(x==config[0] and y==config[1]) @as(u16,0)
  else if(y==config[1] and x<config[0]) @as(u16,1) else @as(u16,2);}
 // No U-turn. Invalid/nonexistent destinations fail before acquiring output.
 if(!enabled(target) or target==ingress){fail(303);return;}
 next_hop[ingress]=target;snapshot_internal();@activate(pump_task);
}
fn sent(output:u16) void {
 if(!healthy()){return;}
 const input=output_owner[output];
 if(input>=3 or lease(input)!=3 or next_hop[input]!=output){fail(304);return;}
 output_owner[output]=3;next_hop[input]=3;release(input);
 snapshot_internal();@activate(pump_task);
}
task pump() void {
 if(!healthy()){return;}
 // A blocked output never prevents another independent output from starting.
 for(@range(u16,3))|output|{
  if(enabled(output) and !tx_busy(output)){
   if(output_owner[output]!=3){fail(305);return;}
   var step:u16=0;var selected:u16=3;
   while(step<3 and selected==3){
    const input=(round_robin[output]+step)%3;
    if(enabled(input) and lease(input)==2 and next_hop[input]==output){selected=input;}
    step+=1;
   }
   if(selected<3){
    output_owner[output]=selected;round_robin[output]=(selected+1)%3;
    forward(selected);if(!healthy()){return;}issue(output,buffer(selected));
   }
  }
 }
 snapshot_internal();
}
fn initialize() void {
 if(initialized or config[1]>=4 or (mask!=0 and ((spine and config[0]!=33) or (!spine and config[0]>=33)))){fail(306);return;}
 initialized=true;
 if(comptime (mask&1)!=0){p0.arm();}
 if(comptime (mask&2)!=0){p1.arm();}
 if(comptime (mask&4)!=0){p2.arm();}
 snapshot_internal();sys.unblock_cmd_stream();
}
fn prepare() void {
 if(!initialized or !healthy()){fail(307);return;}
 for(@range(u16,3))|i|{if(enabled(i) and (lease(i)!=1 or tx_busy(i))){fail(308);return;}}
 status[19]+=1;snapshot_internal();sys.unblock_cmd_stream();
}
fn reset() void {
 if(!initialized or !healthy()){fail(310);return;}
 for(@range(u16,3))|i|{
  if(enabled(i) and (lease(i)!=1 or tx_busy(i) or output_owner[i]!=3 or next_hop[i]!=3)){fail(311);return;}
 }
 // Keep idle RX descriptors armed and counters cumulative.
 status[20]+=1;snapshot_internal();sys.unblock_cmd_stream();
}
fn compute() void {
 if(!initialized or !healthy()){fail(309);return;}
 // Host completion additionally checks every endpoint and per-edge counter.
 // An armed receiver is NOT evidence that no partial frame remains in fabric.
 snapshot_internal();sys.unblock_cmd_stream();
}
// Generated typed export tail.
var controls=@zeros([4]u32);var unused16=@zeros([1]u16);var unused32=@zeros([1]u32);var unusedf=@zeros([1]f32);
fn inject() void {sys.unblock_cmd_stream();}
fn release_acks() void {sys.unblock_cmd_stream();}
fn snapshot() void {snapshot_internal();sys.unblock_cmd_stream();}
const export_transport_config:[*]u16=&config;
const export_transport_status:[*]u32=&status;
const export_controls:[*]u32=&controls;
const export_state:[*]u32=&unused32;
const export_frame_counters:[*]u32=&unused32;
const export_weights:[*]u32=&unused32;
const export_descriptor:[*]u16=&unused16;
const export_input:[*]f32=&unusedf;
const export_active_input:[*]f32=&unusedf;
const export_partial:[*]f32=&unusedf;
const export_result:[*]f32=&unusedf;
const export_lane_counters:[*]u32=&unused32;
const export_rounded:[*]u16=&unused16;
const export_received_rows:[*]u16=&unused16;
const export_receive_offsets:[*]u16=&unused16;
const export_ack_pending:[*]u16=&unused16;
const export_frame_input:[*]f32=&unusedf;
const export_port0_buffer:[*]u32=&p0.buffer;
const export_port1_buffer:[*]u32=&p1.buffer;
const export_port2_buffer:[*]u32=&p2.buffer;
comptime {
 @bind_local_task(pump,pump_task);
 @export_symbol(export_transport_config,"transport_config");
 @export_symbol(export_transport_status,"transport_status");
 @export_symbol(export_controls,"controls");
 @export_symbol(export_state,"state");
 @export_symbol(export_frame_counters,"frame_counters");
 @export_symbol(export_weights,"weights");
 @export_symbol(export_descriptor,"descriptor");
 @export_symbol(export_input,"input");
 @export_symbol(export_active_input,"active_input");
 @export_symbol(export_partial,"partial");
 @export_symbol(export_result,"result");
 @export_symbol(export_lane_counters,"lane_counters");
 @export_symbol(export_rounded,"rounded");
 @export_symbol(export_received_rows,"received_rows");
 @export_symbol(export_receive_offsets,"receive_offsets");
 @export_symbol(export_ack_pending,"ack_pending");
 @export_symbol(export_frame_input,"frame_input");
 @export_symbol(export_port0_buffer,"port0_buffer");
 @export_symbol(export_port1_buffer,"port1_buffer");
 @export_symbol(export_port2_buffer,"port2_buffer");
 @export_symbol(initialize);
 @export_symbol(prepare);
 @export_symbol(inject);
 @export_symbol(release_acks);
 @export_symbol(snapshot);
 @export_symbol(reset);
}
