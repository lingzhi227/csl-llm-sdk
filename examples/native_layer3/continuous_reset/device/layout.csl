 for(@range(u16,2))|i|{@set_color_config(27+i,0,@get_color(1),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(28-i,0,@get_color(15),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
