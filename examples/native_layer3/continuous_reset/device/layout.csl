 for(@range(u16,15))|i|{@set_color_config(16-i,0,@get_color(15),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==14) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(16+i,0,@get_color(0),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(17-i,0,@get_color(14),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(17+i,0,@get_color(1),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(18-i,0,@get_color(15),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(18+i,0,@get_color(0),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(19-i,0,@get_color(14),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(19+i,0,@get_color(1),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(20-i,0,@get_color(15),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(20+i,0,@get_color(0),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(21-i,0,@get_color(14),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
 for(@range(u16,2))|i|{@set_color_config(21+i,0,@get_color(1),.{.routes=.{.rx=if(i==0) .{RAMP} else .{WEST},.tx=if(i==1) .{RAMP} else .{EAST}}});}
 for(@range(u16,2))|i|{@set_color_config(22-i,0,@get_color(15),.{.routes=.{.rx=if(i==0) .{RAMP} else .{EAST},.tx=if(i==1) .{RAMP} else .{WEST}}});}
