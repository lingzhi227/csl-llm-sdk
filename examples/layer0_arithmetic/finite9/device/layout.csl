// Nine independent arithmetic owners; no packet routes.
const memcpy=@import_module("<memcpy/get_params>",.{.width=1,.height=9});
layout {
 @set_rectangle(1,9);
 for(@range(u16,9))|y|{@set_tile_code(0,y,"app.csl",.{.memcpy_params=memcpy.get_params(0),.role=y});}
 @export_name("controls",[*]u32,false);
 @export_name("status",[*]u32,false);
 @export_name("exp_input",[*]f32,false);
 @export_name("exp_output",[*]f32,false);
 @export_name("conv_weights",[*]u16,false);
 @export_name("conv_history",[*]u16,false);
 @export_name("conv_input",[*]u16,false);
 @export_name("conv_stages",[*]f32,false);
 @export_name("conv_casts",[*]u16,false);
 @export_name("conv_unscaled",[*]f32,false);
 @export_name("conv_output",[*]f32,false);
 @export_name("conv_stats",[*]f32,false);
 @export_name("matrix",[*]f32,false);
 @export_name("query",[*]f32,false);
 @export_name("key",[*]f32,false);
 @export_name("value",[*]f32,false);
 @export_name("prediction",[*]f32,false);
 @export_name("delta",[*]f32,false);
 @export_name("recurrent_output",[*]f32,false);
 @export_name("recurrent_bf16",[*]u16,false);
 @export_name("recurrent_gates",[*]f32,false);
 @export_name("gated_input",[*]u16,false);
 @export_name("gated_gain",[*]u16,false);
 @export_name("gated_z",[*]u16,false);
 @export_name("gated_stages",[*]f32,false);
 @export_name("gated_casts",[*]u16,false);
 @export_name("gated_stats",[*]f32,false);
 @export_name("gate_stages",[*]f32,false);
 @export_name("beta_bits",[*]u16,false);
 @export_name("initialize",fn()void);
 @export_name("exponential",fn()void);
 @export_name("compute",fn()void);
 @export_name("release",fn()void);
 @export_name("reset",fn()void);
}
