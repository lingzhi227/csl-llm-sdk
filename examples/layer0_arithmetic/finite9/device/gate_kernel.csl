// Exact scalar gate operation order extracted from selected-head preprocessing.
// Original Layer0 ranges require the new finite-domain qualification.
const bounded_exp=@import_module("exp_kernel.csl");
fn round_bf16(raw:u32) u16 {const odd:u32=(raw>>16)&1;return @as(u16,(raw+0x00007fff+odd)>>16);}
fn expand(raw:u16) f32 {return @bitcast(f32,@as(u32,raw)<<16);}
fn exponential_negative_abs(x:f32) f32 {return bounded_exp.exp_f32(if(x<0.0) x else -x);}
fn sigmoid_from_exp(x:f32,e:f32) f32 {return if(x<0.0) e/(1.0+e) else 1.0/(1.0+e);}
fn compute_gates(gates:[*]f32,beta_bits:[*]u16) void {
 const a=gates[11];const b=gates[12];const A_log=gates[13];const dt_bias=gates[14];
 const t:f32=a+dt_bias;const eb=exponential_negative_abs(b);const beta=sigmoid_from_exp(b,eb);
 beta_bits[0]=round_bf16(@bitcast(u32,beta));
 const ea=bounded_exp.exp_f32(A_log);const et=exponential_negative_abs(t);
 const ratio:f32=et/(2.0+et);const square_ratio:f32=ratio*ratio;
 var term:f32=ratio;var series:f32=ratio;
 for(@range(u16,6))|j|{term*=square_ratio;series+=term/@as(f32,2*j+3);}
 const logp:f32=2.0*series;const positive:f32=if(t>0.0) t else 0.0;
 const softplus:f32=positive+logp;const g:f32=-ea*softplus;const decay=bounded_exp.exp_f32(g);
 gates[0]=t;gates[1]=eb;gates[2]=beta;gates[3]=ea;gates[4]=et;gates[5]=ratio;
 gates[6]=logp;gates[7]=softplus;gates[8]=g;gates[9]=decay;gates[10]=expand(beta_bits[0]);
}
