// Pure arithmetic/state owner. The static packet wrapper supplies complete input
// ownership and a global quiescence barrier; this module binds no tasks/colors.
param vector_kind:u16;
const kernel=@import_module("convolution128.csl",.{.vector_kind=vector_kind});
var weights=@zeros([512]u16);
var history=@zeros([512]u16);
var input=@zeros([128]u16);
var stages=@zeros([384]f32);
var casts=@zeros([256]u16);
var unscaled=@zeros([128]f32);
var output=@zeros([128]f32);
var stats=@zeros([4]f32);
var serial:u32=0;var generation:u32=1;var position:u32=0;
var output_owned:bool=false;
fn compute(next_serial:u32,next_generation:u32,next_position:u32) void {
 @assert(!output_owned and next_serial==serial+1 and next_generation==generation and next_position==position);
 kernel.compute(&history,&weights,&input,&stages,&casts,&unscaled,&output,&stats);
 serial=next_serial;position+=1;output_owned=true;
}
fn release_output(expected_serial:u32) void {
 @assert(output_owned and serial==expected_serial);output_owned=false;
}
fn reset_after_global_quiescence(next_generation:u32) void {
 @assert(!output_owned and next_generation==generation+1);
 for(@range(u16,512))|i|{history[i]=0;}
 generation=next_generation;position=0;
}
