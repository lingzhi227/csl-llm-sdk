// WP16 source proposal only. Whole SiLU is rounded once, before the up product.
// The wrapper publishes its compute-commit state only after this function returns0.
const bounded_exp=@import_module("exp_kernel.csl");
fn round_bf16(raw:u32) u16 {
 const odd:u32=(raw>>16)&1;
 return @as(u16,(raw+0x00007fff+odd)>>16);
}
fn expand(raw:u16) f32 {return @bitcast(f32,@as(u32,raw)<<16);}
fn compute(gate:[*]u16,upper:[*]u16,exponential:[*]f32,sigmoid:[*]f32,
 activation:[*]f32,product:[*]f32,activation_bf16:[*]u16,product_bf16:[*]u16) u32 {
 // Validate the complete input domain before writing any arithmetic observations.
 // abs(g),abs(up)<=24 bounds the ideal whole SiLU product by576, far from overflow.
 for(@range(u16,128))|i|{
  if((gate[i]&0x7f80)==0x7f80 or (upper[i]&0x7f80)==0x7f80){return 1;}
  const g:f32=expand(gate[i]);const u:f32=expand(upper[i]);
  if(g < -24.0 or g > 24.0 or u < -24.0 or u > 24.0){return 2;}
 }
 for(@range(u16,128))|i|{
  const g:f32=expand(gate[i]);
  const argument:f32=if(g<0.0) g else -g;
  const e:f32=bounded_exp.exp_f32(argument);exponential[i]=e;
  const s:f32=if(g<0.0) e/(1.0+e) else 1.0/(1.0+e);sigmoid[i]=s;
  const a:f32=g*s;activation[i]=a;
  const a_bits:u16=round_bf16(@bitcast(u32,a));activation_bf16[i]=a_bits;
  const p:f32=expand(a_bits)*expand(upper[i]);product[i]=p;
  product_bf16[i]=round_bf16(@bitcast(u32,p));
 }
 return 0;
}
