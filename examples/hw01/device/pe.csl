// Full resident MLP source candidate; no compiled-fit or numerical claim.
// Roles: idle, gate matrix, up matrix, down matrix, nonlinear, input,
// ordered product broadcast, output collector. All neural math stays on device.
param memcpy_params;param role:u16;param group:u16;param ordinal:u16;
param participants:u16;param hidden:u16;param intermediate:u16;
param width:u16;param down_y:u16;
param diagnostic_padding:bool=false;
const matrix=role>=1 and role<=3;
const root=matrix and ordinal==0;
const non=role==4;const ingress=role==5;const product_sender=role==6;const collector=role==7;
const channels:u16=intermediate/128;const outputs:u16=hidden/128;
const padded_hidden:u16=((hidden+95)/96)*96;
const padded_intermediate:u16=((intermediate+95)/96)*96;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const kernel=@import_module(if(matrix) "gemv_kernel.csl" else "<empty>",if(matrix) .{.rows=128,.columns=96} else .{});
const nonlinear=@import_module(if(non) "nonlinear_kernel.csl" else "<empty>");
const line=@import_module(if(matrix) "line.csl" else "<empty>",if(matrix) .{.ordinal=ordinal,.participants=participants,.length=128,.negative=WEST,.positive=EAST,.colors=[3]color{@get_color(0),@get_color(1),@get_color(2)},.task_id=@get_local_task_id(10),.on_complete=reduced} else .{});
const input_task=@get_local_task_id(11);
const receiver=@import_module(if(matrix) "input.csl" else "<empty>",if(matrix) .{.length=96,.input_color=@get_color(if(role==3) 4 else 3),.completion_task=input_task} else .{});
const packets=@import_module("packets.csl",.{.sent_task_id=@get_local_task_id(12),.received_task_id=@get_local_task_id(13),.on_sent=sent,.on_received=received});
var weights=@zeros([if(matrix) 12288 else 1]u16);
var input=@zeros([if(ingress) padded_hidden else if(matrix) 96 else if(product_sender) 128 else 1]f32);
var partial=@zeros([if(matrix) 128 else 1]f32);
var result=@zeros([if(matrix) 128 else 1]f32);
var rounded=@zeros([if(root) 128 else 1]u16);
var gate=@zeros([if(non or diagnostic_padding) 128 else 1]u16);
var up=@zeros([if(non or diagnostic_padding) 128 else 1]u16);
var product=@zeros([if(non or diagnostic_padding) 128 else 1]u16);
var silu=@zeros([if(non or diagnostic_padding) 128 else 1]u16);
var exponential=@zeros([if(non or diagnostic_padding) 128 else 1]f32);
var sigmoid=@zeros([if(non or diagnostic_padding) 128 else 1]f32);
var activation_fp32=@zeros([if(non or diagnostic_padding) 128 else 1]f32);
var product_fp32=@zeros([if(non or diagnostic_padding) 128 else 1]f32);
var output=@zeros([if(collector) hidden else 1]u16);
var counts=@zeros([if(collector) outputs else 1]u16);
// state: completed epoch marker, epoch, GEMVs, reductions, nonlinears,
// sent payload packets, received payload packets, initialized.
var state=@zeros([8]u32);
var tx=@zeros([31]u32);
var epoch:u32=0;var command_waiting:bool=false;var work_done:bool=false;
var gate_count:u16=0;var up_count:u16=0;var data_offset:u16=0;
var tx_kind:u32=0;var tx_count:u16=0;var data_ready:bool=false;
var requested:bool=false;var request_pending:bool=false;
var active_group:u16=0;var product_count:u16=0;var complete_groups:u16=0;
var broadcast_busy:bool=false;var padding_started:bool=false;
const dest=@get_dsr(dsr_dest,5);const source=@get_dsr(dsr_src1,5);
const bq=@get_output_queue(if(ingress) 4 else 5);
const GATE:u32=10;const UP:u32=11;const PRODUCT:u32=12;const DOWN:u32=13;const REQUEST:u32=14;

fn expand(word:u16) f32 {return @bitcast(f32,@as(u32,word)<<16);}
fn round_bf16(value:f32) u16 {
 const raw=@bitcast(u32,value);@assert((raw&0x7f800000)!=0x7f800000);
 const bits=@as(u16,(raw+0x7fff+((raw>>16)&1))>>16);
 @assert((bits&0x7f80)!=0x7f80);return bits;
}
fn finish() void {
 if(command_waiting and work_done and !packets.sending){
  state[0]=2*epoch;command_waiting=false;sys.unblock_cmd_stream();
 }
}
fn initialize() void {@assert(state[7]==0);packets.init();state[7]=1;sys.unblock_cmd_stream();}
fn prepare() void {
 @assert(state[7]==1 and state[0]==2*epoch and !packets.sending and !packets.receiving and !command_waiting);
 @assert(epoch<0x7ffffffe);epoch+=1;state[1]=epoch;state[0]=2*epoch-1;
 work_done=false;gate_count=0;up_count=0;data_offset=0;data_ready=false;
 requested=false;request_pending=false;active_group=0;product_count=0;complete_groups=0;
 broadcast_busy=false;padding_started=false;
 if(comptime collector){for(@range(u16,outputs))|i|{counts[i]=0;}}
 if(comptime matrix){receiver.arm(&input);}
 sys.unblock_cmd_stream();
}
fn broadcast(count:u16) void {
 @assert(!broadcast_busy and count>0);broadcast_busy=true;
 const mem=@get_dsd(mem1d_dsd,.{.base_address=&input,.extent=count});
 const base=@get_dsd(fabout_dsd,.{.output_queue=bq,.extent=1});
 const out=@set_dsd_length(base,count);
 @load_to_dsr(dest,out,.{.async=true,.activate=input_task});@load_to_dsr(source,mem);@mov32(dest,source,.{.async=true});
}
fn compute() void {
 @assert(state[7]==1 and state[0]==2*epoch-1 and !command_waiting);command_waiting=true;
 if(comptime ingress){
  for(@range(u16,padded_hidden))|i|{if(i>=hidden){@assert(input[i]==0.0);}else{@assert((@bitcast(u32,input[i])&0x7f800000)!=0x7f800000);}}
  broadcast(padded_hidden);
 }else if(comptime product_sender){request_pending=true;pump();}
 else if(comptime role==0){work_done=true;}
 finish();
}
fn transmit() void {
 @assert((root or non) and data_offset<64 and !packets.sending);
 tx_kind=if(non) PRODUCT else if(role==1) GATE else if(role==2) UP else DOWN;
 tx_count=if(64-data_offset<27) 64-data_offset else 27;
 tx[0]=tx_kind;tx[1]=epoch;tx[2]=@as(u32,group);tx[3]=@as(u32,data_offset);
 for(@range(u16,27))|i|{if(i<tx_count){const j:u16=2*(data_offset+i);const values:[*]u16=if(non) &product else &rounded;tx[4+i]=@as(u32,values[j])|(@as(u32,values[j+1])<<16);}}
 const dx:u16=if(non or role==3) width-1 else width-2;
 const dy:u16=if(non) down_y else if(role==3) down_y+1 else 2*group;
 packets.send(dx,dy,&tx,tx_count+4);
}
fn pump() void {
 if(packets.sending){return;}
 if(comptime root){if(data_ready and data_offset<64){transmit();return;}}
 if(comptime non){if(data_ready and requested and data_offset<64){transmit();return;}}
 if(comptime product_sender){
  if(request_pending){
   @assert(active_group<channels and product_count==0 and !broadcast_busy);
   request_pending=false;tx_kind=REQUEST;tx_count=0;
   tx[0]=REQUEST;tx[1]=epoch;tx[2]=@as(u32,active_group);tx[3]=0;
   packets.send(width-2,2*active_group,&tx,4);return;
  }
 }
 finish();
}
task input_complete() void {
 if(comptime matrix){
  kernel.compute(&weights,&input,&partial);state[2]+=1;line.start(&partial,&result);
 }else{
  @assert(broadcast_busy);broadcast_busy=false;
  if(comptime ingress){work_done=true;}
  else if(comptime product_sender){
   if(padding_started){work_done=true;}
   else{
    active_group+=1;product_count=0;
    if(active_group<channels){request_pending=true;}
    else if(padded_intermediate>intermediate){
     padding_started=true;for(@range(u16,128))|i|{input[i]=0.0;}
     broadcast(padded_intermediate-intermediate);
    }else{work_done=true;}
   }
  }
  pump();
 }
}
fn reduced() void {
 state[3]+=1;
 if(comptime root){for(@range(u16,128))|i|{rounded[i]=round_bf16(result[i]);}data_ready=true;pump();}
 else{work_done=true;finish();}
}
fn sent() void {
 if(tx_kind!=REQUEST){data_offset+=tx_count;state[5]+=1;if(data_offset==64){work_done=true;}}
 pump();
}
fn received(data:[*]u32,length:u16) void {
 @assert(length>=4 and length<=31 and data[1]==epoch);
 const kind=data[0];const owner=@as(u16,data[2]);const begin=@as(u16,data[3]);
 if(kind==REQUEST){
  @assert(non and length==4 and data[2]==@as(u32,group) and data[3]==0 and !requested);
  requested=true;pump();return;
 }
 @assert(length>=5 and data[3]<64);const n=length-4;@assert(begin+n<=64);
 if(comptime non){
  @assert(data[2]==@as(u32,group) and ((kind==GATE and begin==gate_count) or (kind==UP and begin==up_count)));
  for(@range(u16,27))|i|{if(i<n){const j:u16=2*(begin+i);if(kind==GATE){gate[j]=@as(u16,data[4+i]&0xffff);gate[j+1]=@as(u16,data[4+i]>>16);}else{up[j]=@as(u16,data[4+i]&0xffff);up[j+1]=@as(u16,data[4+i]>>16);}}}
  if(kind==GATE){gate_count+=n;}else{up_count+=n;}
  if(gate_count==64 and up_count==64){
   @assert(!data_ready);const error=nonlinear.compute(&gate,&up,&exponential,&sigmoid,&activation_fp32,&product_fp32,&silu,&product);
   @assert(error==0);state[4]+=1;data_ready=true;pump();
  }
 }else if(comptime product_sender){
  @assert(kind==PRODUCT and data[2]==@as(u32,active_group) and begin==product_count and !broadcast_busy);
  for(@range(u16,27))|i|{if(i<n){input[2*(begin+i)]=expand(@as(u16,data[4+i]&0xffff));input[2*(begin+i)+1]=expand(@as(u16,data[4+i]>>16));}}
  product_count+=n;if(product_count==64){broadcast(128);}
 }else if(comptime collector){
  @assert(kind==DOWN and data[2]<@as(u32,outputs) and begin==counts[owner]);
  for(@range(u16,27))|i|{if(i<n){const j:u16=owner*128+2*(begin+i);output[j]=@as(u16,data[4+i]&0xffff);output[j+1]=@as(u16,data[4+i]>>16);}}
  counts[owner]+=n;if(counts[owner]==64){complete_groups+=1;}
  if(complete_groups==outputs){work_done=true;finish();}
 }else{@assert(false);}
 state[6]+=1;
}
const wp:[*]u16=&weights;const ip:[*]f32=&input;const rp:[*]f32=&result;
const gp:[*]u16=&gate;const uptr:[*]u16=&up;const pp:[*]u16=&product;const op:[*]u16=&output;const sp:[*]u32=&state;
const partial_ptr:[*]f32=&partial;const rounded_ptr:[*]u16=&rounded;const silu_ptr:[*]u16=&silu;
const exp_ptr:[*]f32=&exponential;const sigmoid_ptr:[*]f32=&sigmoid;
const activation_ptr:[*]f32=&activation_fp32;const product_fp32_ptr:[*]f32=&product_fp32;
comptime {
 if(ingress or product_sender){@initialize_queue(bq,.{.color=@get_color(if(ingress) 3 else 4)});}
 @bind_local_task(input_complete,input_task);
 @export_symbol(wp,"weights");@export_symbol(ip,"input");@export_symbol(rp,"result");
 @export_symbol(gp,"gate");@export_symbol(uptr,"up");@export_symbol(pp,"product");@export_symbol(op,"output");@export_symbol(sp,"state");
 @export_symbol(partial_ptr,"partial");@export_symbol(rounded_ptr,"rounded");@export_symbol(silu_ptr,"silu");
 @export_symbol(exp_ptr,"exponential");@export_symbol(sigmoid_ptr,"sigmoid");
 @export_symbol(activation_ptr,"activation_fp32");@export_symbol(product_fp32_ptr,"product_fp32");
 @export_symbol(initialize);@export_symbol(prepare);@export_symbol(compute);
}
