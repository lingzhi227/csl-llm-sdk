const boundary_enabled=(pre and chain_input) or (post and chain_output);
const boundary=@import_module(if(boundary_enabled) "handoff.csl" else "<empty>",if(boundary_enabled) .{
 .sender=post,.request_id=request_id,.stage_id=stage_id,
 .source_layer=if(pre) layer_id-1 else layer_id,
 .destination_layer=if(pre) layer_id else layer_id+1,
 .on_complete=boundary_complete,.on_error=boundary_fail} else .{});
var boundary_input_started:bool=false;
var checkpoint_control=[8]u32{0x51435031,request_id,stage_id,@as(u32,layer_id),1,0,1,0};
fn boundary_complete() void {@activate(service_task);}
fn boundary_fail(code:u32) void {fail(code);}
fn service_boundary_input() void {
 if(comptime pre and chain_input){
  if(command_waiting and boundary.complete and !boundary_input_started){
   boundary_input_started=true;norm.normalize_loaded();
  }
 }
}


// Only initialize can call this; its existing initialized guard rejects repeats.
noinline fn import_checkpoint() bool {
 if(!(checkpoint_control[0]==0x51435031 and checkpoint_control[1]==request_id and
 checkpoint_control[2]==stage_id and checkpoint_control[3]==@as(u32,layer_id) and
 checkpoint_control[4]>0 and (checkpoint_control[5]==1 or
 (checkpoint_control[5]==0 and checkpoint_control[4]==1)) and
 checkpoint_control[6]==1 and checkpoint_control[7]==0)){fail(920);return false;}
 state[4]=checkpoint_control[4];state[5]=checkpoint_control[5];
 identity[1]=state[4];identity[2]=state[5];
 if(state[5]==1){if(comptime neural){node.restore_fresh(checkpoint_control[4],1);}}
 return true;
}
const chain_checkpoint_ptr:[*]u32=&checkpoint_control;
const chain_boundary_ptr:[*]u32=if(boundary_enabled) &boundary.status else &unused32;
comptime {@export_symbol(chain_checkpoint_ptr,"checkpoint_control");if(boundary_enabled){@export_symbol(chain_boundary_ptr,"handoff_status");}}

