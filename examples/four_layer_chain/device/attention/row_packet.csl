// Compact-row point packet assembly over the single PE-owned packets module.
// Source and destination instances never infer delivery from source completion.
param source_role:bool;
param send:fn(u16,u16,[*]u32,u16)void;
param on_source_released:fn(u16)void;
param on_row_received:fn([*]u16,u16,u16)void;
var identity=@zeros([4]u32);
var tx=@zeros([if(source_role) 31 else 1]u32);
var row=@zeros([if(source_role) 1 else 128]u16);
var kind:u32=0;
var phase:u16=0;
var group:u16=0;
var valid_rows:u16=0;
var offset:u16=0;
var packet_words:u16=0;
var destination_x:u16=0;
var destination_y:u16=0;
var source:[*]u16;
var active:bool=false;
var sending:bool=false;
var received:bool=false;

noinline fn begin(request:u32,reset:u32,position:u32,stage:u32,packet_kind:u32,
         expected_phase:u16,expected_group:u16,rows:u16) void {
 @assert(!active and !sending and rows>0 and rows<=128);
 identity[0]=request;identity[1]=reset;identity[2]=position;identity[3]=stage;
 kind=packet_kind;phase=expected_phase;group=expected_group;valid_rows=rows;
 offset=0;received=false;active=true;
}
noinline fn transmit(x:u16,y:u16,data:[*]u16) void {
 @assert(source_role and active and !sending and offset==0);
 destination_x=x;destination_y=y;source=data;pump();
}
fn pump() void {
 @assert(source_role and active and !sending and offset<64);
 packet_words=if(64-offset<23) 64-offset else @as(u16,23);
 tx[0]=kind;tx[1]=identity[0];tx[2]=identity[1];tx[3]=identity[2];
 tx[4]=identity[3];tx[5]=@as(u32,phase);tx[6]=@as(u32,group);tx[7]=@as(u32,offset);
 for(@range(u16,23))|i|{if(i<packet_words){
  const j:u16=2*(offset+i);tx[8+i]=@as(u32,source[j])|(@as(u32,source[j+1])<<16);
 }}
 sending=true;send(destination_x,destination_y,&tx,packet_words+8);
}
fn sent() void {
 @assert(source_role and active and sending);sending=false;offset+=packet_words;
 if(offset==64){active=false;on_source_released(phase);}else{pump();}
}
fn receive(data:[*]u32,length:u16) void {
 @assert(!source_role and active and !received and length>=9 and length<=31);
 @assert(data[0]==kind and data[1]==identity[0] and data[2]==identity[1] and data[3]==identity[2] and data[4]==identity[3]);
 @assert(data[5]==@as(u32,phase) and data[6]==@as(u32,group) and data[7]==@as(u32,offset));
 const n=length-8;@assert(offset+n<=64);
 for(@range(u16,23))|i|{if(i<n){
  const j:u16=2*(offset+i);row[j]=@as(u16,data[8+i]&0xffff);row[j+1]=@as(u16,data[8+i]>>16);
 }}
 offset+=n;
 if(offset==64){
  for(@range(u16,128))|i|{
   @assert((row[i]&0x7f80)!=0x7f80);if(i>=valid_rows){@assert(row[i]==0);}
  }
  received=true;on_row_received(&row,phase,group);
 }
}
// The owner releases the received row only after its downstream consumer has
// finished reading it. Keep data separate from the message receiver's buffer.
fn release_row(completed_phase:u16) void {
 @assert(!source_role and active and received and completed_phase==phase);active=false;
}
