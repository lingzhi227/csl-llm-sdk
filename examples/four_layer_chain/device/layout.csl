   }else{const count=attention_router_start[x+1]-attention_router_start[x];const negative=(count-1-index)%2;const positive:u16=if(index==count-1) 2 else (count-2-index)%2;
    mask=5|(if(index>0) @as(u16,2) else @as(u16,0));ins=[3]u16{17,7+negative,14+positive};outs=[3]u16{18,14+negative,7+positive};}
   @set_tile_code(chain_offset+(x),y,"attention/tree_router.csl",.{.layer_id=3,.request_id=1,.stage_id=0,.chain_input=true,.chain_output=false,.memcpy_params=memcpy.get_params(chain_offset+x),.spine=y==0,.mask=mask,.input_colors=ins,.output_colors=outs});
