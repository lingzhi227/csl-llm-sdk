 for(@range(u16,1))|chain_instance|{const chain_offset:u16=60+chain_instance;

 
 for(@range(u16,30))|x|{for(@range(u16,1160))|y|{
  var role:u16=0;var ordinal:u16=0;var participants:u16=54;var kind:u16=0;var conv_kind:u16=0;
  if(x==0){if(y==3){role=2;}else if(y>=4 and y<84){role=8;conv_kind=if(y<20) @as(u16,0) else if(y<36) @as(u16,1) else @as(u16,2);}
   else if(y>=84 and y<132){role=4;}else if(y>=132 and y<324){role=9;}else if(y>=324 and y<460){role=5;}}
  if(x==29 and y==3){role=3;}if(x==0 and y==1){role=6;}if(x==0 and y==2){role=7;}
  for(@range(u16,linear_starts[x+1]-linear_starts[x]))|j|{const s=linear_starts[x]+j;
   if(y>=linear_sy[s] and y<linear_sy[s]+linear_lengths[s]){role=1;ordinal=y-linear_sy[s];participants=linear_lengths[s];kind=linear_kinds[s];}}
  var index:u16=65535;
  for(@range(u16,linear_router_start[x+1]-linear_router_start[x]))|i|{if(linear_router_y[linear_router_start[x]+i]==y){index=i;}}
  if(index!=65535 or y==0){
   var mask:u16=0;var ins=[3]u16{0,0,0};var outs=[3]u16{0,0,0};
   if(y==0){mask=1|(if(x>0) @as(u16,2) else @as(u16,0))|(if(x<29) @as(u16,4) else @as(u16,0));
    ins=[3]u16{if(x==0) @as(u16,17) else @as(u16,9),14+(x+1)%2,7+x%2};outs=[3]u16{if(x==0) @as(u16,18) else @as(u16,16),7+(x+1)%2,14+x%2};
   }else{const count=linear_router_start[x+1]-linear_router_start[x];const negative=(count-1-index)%2;const positive:u16=if(index==count-1) 2 else (count-2-index)%2;
    mask=5|(if(index>0) @as(u16,2) else @as(u16,0));ins=[3]u16{17,7+negative,14+positive};outs=[3]u16{18,14+negative,7+positive};}
   @set_tile_code(chain_offset+(x),y,"linear/tree_router.csl",.{.layer_id=2,.request_id=1,.stage_id=0,.chain_input=true,.chain_output=true,.memcpy_params=memcpy.get_params(chain_offset+x),.spine=y==0,.mask=mask,.input_colors=ins,.output_colors=outs});
  }else{@set_tile_code(chain_offset+(x),y,"linear/layer0_pe.csl",.{.layer_id=2,.request_id=1,.stage_id=0,.chain_input=true,.chain_output=true,.memcpy_params=memcpy.get_params(chain_offset+x),.role=role,.ordinal=ordinal,.participants=participants,.matrix_kind=kind,.vector_kind=conv_kind});}
