   }else{const count=linear_router_start[x+1]-linear_router_start[x];const negative=(count-1-index)%2;const positive:u16=if(index==count-1) 2 else (count-2-index)%2;
    mask=5|(if(index>0) @as(u16,2) else @as(u16,0));ins=[3]u16{17,7+negative,14+positive};outs=[3]u16{18,14+negative,7+positive};}
