   if(y>=attention_sy[s] and y<attention_sy[s]+attention_lengths[s]){role=1;ordinal=y-attention_sy[s];participants=attention_lengths[s];
    if(ordinal==0){kind=attention_kinds[s];if(kind==2 or kind==3){group=attention_groups[s];}}}}
