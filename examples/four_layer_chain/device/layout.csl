 for(@range(u16,29))|x|{for(@range(u16,1160))|y|{
  var role:u16=0;var ordinal:u16=0;var participants:u16=54;var kind:u16=0;var group:u16=0;var head:u16=0;
  if(x==0){if(y==1){role=6;}else if(y==2){role=7;}else if(y==3){role=2;}
   else if(y>=84 and y<220){role=5;}
