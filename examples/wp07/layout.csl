layout{
 @set_rectangle(1,1);@set_tile_code(0,0,"pe.csl",.{.memcpy_params=memcpy.get_params(0)});
 @export_name("x",[*]u16,false);@export_name("w",[*]u16,false);@export_name("z",[*]u16,false);
 @export_name("stages",[*]f32,false);@export_name("casts",[*]u16,false);@export_name("stats",[*]f32,false);
 @export_name("probes",[*]u32,false);@export_name("probe_output",[*]u16,false);
 @export_name("control",[*]u32,false);@export_name("state",[*]u32,false);@export_name("compute",fn()void);
}
