 @export_symbol(ptr_attention_scores,"attention_scores");
 @export_symbol(ptr_attention_score_casts,"attention_score_casts");
 @export_symbol(ptr_attention_stats,"attention_stats");
 @export_symbol(ptr_attention_stages,"attention_stages");
 @export_symbol(ptr_attention_casts,"attention_casts");
 @export_symbol(ptr_attention_state,"attention_state");
 @export_symbol(ptr_attention_events,"attention_events");
 @export_symbol(ptr_request_control,"request_control");
 @export_symbol(ptr_request_state,"request_state");
 @export_symbol(ptr_handoff_control,"handoff_control");
 @export_symbol(ptr_handoff_state,"handoff_state");
 @export_symbol(ptr_wire_data,"wire_data");
 @export_symbol(ptr_wire_ack,"wire_ack");
 @initialize_queue(@get_input_queue(2),.{.color=@get_color(2)});
 @initialize_queue(@get_output_queue(2),.{.color=@get_color(11)});
 @set_local_color_config(@get_color(2),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
 @set_local_color_config(@get_color(11),.{.routes=.{.rx=.{RAMP},.tx=.{WEST}}});
 @initialize_queue(@get_input_queue(3),.{.color=@get_color(3)});
 @initialize_queue(@get_output_queue(3),.{.color=@get_color(12)});
 @set_local_color_config(@get_color(3),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
 @set_local_color_config(@get_color(12),.{.routes=.{.rx=.{RAMP},.tx=.{WEST}}});
 @set_local_color_config(@get_color(4),.{.routes=.{.rx=.{WEST},.tx=.{EAST}}});
 @set_local_color_config(@get_color(13),.{.routes=.{.rx=.{EAST},.tx=.{WEST}}});
 @set_local_color_config(@get_color(5),.{.routes=.{.rx=.{WEST},.tx=.{EAST}}});
 @set_local_color_config(@get_color(14),.{.routes=.{.rx=.{EAST},.tx=.{WEST}}});
 @initialize_queue(@get_input_queue(4),.{.color=@get_color(6)});
 @initialize_queue(@get_output_queue(4),.{.color=@get_color(15)});
 @set_local_color_config(@get_color(6),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
 @set_local_color_config(@get_color(15),.{.routes=.{.rx=.{RAMP},.tx=.{WEST}}});
 @initialize_queue(@get_input_queue(5),.{.color=@get_color(7)});
 @initialize_queue(@get_output_queue(5),.{.color=@get_color(16)});
 @set_local_color_config(@get_color(7),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
