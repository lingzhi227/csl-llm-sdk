param memcpy_params;param role:u16;param column:u16;param capacity:u16;param diagnostic_enabled:bool;
const origin=role==1;const peer=role==2;const producer=role==3;const sink=role==4;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const packets=@import_module("packets.csl",.{.sent_task_id=@get_local_task_id(12),
 .received_task_id=@get_local_task_id(13),.on_sent=sent,.on_received=received,.before_sdk=before_sdk,.on_protocol_error=packet_error,.initialize_message_routing=true});
const diag=@import_module("diagnostics.csl",.{.sender=!sink,.enabled=diagnostic_enabled,.capacity=capacity});
const rows=@import_module(if(origin or peer) "row_packet.csl" else "<empty>",
 if(origin or peer) .{.source_role=peer,.send=send_row,.on_source_released=row_sent,.on_row_received=row_received} else .{});
const go_out=@get_output_queue(3);const go_in=@get_input_queue(3);const go_dsr=@get_dsr(dsr_dest,4);
const service=@get_local_task_id(17);
var state=@zeros([8]u32);var tx=@zeros([8]u32);var terminal=@zeros([8]u32);
var source=@zeros([if(peer) 128 else 1]u16);var seen=@zeros([if(origin) 136 else 1]u16);
var started:bool=false;var go_seen:bool=false;var done:bool=false;
var request:u16=0;var ready_count:u16=0;var rows_done:u16=0;var peer_rows:u16=0;
var request_pending:bool=false;var pending_group:u16=0;var requests_received:u16=0;
var tx_source:[*]u32;var tx_length:u16=0;var first_error:u32=0;
fn append(event:u32,data:[*]u32,length:u16,error:u32) void {
 const subject=if(producer) @as(u32,column-40) else @as(u32,request);
 diag.append(event,subject,length,if(event==4) packets.header_buffer[0] else @as(u32,0),data,error);
}
fn send_packet(x:u16,data:[*]u32,length:u16) void {
 tx_source=data;tx_length=length;append(1,data,length,0);packets.send(x,0,data,length);
}
fn before_sdk(data:[*]u32,length:u16) void {if(comptime producer or peer){append(2,data,length,0);}}
fn packet_error(code:u16) void {
 if(first_error==0){first_error=256+@as(u32,code);}
 terminal[0]=first_error;terminal[1]=@as(u32,code);terminal[2]=@as(u32,packets.rx_phase);terminal[3]=packets.control_buffer[0];
 diag.append(5,0,8,packets.header_buffer[0],&terminal,first_error);
}
fn header(kind:u32,phase:u32,group:u32,detail:u32) void {
 tx[0]=kind;tx[1]=1;tx[2]=1;tx[3]=0;tx[4]=0;tx[5]=phase;tx[6]=group;tx[7]=detail;
}
fn maybe_start() void {
 if(comptime producer){if(state[0]==2 and go_seen and !started){started=true;header(10,3,@as(u32,column-40),0);send_packet(0,&tx,8);}}
}
task go(word:u32) void {@assert(producer and word==0x474f3031 and !go_seen);go_seen=true;maybe_start();}
fn sent() void {
 if(comptime producer or peer){append(3,tx_source,tx_length,0);}
 if(comptime producer){done=true;state[2]=1;}
 if(comptime peer){rows.sent();}
 if(comptime origin){@activate(service);}
}
fn send_row(x:u16,y:u16,data:[*]u32,length:u16) void {@assert(peer and x==0 and y==0);send_packet(x,data,length);}
fn row_sent(phase:u16) void {
 if(comptime peer){
  @assert(phase==2);peer_rows+=1;@activate(service);
  if(peer_rows==8){terminal[0]=8;terminal[1]=first_error;diag.append(5,0,8,0,&terminal,first_error);done=true;}
 }
}
fn row_received(data:[*]u16,phase:u16,group:u16) void {
 if(comptime origin){
  @assert(phase==2 and group==request);
  for(@range(u16,128))|i|{if(data[i]!=(0x3f00+@as(u16,group*128+i))){if(first_error==0){first_error=8;}}}
  rows.release_row(phase);rows_done+=1;request+=1;@activate(service);
 }
}
fn received(data:[*]u32,length:u16) void {
 if(comptime origin){
  var error:u32=0;
  if(length<8){error=1;}
  else if(data[1]!=1 or data[2]!=1 or data[3]!=0 or data[4]!=0){error=2;}
  else if(data[0]==10){
   if(length!=8 or data[5]!=3 or data[6]>=136 or data[7]!=0){error=4;}
   else{const owner=@as(u16,data[6]);if(seen[owner]!=0){error=5;}else{seen[owner]=1;ready_count+=1;}}
  }else if(data[0]!=9){error=6;}
  else if(!rows.active or rows.received or data[5]!=2 or data[6]!=@as(u32,request) or data[7]!=@as(u32,rows.offset) or length!=(if(rows.offset==46) @as(u16,26) else @as(u16,31))){error=7;}
  else{
   for(@range(u16,23))|i|{if(i<length-8){
    const low:u32=0x3f00+@as(u32,request)*128+2*@as(u32,rows.offset+i);
    if(data[8+i]!=(low|((low+1)<<16))){error=8;}
   }}
  }
  if(first_error==0 and error!=0){first_error=error;}
  diag.append(4,if(length>6) data[6] else @as(u32,0),length,packets.header_buffer[0],data,error);
  if(error==0 and length>=8 and data[0]==9){rows.receive(data,length);}
  @activate(service);
 }else if(comptime peer){
  var error:u32=0;
  if(length!=8){error=1;}
  else if(data[0]!=11 or data[1]!=1 or data[2]!=1 or data[3]!=0 or data[4]!=0 or data[5]!=2 or data[6]>=8 or data[7]!=data[6]*128){error=2;}
  if(error==0 and (request_pending or data[6]!=@as(u32,requests_received))){error=3;}
  diag.append(4,if(length>6) data[6] else @as(u32,0),length,packets.header_buffer[0],data,error);
  if(error!=0){if(first_error==0){first_error=error;}return;}
  pending_group=@as(u16,data[6]);request_pending=true;requests_received+=1;@activate(service);
 }
}
task pump() void {
 if(comptime peer){
  if(request_pending and !packets.sending and !rows.active){
   request=pending_group;request_pending=false;
   for(@range(u16,128))|i|{source[i]=0x3f00+@as(u16,request*128+i);}
   rows.begin(1,1,0,0,9,2,request,128);rows.transmit(0,0,&source);
  }
 }
 if(comptime origin){
  if(done or packets.sending){return;}
  if(rows_done<8){
   if(!rows.active){rows.begin(1,1,0,0,9,2,request,128);header(11,2,@as(u32,request),@as(u32,request)*128);packets.send(2,0,&tx,8);}
  }else if(ready_count==136){
   done=true;terminal[0]=@as(u32,ready_count);terminal[1]=@as(u32,rows_done);terminal[2]=first_error;
   diag.append(5,0,8,0,&terminal,first_error);
  }
 }
}
fn initialize() void {
 @assert(state[0]==0);diag.init();if(!sink){packets.init();}
 state[0]=1;state[1]=@as(u32,role);state[3]=@as(u32,column);sys.unblock_cmd_stream();
}
fn compute() void {
 @assert(state[0]==1);state[0]=2;diag.status[7]=1;
 if(comptime origin){
  const out=@get_dsd(fabout_dsd,.{.output_queue=go_out,.extent=1});
  @load_to_dsr(go_dsr,out);@mov32(go_dsr,0x474f3031);@activate(service);
 }else if(comptime producer){maybe_start();}
 // All diagnostic sinks stay host-readable. Capture reads only row1 sinks.
 sys.unblock_cmd_stream();
}
const state_ptr:[*]u32=&state;const status_ptr:[*]u32=&diag.status;const records_ptr:[*]u32=&diag.records;
comptime {
 if(producer){@initialize_queue(go_in,.{.color=@get_color(3)});@bind_data_task(go,@get_data_task_id(go_in));}
 if(origin){@initialize_queue(go_out,.{.color=@get_color(3)});}
 @bind_local_task(pump,service);
 @export_symbol(state_ptr,"state");@export_symbol(status_ptr,"diagnostic_status");@export_symbol(records_ptr,"diagnostic_records");
 @export_symbol(initialize);@export_symbol(compute);
}
