const memcpy=@import_module("<memcpy/get_params>",.{.width=3,.height=1});
layout {
 @set_rectangle(3,1);
 for(@range(u16,3))|x|{
  @set_tile_code(x,0,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.column=x});
 }
 @set_color_config(0,0,@get_color(3),.{.routes=.{.rx=.{RAMP},.tx=.{EAST}}});
 @set_color_config(1,0,@get_color(3),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
 // Notification only: neither notice gates a request, response or READY.
 @set_color_config(0,0,@get_color(7),.{.routes=.{.rx=.{RAMP},.tx=.{EAST}}});
 @set_color_config(1,0,@get_color(7),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}}});
 @set_color_config(1,0,@get_color(4),.{.routes=.{.rx=.{RAMP},.tx=.{WEST}}});
 @set_color_config(0,0,@get_color(4),.{.routes=.{.rx=.{EAST},.tx=.{RAMP}}});
 @export_name("state",[*]u32,false);@export_name("routing",[*]u32,false);
 @export_name("observed",[*]u32,false);@export_name("tx_proof",[*]u32,false);
 @export_name("received_buffer",[*]u32,false);@export_name("transmit_frame",[*]u32,false);
 @export_name("current_source",[*]u32,false);@export_name("row_archive",[*]u32,false);
 @export_name("initialize",fn()void);@export_name("compute",fn()void);@export_name("snapshot",fn()void);
}
