param memcpy_params;param role:u16;param column:u16;param first:u16;param count:u16;
param capacity:u16;param diagnostic_enabled:bool;
const origin=role==1;const peer=role==2;const producer=role==3;const sink=role==4;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const diag=@import_module("diagnostics.csl",.{.sender=!sink,.enabled=diagnostic_enabled,.capacity=capacity});
const service=@get_local_task_id(17);
const go_out=@get_output_queue(3);const go_in=@get_input_queue(3);const go_dsr=@get_dsr(dsr_dest,3);
var state=@zeros([32]u32);var tx=@zeros([8]u32);var terminal=@zeros([8]u32);
var source=@zeros([if(peer) 128 else 1]u16);
var seen=@zeros([if(origin) count else 1]u16);
// Each received row fragment preserves its full length and data for the host oracle.
// 24 slots of [length, up to31 original words], with zero padding for length26.
var row_packets=@zeros([if(origin) 24*32 else 1]u32);
var request:u16=0;var tx_group:u16=0;var fragment_count:u16=0;
var request_pending:bool=false;var pending_group:u16=0;var started:bool=false;
var go_seen:bool=false;var done:bool=false;
fn healthy() bool {return state[4]==0;}
fn fail(code:u32) void {
 if(state[4]!=0){return;}state[4]=code;terminal[0]=code;
 diag.append(5,0,8,0,&terminal,code);
}
const input_a=@import_module("static_input.csl",.{.enabled=origin or peer,.capacity=8,
 .queue_id=2,.color_id=if(origin) 9 else 12,.resource_id=2,
 .done_id=@get_local_task_id(10),.error_id=@get_local_task_id(15),
 .healthy=healthy,.received=metadata_received,.failed=fail});
const input_b=@import_module("static_input.csl",.{.enabled=origin,.capacity=31,
 .queue_id=4,.color_id=13,.resource_id=4,.done_id=@get_local_task_id(11),
 .error_id=@get_local_task_id(16),.healthy=healthy,.received=fragment_received,.failed=fail});
const output=@import_module("static_output.csl",.{.enabled=origin or peer or producer,
 .queue_id=if(producer) 2 else 6,.color_id=if(producer) 8 else if(origin) 12 else 13,
 .resource_id=if(producer) 2 else 6,.done_id=@get_local_task_id(12),
 .healthy=healthy,.valid=valid_source,.before=before_output,.sent=output_sent,.failed=fail});
const rows=@import_module(if(origin or peer) "row_packet.csl" else "<empty>",
 if(origin or peer) .{.source_role=peer,.send=send_row,.on_source_released=row_sent,.on_row_received=row_received} else .{});
fn metadata(kind:u32,phase:u32,group:u32,detail:u32) void {
 tx[0]=kind;tx[1]=1;tx[2]=1;tx[3]=0;tx[4]=0;tx[5]=phase;tx[6]=group;tx[7]=detail;
}
fn fixed_identity(data:[*]u32,length:u16) bool {
 return length>=8 and data[1]==1 and data[2]==1 and data[3]==0 and data[4]==0;
}
fn valid_source(data:[*]u32,length:u16) bool {
 if(!fixed_identity(data,length)){return false;}
 if(comptime producer){return length==8 and data[0]==10 and data[5]==3 and data[6]==@as(u32,column-first) and data[7]==0;}
 if(comptime origin){return length==8 and data[0]==11 and data[5]==2 and data[6]==@as(u32,tx_group) and data[7]==@as(u32,tx_group)*128;}
 if(comptime peer){
  if(data[0]!=9 or data[5]!=2 or data[6]!=@as(u32,tx_group) or data[7]!=@as(u32,rows.offset)){return false;}
  if(length!=(if(rows.offset==46) @as(u16,26) else @as(u16,31))){return false;}
  for(@range(u16,23))|i|{if(i<length-8){
   const low:u32=0x3f00+@as(u32,tx_group)*128+2*@as(u32,rows.offset+i);
   if(data[8+i]!=(low|((low+1)<<16))){return false;}
  }}return true;
 }
 return false;
}
fn send(data:[*]u32,length:u16) void {
 diag.append(1,data[6],length,0,data,0);output.send(data,length);
}
fn before_output(data:[*]u32,length:u16) void {diag.append(2,data[6],length,0,data,0);}
fn output_sent(data:[*]u32,length:u16) void {
 diag.append(3,data[6],length,0,data,0);
 if(comptime producer){done=true;state[2]=1;}
 if(comptime peer){rows.sent();}
 if(comptime origin){@activate(service);}
}
fn maybe_start() void {
 if(comptime producer){if(state[0]==2 and go_seen and !started and healthy()){
  started=true;metadata(10,3,@as(u32,column-first),0);send(&tx,8);
 }}
}
task go(word:u32) void {
 if(!healthy()){return;}
 if(word!=0x474f3031 or go_seen){fail(401);return;}
 go_seen=true;state[14]=1;maybe_start();
}
fn metadata_received(data:[*]u32,length:u16) void {
 if(!fixed_identity(data,length) or length!=8){fail(402);return;}
 if(comptime origin){
  if(data[0]!=10 or data[5]!=3 or data[6]>=@as(u32,count) or data[7]!=0){fail(403);return;}
  const owner=@as(u16,data[6]);
  if(seen[owner]!=0){fail(404);return;}seen[owner]=1;state[8]+=1;
  diag.append(4,data[6],8,9,data,0);input_a.release();
  if(state[8]<@as(u32,count)){input_a.arm(8);}
 }else if(comptime peer){
  if(data[0]!=11 or data[5]!=2 or data[6]>=8 or data[7]!=data[6]*128){fail(405);return;}
  if(request_pending or data[6]!=state[10]){fail(406);return;}
  pending_group=@as(u16,data[6]);request_pending=true;state[12]=1;state[10]+=1;
  diag.append(4,data[6],8,12,data,0);input_a.release();
  if(state[10]<8){input_a.arm(8);}
 }
 @activate(service);
}
fn send_row(x:u16,y:u16,data:[*]u32,length:u16) void {
 @assert(peer and x==0 and y==0);send(data,length);
}
fn row_sent(phase:u16) void {
 if(comptime peer){
  @assert(phase==2);state[13]+=1;@activate(service);
  if(state[13]==8){terminal[0]=8;diag.append(5,0,8,0,&terminal,0);done=true;state[2]=1;}
 }
}
fn row_received(data:[*]u16,phase:u16,group:u16) void {
 if(comptime origin){
  if(phase!=2 or group!=request){fail(407);return;}
  for(@range(u16,128))|i|{if(data[i]!=(0x3f00+@as(u16,group*128+i))){fail(408);return;}}
  rows.release_row(phase);state[9]+=1;request+=1;state[11]=@as(u32,request);@activate(service);
 }
}
fn fragment_received(data:[*]u32,length:u16) void {
 if(comptime origin){
  if(!fixed_identity(data,length) or !rows.active or rows.received or data[0]!=9 or data[5]!=2 or data[6]!=@as(u32,request) or data[7]!=@as(u32,rows.offset)){fail(409);return;}
  if(length!=(if(rows.offset==46) @as(u16,26) else @as(u16,31)) or fragment_count>=24){fail(410);return;}
  for(@range(u16,23))|i|{if(i<length-8){
   const low:u32=0x3f00+@as(u32,request)*128+2*@as(u32,rows.offset+i);
   if(data[8+i]!=(low|((low+1)<<16))){fail(411);return;}
  }}
  const base=fragment_count*32;row_packets[base]=@as(u32,length);
  for(@range(u16,31))|i|{if(i<length){row_packets[base+1+i]=data[i];}}
  fragment_count+=1;state[15]=@as(u32,fragment_count);
  diag.append(4,data[6],length,13,data,0);rows.receive(data,length);
  if(!healthy()){return;}
  input_b.release();
  if(rows.active){input_b.arm(if(rows.offset==46) @as(u16,26) else @as(u16,31));}
  @activate(service);
 }
}
task pump() void {
 if(!healthy() or done){return;}
 if(comptime peer){
  // REQUEST may precede the preceding row's final output-completion callback.
  // Both callbacks wake this task; authoritative pending/active state prevents loss.
  if(request_pending and output.status[3]==0 and !rows.active){
   request=pending_group;tx_group=request;request_pending=false;state[12]=0;
   for(@range(u16,128))|i|{source[i]=0x3f00+@as(u16,request*128+i);}
   rows.begin(1,1,0,0,9,2,request,128);rows.transmit(0,0,&source);
  }
 }
 if(comptime origin){
  if(output.status[3]!=0){return;}
  if(state[9]<8){
   if(!rows.active){
    rows.begin(1,1,0,0,9,2,request,128);input_b.arm(31);
    tx_group=request;metadata(11,2,@as(u32,request),@as(u32,request)*128);send(&tx,8);
   }
  }else if(state[8]==@as(u32,count)){
   done=true;state[2]=1;terminal[0]=state[8];terminal[1]=state[9];diag.append(5,0,8,0,&terminal,0);
  }
 }
}
fn initialize() void {
 @assert(state[0]==0);diag.init();state[0]=1;state[1]=@as(u32,role);state[3]=@as(u32,column);
 if(comptime origin or peer){input_a.arm(8);}
 if(comptime !origin and !peer and !producer){state[2]=1;}
 sys.unblock_cmd_stream();
}
fn compute() void {
 @assert(state[0]==1);state[0]=2;diag.status[7]=1;
 if(comptime origin){
  const dst=@get_dsd(fabout_dsd,.{.output_queue=go_out,.extent=1});
  @load_to_dsr(go_dsr,dst);@mov32(go_dsr,0x474f3031);@activate(service);
 }else if(comptime producer){maybe_start();}
 sys.unblock_cmd_stream();
}
var unused=@zeros([1]u32);
const state_ptr:[*]u32=&state;const unused_ptr:[*]u32=&unused;
const a_ptr:[*]u32=&input_a.status;const b_ptr:[*]u32=&input_b.status;const out_ptr:[*]u32=&output.status;
const diag_status:[*]u32=&diag.status;const diag_records:[*]u32=&diag.records;const row_ptr:[*]u32=&row_packets;
comptime {
 if(producer){@initialize_queue(go_in,.{.color=@get_color(3)});@bind_data_task(go,@get_data_task_id(go_in));}
 if(origin){@initialize_queue(go_out,.{.color=@get_color(3)});}
 @bind_local_task(pump,service);
 @export_symbol(state_ptr,"state");@export_symbol(unused_ptr,"relay_records");
 @export_symbol(unused_ptr,"gate_words");
 @export_symbol(a_ptr,"input_a_status");@export_symbol(b_ptr,"input_b_status");@export_symbol(out_ptr,"output_status");
 @export_symbol(diag_status,"diagnostic_status");@export_symbol(diag_records,"diagnostic_records");@export_symbol(row_ptr,"row_packets");
 @export_symbol(initialize);@export_symbol(compute);
}
