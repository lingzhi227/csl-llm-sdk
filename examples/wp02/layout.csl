const memcpy=@import_module("<memcpy/get_params>",.{.width=2,.height=1});
layout{
  @set_rectangle(2,1);
  for(@range(i16,2))|x|{
    @set_tile_code(x,0,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.rank=@as(u16,x)});
  }
  @export_name("weights_storage",[*]u16,false);
  @export_name("input_storage",[*]f32,false);
  @export_name("partial",[*]f32,false);@export_name("received",[*]f32,false);
  @export_name("summed",[*]f32,false);@export_name("normalized",[*]f32,false);
  @export_name("stats",[*]f32,false);@export_name("events",[*]u32,false);
  @export_name("mode",[*]u32,false);@export_name("compute",fn()void);
}
