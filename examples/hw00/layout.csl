// Resident spatial fragment. Source only: no compiled-fit claim.
const memcpy=@import_module("<memcpy/get_params>",.{.width=4,.height=2});
layout{@set_rectangle(4,2);
@set_tile_code(0,0,"tile.csl",.{.memcpy_params=memcpy.get_params(0),.rank=0});
@set_color_config(0,0,@get_color(3),.{.routes=.{.rx=.{SOUTH},.tx=.{RAMP,EAST}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=0,.max_counter=95,.limit1=191}});
@set_tile_code(1,0,"tile.csl",.{.memcpy_params=memcpy.get_params(1),.rank=1});
@set_color_config(1,0,@get_color(3),.{.routes=.{.rx=.{WEST},.tx=.{RAMP,EAST}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=96,.max_counter=95,.limit1=191}});
@set_tile_code(2,0,"tile.csl",.{.memcpy_params=memcpy.get_params(2),.rank=2});
@set_color_config(2,0,@get_color(3),.{.routes=.{.rx=.{WEST},.tx=.{RAMP,EAST}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=0,.max_counter=95,.limit1=191}});
@set_tile_code(3,0,"tile.csl",.{.memcpy_params=memcpy.get_params(3),.rank=3});
@set_color_config(3,0,@get_color(3),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=96,.max_counter=95,.limit1=191}});
@set_tile_code(0,1,"tile.csl",.{.memcpy_params=memcpy.get_params(0),.rank=4});
@set_color_config(0,1,@get_color(3),.{.routes=.{.rx=.{RAMP},.tx=.{NORTH}}});
@set_tile_code(1,1,"tile.csl",.{.memcpy_params=memcpy.get_params(1),.rank=5});
@set_color_config(1,1,@get_color(4),.{.routes=.{.rx=.{RAMP},.tx=.{EAST}}});
@set_tile_code(2,1,"tile.csl",.{.memcpy_params=memcpy.get_params(2),.rank=6});
@set_color_config(2,1,@get_color(4),.{.routes=.{.rx=.{WEST},.tx=.{RAMP,EAST}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=0,.max_counter=63,.limit1=127}});
@set_tile_code(3,1,"tile.csl",.{.memcpy_params=memcpy.get_params(3),.rank=7});
@set_color_config(3,1,@get_color(4),.{.routes=.{.rx=.{WEST},.tx=.{RAMP}},.filter=.{.kind=.{.counter=true},.count_data=true,.init_counter=64,.max_counter=63,.limit1=127}});
@export_name("weights",[*]u16,false);
@export_name("request",[*]u16,false);
@export_name("output",[*]u16,false);
@export_name("input",[*]f32,false);
@export_name("partial",[*]f32,false);
@export_name("reduced",[*]f32,false);
@export_name("rounded",[*]u16,false);
