const memcpy=@import_module("<memcpy/get_params>",.{.width=8,.height=2});
layout {
 @set_rectangle(8,2);
 for(@range(u16,2))|y|{
  const trace_route_color=@get_color(if(y==0) 7 else 8);
  for(@range(u16,8))|x|{
   @set_tile_code(x,y,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.x=x,.y=y});
   if(x<=2 or (x>=4 and x<=5)){
    @set_color_config(x,y,trace_route_color,.{.routes=.{
     .rx=if(x==0 or x==4) .{RAMP} else .{WEST},
     .tx=if(x==2 or x==5) .{RAMP} else .{EAST}}});
   }
   if(x<=1){
    @set_color_config(x,y,@get_color(3),.{.routes=.{
     .rx=if(x==1) .{RAMP} else .{EAST},.tx=if(x==1) .{WEST} else .{RAMP}}});
   }
   if(x==1 or x==2){
    @set_color_config(x,y,@get_color(4),.{.routes=.{
     .rx=if(x==2) .{RAMP} else .{EAST},.tx=if(x==2) .{WEST} else .{RAMP}}});
   }
   if(y==1 and x<=6){
    @set_color_config(x,y,@get_color(6),.{.routes=.{
     .rx=if(x==0) .{RAMP} else .{WEST},.tx=if(x==6) .{RAMP} else .{EAST}}});
   }
  }
 }
 @export_name("evidence",[*]u32,false);
 @export_name("fifo_backing",[*]u32,false);
 @export_name("trace",[*]u32,false);
 @export_name("sideband",[*]u32,false);
 @export_name("packet_data",[*]u32,false);
 @export_name("initialize",fn()void);
 @export_name("stall",fn()void);
 @export_name("coexist",fn()void);
}
