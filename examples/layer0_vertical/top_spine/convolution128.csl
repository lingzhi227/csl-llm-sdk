// One original128-channel Q, K or V group; no replicated convolution state.
// Arithmetic is split from preprocess384_reference.csl without reordering terms.
// Actual original inputs and the expanded exponential domain remain unqualified.
param vector_kind:u16; //0Q,1K,2V
const math=@import_module("<math>");
const bounded_exp=@import_module("exp_kernel.csl");
fn round_bf16(raw:u32) u16 {const odd:u32=(raw>>16)&1;return @as(u16,(raw+0x00007fff+odd)>>16);}
fn expand(raw:u16) f32 {return @bitcast(f32,@as(u32,raw)<<16);}
// stages: convolution pre-cast128, activation pre-cast128, negative-abs exp128.
// casts: convolution128, activation128. unscaled retains actual L2 output.
fn compute(history:[*]u16,weights:[*]u16,input:[*]u16,
           stages:[*]f32,casts:[*]u16,unscaled:[*]f32,output:[*]f32,stats:[*]f32) void {
 @assert(vector_kind<3);
 for(@range(u16,128))|c|{
  const base:u16=c*4;
  for(@range(u16,3))|j|{history[base+j]=history[base+j+1];}
  history[base+3]=input[c];
  var sum:f32=0.0;
  for(@range(u16,4))|j|{sum+=expand(history[base+j])*expand(weights[base+j]);}
  stages[c]=sum;const rounded=round_bf16(@bitcast(u32,sum));casts[c]=rounded;
  const x:f32=expand(rounded);const e=bounded_exp.exp_f32(if(x<0.0) x else -x);
  stages[c+256]=e;
  const sigmoid:f32=if(x<0.0) e/(1.0+e) else 1.0/(1.0+e);
  const activation:f32=x*sigmoid;stages[c+128]=activation;
  casts[c+128]=round_bf16(@bitcast(u32,activation));
 }
 if(comptime vector_kind<2){
  var square:f32=0.0;
  for(@range(u16,128))|i|{const x=expand(casts[128+i]);square+=x*x;}
  const denominator:f32=square+0.000001;const root:f32=math.sqrt_f32(denominator);const inverse:f32=1.0/root;
  stats[0]=square;stats[1]=denominator;stats[2]=root;stats[3]=inverse;
  for(@range(u16,128))|i|{
   unscaled[i]=expand(casts[128+i])*inverse;
   output[i]=if(vector_kind==0) unscaled[i]/11.313708498984761 else unscaled[i];
  }
 }else{
  for(@range(u16,128))|i|{unscaled[i]=expand(casts[128+i]);output[i]=unscaled[i];}
 }
}
