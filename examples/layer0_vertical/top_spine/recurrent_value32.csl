// Full-key,32-value-column shard for the final four-PE-per-head placement.
// Source only. Changing the old64x128 key-row partition changes reduction order;
// actual-operand numerical/state audits are required before device acceptance.
// Canonical element [key,value] maps locally to key*32+local_value. Four such
// shards concatenate along the original value axis; no hidden transpose.
const state_dst=@get_dsr(dsr_dest,3);
const state_src=@get_dsr(dsr_src0,3);
const delta_src=@get_dsr(dsr_src1,3);
const sum_dst=@get_dsr(dsr_dest,4);
const sum_src=@get_dsr(dsr_src0,4);
const matrix_src=@get_dsr(dsr_src1,4);

fn accumulate(value:f32) void {@fmacs(sum_dst,sum_src,matrix_src,value);}
fn update(value:f32) void {@fmacs(state_dst,state_src,delta_src,value);}
fn reset(matrix:[*]f32) void {
 const all=@get_dsd(mem1d_dsd,.{.base_address=matrix,.extent=4096});@fmovs(all,0.0);
}
fn reduce(matrix:[*]f32,vector:[*]f32,result:[*]f32) void {
 const output=@get_dsd(mem1d_dsd,.{.base_address=result,.extent=32});
 const row=@get_dsd(mem1d_dsd,.{.base_address=matrix,.extent=32});
 const x=@get_dsd(mem1d_dsd,.{.base_address=vector,.extent=128});
 @fmovs(output,0.0);
 @load_to_dsr(sum_dst,output,.{.save_address=false});
 @load_to_dsr(sum_src,output,.{.save_address=false});
 @load_to_dsr(matrix_src,row,.{.save_address=true});@map(accumulate,x);
}
fn decay_predict(matrix:[*]f32,key:[*]f32,decay:f32,prediction:[*]f32) void {
 const all=@get_dsd(mem1d_dsd,.{.base_address=matrix,.extent=4096});
 @load_to_dsr(state_dst,all,.{.save_address=false});
 @load_to_dsr(state_src,all,.{.save_address=false});@fmuls(state_dst,state_src,decay);
 reduce(matrix,key,prediction);
}
fn correction(value:[*]f32,prediction:[*]f32,beta:f32,delta:[*]f32) void {
 for(@range(u16,32))|i|{const difference:f32=value[i]-prediction[i];delta[i]=difference*beta;}
}
fn update_state(matrix:[*]f32,key:[*]f32,delta:[*]f32) void {
 const row=@get_dsd(mem1d_dsd,.{.base_address=matrix,.extent=32});
 const correction=@get_dsd(mem1d_dsd,.{.base_address=delta,.extent=32});
 const k=@get_dsd(mem1d_dsd,.{.base_address=key,.extent=128});
 @load_to_dsr(state_dst,row,.{.save_address=true});
 @load_to_dsr(state_src,row,.{.save_address=true});
 @load_to_dsr(delta_src,correction,.{.save_address=false});@map(update,k);
}
// All32 output columns are complete locally; there is no key-shard reduction.
// The owner must round/join the four32-column output vectors at the declared
// BF16 boundary before the128-channel gated norm, retaining FP32 recurrent state.
