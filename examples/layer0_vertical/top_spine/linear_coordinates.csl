const root_y:[130]u16=[130]u16{1100,1100,1100,1100,1100,1100,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992,1047,1102,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992,1047,1102,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992,1047,1102,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992,1047,1102,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992,1047,1102,2,57,112,167,222,277,332,387,442,497,552,607,662,717,772,827,882,937,992};
fn support_index(label:u16) u16 {@assert(label==1 or label==2 or (label>=16 and label<472));return if(label<=2) label-1 else label-14;}
fn support_x(label:u16) u16 {return if(label==0) @as(u16,0) else if(label==2) @as(u16,29) else @as(u16,1);}
fn support_y(label:u16) u16 {return if(label==0) @as(u16,0) else if(label==1) @as(u16,3) else if(label==2) @as(u16,2) else support_index(label)+2;}
fn label(id:u16) u16 {@assert(id>=130 and id<450);return if(id<210) 16+id-130 else if(id<258) 96+id-210 else 144+id-258;}
fn x(id:u16) u16 {@assert(id<450);return if(id<130) root_x[id] else support_x(label(id));}
fn y(id:u16) u16 {@assert(id<450);return if(id<130) root_y[id] else support_y(label(id));}
