// Ordered fragments commit directly into separately owned neural operand banks.
// Each configured slot is written exactly once per serial. No shared row alias.
param slots:u16;
param expected_id:fn(u16)u16;
param expected_recipient:fn(u16)u16;
param write_word:fn(u16,u16,u32)void;
param on_committed:fn(u16)void;
const protocol=@import_module("linear_protocol.csl",.{});
comptime {
 @comptime_assert(slots>0 and slots<=10);
}
var identity=@zeros([4]u32);var serial:u32=0;
var offsets=@zeros([slots]u16);var committed:u16=0;
// Four semantic reservations can wait while one older ACK's source interrupt
// remains outstanding. The current TX key is separate from four pending keys.
var pending_keys=@zeros([4]u32);var pending_count:u16=0;var first:u16=0;
var ack_inflight:bool=false;var ack_key:u32=0;
var initialized:bool=false;var errors:u32=0;
var counters=@zeros([5]u32); // fragments,records,ACK submitted,ACK complete,max pending
fn reject(code:u32) bool {if(errors==0){errors=code;}return false;}
fn quiescent() bool {
 return initialized and errors==0 and committed==slots and pending_count==0 and !ack_inflight;
}
fn begin(request:u32,generation:u32,position:u32,stage:u32,next_serial:u32) bool {
 if(errors!=0 or next_serial!=serial+1 or (initialized and !quiescent())){return reject(441);}
 for(@range(u16,slots))|i|{
  if(expected_id(i)>=450 or expected_recipient(i)>=protocol.recipients(expected_id(i))){return reject(450);}
  for(@range(u16,slots))|j|{if(i<j and expected_id(i)==expected_id(j)){return reject(451);}}
 }
 identity[0]=request;identity[1]=generation;identity[2]=position;identity[3]=stage;serial=next_serial;
 for(@range(u16,slots))|i|{offsets[i]=0;}
 committed=0;pending_count=0;first=0;ack_inflight=false;initialized=true;return true;
}
noinline fn receive(data:[*]u32,length:u16) bool {
 if(!initialized or errors!=0 or !protocol.matches(data,length,&identity,serial) or
    data[0]!=protocol.DATA or length<9){return reject(442);}
 const id=protocol.producer(data);const recipient=protocol.recipient(data);
 var slot:u16=slots;
 for(@range(u16,slots))|i|{if(id==expected_id(i) and recipient==expected_recipient(i)){slot=i;}}
 if(slot==slots){return reject(443);}
 const total=protocol.words(id);const offset=offsets[slot];
 if(offset>=total or data[7]!=@as(u32,offset)){return reject(444);}
 const remaining=total-offset;const count:u16=if(remaining<23) remaining else @as(u16,23);
 if(length!=count+8){return reject(445);}
 // Reserve metadata capacity before modifying a final fragment's neural bank.
 if(offset+count==total and pending_count>=4){return reject(446);}
 for(@range(u16,23))|i|{if(i<count){write_word(slot,offset+i,data[8+i]);}}
 offsets[slot]+=count;counters[0]+=1;
 if(offsets[slot]==total){
  const key=protocol.key(id,recipient);
  if(ack_inflight and ack_key==key){return reject(447);}
  for(@range(u16,4))|i|{if(i<pending_count and pending_keys[(first+i)%4]==key){return reject(448);}}
  pending_keys[(first+pending_count)%4]=key;pending_count+=1;
  if(pending_count>counters[4]){counters[4]=pending_count;}
  committed+=1;counters[1]+=1;on_committed(slot);
 }
 return true;
}
fn take_receipt(target:[*]u32) bool {
 if(errors!=0 or pending_count==0 or ack_inflight){return false;}
 ack_key=pending_keys[first];first=(first+1)%4;pending_count-=1;ack_inflight=true;
 protocol.pack(target,protocol.CONSUMED,&identity,serial,@as(u16,ack_key&0xffff),@as(u16,ack_key>>16),0);
 counters[2]+=1;return true;
}
fn receipt_source_complete() bool {
 if(!ack_inflight){return reject(449);}ack_inflight=false;counters[3]+=1;return true;
}
