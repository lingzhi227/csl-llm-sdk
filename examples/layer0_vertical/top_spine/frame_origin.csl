// One source for every dense-stage fixed period. Source-only implementation.
// Admission of a new frame is an explicit consumer-ready event, never inferred
// from the previous source completion or the root's collective completion.
param phase_count:u16;
param completion_task:local_task_id;
param on_need_chunk:fn(u16,u16)void;
param on_frame_injected:fn(u16)void;
// Fixture-only scheduling perturbation. Default stage execution never holds
// padding; the fixture forces the early-READY race without changing any data.
param diagnostic_hold_tail_until_ready:bool=false;
const FRAME:u16=17472;
const frame_oq=@get_output_queue(4);
const dest=@get_dsr(dsr_dest,5);const source=@get_dsr(dsr_src1,5);
var buffer=@zeros([128]f32);
var identity=@zeros([4]u32);
var phase:u16=0;
var words:u16=0;
var offset:u16=0;
var sent_count:u16=0;
var token_open:bool=false;
var frame_open:bool=false;
var awaiting_chunk:bool=false;
var sending:bool=false;
var pending_ready:bool=false;
var pending_words:u16=0;
var token_retired:bool=true;
var awaiting_tail_release:bool=false;
// early READYs, injected frames, supplied chunks, injected words, retired tokens.
var counters=@zeros([5]u32);

fn begin(request:u32,reset:u32,position:u32,stage:u32) void {
 @assert(token_retired and !token_open and !frame_open and !sending and !awaiting_chunk and !pending_ready and !awaiting_tail_release);
 identity[0]=request;identity[1]=reset;identity[2]=position;identity[3]=stage;
 phase=0;token_open=true;token_retired=false;
}
fn ready(request:u32,reset:u32,position:u32,stage:u32,next_phase:u16,input_words:u16) void {
 @assert(token_open and !pending_ready);
 @assert(request==identity[0] and reset==identity[1] and position==identity[2] and stage==identity[3]);
 @assert(input_words==5120 or input_words==6144 or input_words==17408);
 // Consumers can finish the neural input prefix before the long zero tail.
 // Preserve exactly one early next-phase event until this period is injected.
 if(frame_open){
  @assert(next_phase==phase+1 and next_phase<phase_count);
  pending_ready=true;pending_words=input_words;counters[0]+=1;
  if(awaiting_tail_release){awaiting_tail_release=false;pump();}
  return;
 }
 @assert(!sending and !awaiting_chunk and next_phase==phase and phase<phase_count);
 open_frame(input_words);
}
fn open_frame(input_words:u16) void {
 @assert(token_open and !frame_open and !sending and !awaiting_chunk and !pending_ready);
 words=input_words;offset=0;frame_open=true;
 // All declared inputs are nonempty and at least128 words. Start the first
 // chunk directly: pump -> open_frame -> pump would be a recursive call graph
 // even though each actual execution returns at an asynchronous transmission.
 @assert(words>=128);awaiting_chunk=true;on_need_chunk(0,128);
}
// The stage wrapper calls this only after the all-PE command-completion barrier
// AND final consumer output commit. Injection completion alone cannot retire a
// token: a distant lane may still own its input/line/output buffers.
fn retire(request:u32,reset:u32,position:u32,stage:u32) void {
 @assert(!token_retired and !token_open and !frame_open and !sending and !awaiting_chunk and !pending_ready);
 @assert(phase==phase_count and request==identity[0] and reset==identity[1] and position==identity[2] and stage==identity[3]);
 token_retired=true;counters[4]+=1;
}
fn transmit(count:u16) void {
 @assert(frame_open and !sending and !awaiting_chunk and count>0 and count<=128);
 @assert(offset+count<=FRAME);sent_count=count;sending=true;
 const mem=@get_dsd(mem1d_dsd,.{.base_address=&buffer,.extent=count});
 const base=@get_dsd(fabout_dsd,.{.output_queue=frame_oq,.extent=1});
 @load_to_dsr(dest,@set_dsd_length(base,count),.{.async=true,.activate=completion_task});
 @load_to_dsr(source,mem);@mov32(dest,source,.{.async=true});
}
fn pump() void {
 @assert(frame_open and !sending and !awaiting_chunk);
 if(offset<words){
  awaiting_chunk=true;on_need_chunk(offset,if(words-offset<128) words-offset else @as(u16,128));
 }else if(offset<FRAME){
  // First inject the active final96-column slot's zero tail. Holding exactly at
  // words could deadlock its partial slot (e.g.5120 requires5184 words).
  if(diagnostic_hold_tail_until_ready and phase+1<phase_count and !pending_ready and offset>=((words+95)/96)*96){
   awaiting_tail_release=true;return;
  }
  for(@range(u16,128))|i|{buffer[i]=0.0;}
  transmit(if(FRAME-offset<128) FRAME-offset else @as(u16,128));
 }else{
  frame_open=false;const completed=phase;phase+=1;counters[1]+=1;
  if(phase==phase_count){token_open=false;}
  on_frame_injected(completed);
  if(pending_ready){const next_words=pending_words;pending_ready=false;open_frame(next_words);}
 }
}
// Caller assembles an entire chunk before this call. The source's packet buffer
// can be released immediately after this synchronous BF16-to-FP32 copy.
fn supply(begin:u16,data:[*]u16,count:u16) void {
 @assert(frame_open and awaiting_chunk and !sending and begin==offset);
 @assert(count==(if(words-offset<128) words-offset else @as(u16,128)));
 for(@range(u16,128))|i|{if(i<count){
  @assert((data[i]&0x7f80)!=0x7f80);buffer[i]=@bitcast(f32,@as(u32,data[i])<<16);
 }}
 awaiting_chunk=false;counters[2]+=1;transmit(count);
}
task chunk_released() void {
 @assert(frame_open and sending and !awaiting_chunk);sending=false;offset+=sent_count;counters[3]+=@as(u32,sent_count);pump();
}
comptime {
 @initialize_queue(frame_oq,.{.color=@get_color(4)});
 @bind_local_task(chunk_released,completion_task);
}
