// One D256 query/KV head. Only the valid cache prefix participates.
const bounded_exp=@import_module("exp_kernel.csl");
fn round_bf16(raw:u32) u16 {const odd:u32=(raw>>16)&1;return @as(u16,(raw+0x00007fff+odd)>>16);}
fn expand(raw:u16) f32 {return @bitcast(f32,@as(u32,raw)<<16);}
fn compute(cache:[*]u16,input:[*]u16,scores:[*]f32,score_casts:[*]u16,
 stats:[*]f32,stages:[*]f32,casts:[*]u16,n:u16,events:[*]u32) u32 {
 var domain_errors:u32=0;
 const offset:u16=(n-1)*256;
 for(@range(u16,256))|c|{cache[offset+c]=input[256+c];cache[2048+offset+c]=input[512+c];}
 events[2]=3;
 for(@range(u16,40))|i|{scores[i]=0.0;}
 for(@range(u16,24))|i|{score_casts[i]=0;}
 var slot:u16=0;
 while(slot<n){
  var dot:f32=0.0;
  for(@range(u16,256))|c|{dot+=expand(input[c])*expand(cache[slot*256+c]);}
  scores[slot]=dot;score_casts[slot]=round_bf16(@bitcast(u32,dot));
  const scaled:f32=expand(score_casts[slot])/16.0;
  scores[8+slot]=scaled;score_casts[8+slot]=round_bf16(@bitcast(u32,scaled));slot+=1;
 }
 events[3]=4;
 var maximum:f32=expand(score_casts[8]);slot=1;
 while(slot<n){const x=expand(score_casts[8+slot]);if(x>maximum){maximum=x;}slot+=1;}
 stats[0]=maximum;var sum:f32=0.0;slot=0;
 while(slot<n){
  const shift:f32=expand(score_casts[8+slot])-stats[0];scores[16+slot]=shift;
  if(shift < -24.0 or shift > 0.0){domain_errors+=1;}
  const e=bounded_exp.exp_f32(shift);scores[24+slot]=e;sum+=e;slot+=1;
 }
 stats[1]=sum;stats[2]=1.0/sum;slot=0;
 while(slot<n){
  const p:f32=scores[24+slot]*stats[2];scores[32+slot]=p;
  score_casts[16+slot]=round_bf16(@bitcast(u32,p));slot+=1;
 }
 events[4]=5;
 for(@range(u16,256))|c|{
  var sumv:f32=0.0;slot=0;
  while(slot<n){sumv+=expand(score_casts[16+slot])*expand(cache[2048+slot*256+c]);slot+=1;}
  stages[c]=sumv;casts[c]=round_bf16(@bitcast(u32,sumv));
 }
 events[5]=6;
 // Materialize and observe each raw gate after all reductions.
 for(@range(u16,256))|c|{
  stages[256+c]=expand(input[768+c]);
  const g:f32=stages[256+c];const arg:f32=if(g<0.0) g else -g;
  if(arg < -24.0 or arg > 0.0){domain_errors+=1;}
  const e=bounded_exp.exp_f32(arg);stages[512+c]=e;
  const sigmoid:f32=if(g<0.0) e/(1.0+e) else 1.0/(1.0+e);
  stages[768+c]=sigmoid;casts[256+c]=round_bf16(@bitcast(u32,sigmoid));
  const out:f32=expand(casts[c])*expand(casts[256+c]);
  stages[1024+c]=out;casts[512+c]=round_bf16(@bitcast(u32,out));
 }
 events[6]=7;return domain_errors;
}
