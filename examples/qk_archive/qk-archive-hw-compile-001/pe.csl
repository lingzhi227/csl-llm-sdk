 }
 if(comptime sink){published();}
 if(comptime join){release_joined();}
 finish();
}
fn reject_expected(value:bool) void {negative_count+=1;if(value){negative_failures+=1;}}
fn accept_expected(value:bool) void {positive_count+=1;if(!value){negative_failures+=1;}}
fn fresh_source() void {
 if(comptime join){
  negative_source.phase=0;negative_source.generation=0;negative_source.errors=0;negative_source.rejected=0;
  accept_expected(negative_source.begin(7,11,0,2,0,1));
 }
}
fn fresh_marker() void {
 if(comptime join){
  negative.phase=0;negative.generation=0;negative.errors=0;negative.rejected=0;
  accept_expected(negative.begin(7,11,0,2,0,1));fresh_source();
  accept_expected(negative_source.source_marker(&negative_marker,1));
 }
}
fn accepted_marker() void {
 if(comptime join){fresh_marker();accept_expected(negative.receive_marker(&negative_marker,1));}
}
fn received_blocks() void {
 if(comptime join){accepted_marker();accept_expected(negative.block_received());accept_expected(negative.block_received());}
}
fn final_marker() void {
 if(comptime join){
  for(@range(u16,32))|i|{negative_marker[i]=0;}
  negative_marker[0]=16;negative_marker[31]=16;negative_marker[1]=0x48445031;
  negative_marker[2]=4|(17<<16);negative_marker[3]=1;negative_marker[4]=11;
  negative_marker[5]=7;negative_marker[26]=2;negative_marker[30]=1<<11;
 }
}
fn final_valid() bool {
 if(comptime join){return negative.final_metadata(&negative_marker,1,8,7,1);}
 return false;
}
fn negative_checks() void {
 if(epoch!=2 or !done or failed or waiting or first_live or second_live){fail(65536);return;}
 if(comptime join){
  // Isolated module instances are explicitly reset between rejected cases.
  // The real archived generations and their already-persisted data are untouched.
  for(@range(u16,32))|i|{fresh_marker();negative_marker[i]^=1;reject_expected(negative.receive_marker(&negative_marker,1));}
  fresh_marker();reject_expected(negative.block_received());
  fresh_marker();reject_expected(negative.commit_received());
  fresh_marker();reject_expected(negative.begin(7,12,0,2,0,2));
  accepted_marker();reject_expected(negative.commit_received());
  accepted_marker();reject_expected(negative.receive_marker(&negative_marker,1));
  accepted_marker();accept_expected(negative.block_received());reject_expected(negative.commit_received());
  received_blocks();accept_expected(negative.commit_received());reject_expected(negative.commit_received());
  received_blocks();accept_expected(negative.commit_received());reject_expected(negative.begin(7,11,0,2,0,2));
  accepted_marker();reject_expected(negative.begin(7,12,0,2,0,2));
  received_blocks();accept_expected(negative.commit_received());reject_expected(negative.begin(7,12,0,2,0,3));
  fresh_source();reject_expected(negative_source.source_released());
  fresh_source();accept_expected(negative_source.source_marker(&negative_marker,1));reject_expected(negative_source.source_marker(&negative_marker,2));
  fresh_source();accept_expected(negative_source.source_marker(&negative_marker,1));accept_expected(negative_source.source_released());reject_expected(negative_source.source_released());
  fresh_source();accept_expected(negative_source.source_marker(&negative_marker,1));reject_expected(negative_source.begin(7,12,0,2,0,2));
  fresh_source();reject_expected(negative_source.source_marker(&negative_marker,66));
  // Both actual gate orders: final before commit and commit before final.
  received_blocks();final_marker();reject_expected(final_valid());
  accept_expected(negative.commit_received());accept_expected(final_valid());
  received_blocks();accept_expected(negative.commit_received());reject_expected(final_valid());
  final_marker();accept_expected(final_valid());
  const fields:[11]u16=[11]u16{0,31,1,2,3,4,5,25,26,30,30};
  const masks:[11]u32=[11]u32{1,1,1,1,1,1,1,0x04000000,1,0x40000000,0x80000000};
  for(@range(u16,11))|i|{
   const previous=negative_marker[fields[i]];negative_marker[fields[i]]^=masks[i];
   reject_expected(final_valid());negative_marker[fields[i]]=previous;
  }
  accept_expected(final_valid());
  // A new identity is allowed only after commit; host consumption is external.
  accept_expected(negative.begin(7,12,0,2,0,2));
 }
 if(comptime sink){
  accept_expected(observer.retained_final(epoch));
  observer.observer_fail();
  reject_expected(observer.retained_final(epoch));
  accept_expected(observer.archive.status[0]==4 and observer.archive.status[15]==4 and observer.archive.status[14]==32768);
 }
 capture();sys.unblock_cmd_stream();
}
const evidence_ptr:[*]u32=&evidence;
const archive_ptr:[*]u32=if(sink) &observer.archive_storage else &evidence;
const reference_ptr:[*]u32=&reference;
const workspace_ptr:[*]f32=if(aliased) &attn.stages else &unused_float;
const output_ptr:[*]u16=&output;
const qk_input_ptr:[*]u16=if(owner) &attn.qk_input else &output;
const gains_ptr:[*]u16=if(owner) &attn.qk_weights else &output;
const stats_ptr:[*]f32=if(owner) &attn.qk_stats else &unused_float;
const cache_ptr:[*]u16=if(owner) &attn.cache else &output;
const input_ptr:[*]u16=if(owner) &attn.input else &output;
const casts_ptr:[*]u16=if(owner) &attn.casts else &output;
comptime {
 if(aliased or sink){@initialize_queue(notice_output,.{.color=if(aliased) @get_color(7) else @get_color(8)});}
 if(join){
  @initialize_queue(first_input,.{.color=@get_color(7)});@bind_local_task(first_received,first_task);
  @initialize_queue(release_output,.{.color=@get_color(9)});
 }
 if(sink or join){
  @initialize_queue(second_input,.{.color=if(sink) @get_color(9) else @get_color(8)});
  @bind_local_task(second_received,second_task);
 }
 @export_symbol(evidence_ptr,"evidence");@export_symbol(archive_ptr,"archive");
 @export_symbol(reference_ptr,"reference");@export_symbol(workspace_ptr,"workspace");@export_symbol(output_ptr,"output");
 @export_symbol(qk_input_ptr,"qk_input");@export_symbol(gains_ptr,"qk_gains");@export_symbol(stats_ptr,"qk_stats");
 @export_symbol(cache_ptr,"cache");@export_symbol(input_ptr,"input");@export_symbol(casts_ptr,"casts");
 @export_symbol(initialize);@export_symbol(prepare);@export_symbol(compute);@export_symbol(negative_checks);
