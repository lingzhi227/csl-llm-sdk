param memcpy_params;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const kernel=@import_module("kernel.csl");
var history=@zeros([1538]u16);var weights=@zeros([1538]u16);var input=@zeros([386]u16);
var parameters=@zeros([6]u16);var stages=@zeros([1154]f32);var casts=@zeros([770]u16);
var outputs=@zeros([514]f32);var norm_stats=@zeros([8]f32);var gates=@zeros([15]f32);var beta_bits=@zeros([1]u16);
var probes=@zeros([16]u32);var probe_output=@zeros([16]u16);
var control=@zeros([2]u32);
// generation,last_token,total,initializations,valid_history,phase,error,unblocks.
var state=@zeros([8]u32);
fn initialize() void {
 if(control[0]<=state[0] or control[1]!=0 or (state[5]==1 or state[5]==2)){state[6]=1;sys.unblock_cmd_stream();return;}
 for(@range(u16,1536))|i|{history[i+1]=0;}
 state[0]=control[0];state[1]=0;state[3]+=1;state[4]=0;state[5]=0;state[6]=0;state[7]=0;
 sys.unblock_cmd_stream();
}
fn token() void {
 if(control[0]!=state[0] or control[1]!=state[1]+1 or (state[5]==1 or state[5]==2)){state[6]=2;sys.unblock_cmd_stream();return;}
 state[5]=1;
 kernel.compute_vectors(@ptrcast([*]u16,&history[1]),@ptrcast([*]u16,&weights[1]),@ptrcast([*]u16,&input[1]),
  @ptrcast([*]f32,&stages[1]),@ptrcast([*]u16,&casts[1]),@ptrcast([*]f32,&outputs[1]),&norm_stats);
 if(state[4]<4){state[4]+=1;}
 state[5]=2;sys.unblock_cmd_stream();
}
fn finalize() void {
 if(control[0]!=state[0] or control[1]!=state[1]+1 or state[5]!=2){state[6]=3;sys.unblock_cmd_stream();return;}
 // Fixed global offsets plus independently observable values; no gate source survives vector computation.
 gates[11]=@bitcast(f32,@as(u32,parameters[1])<<16);
 gates[12]=@bitcast(f32,@as(u32,parameters[2])<<16);
 gates[13]=@bitcast(f32,@as(u32,parameters[3])<<16);
 gates[14]=@bitcast(f32,@as(u32,parameters[4])<<16);
 kernel.compute_gates(&gates,&beta_bits);
 for(@range(u16,16))|i|{probe_output[i]=kernel.round_bf16(probes[i]);}
 state[1]=control[1];state[2]+=1;state[5]=3;state[7]+=1;sys.unblock_cmd_stream();
}

const hp:[*]u16=&history;const wp:[*]u16=&weights;const ip:[*]u16=&input;const pp:[*]u16=&parameters;
const fp:[*]f32=&stages;const bp:[*]u16=&casts;const op:[*]f32=&outputs;const np:[*]f32=&norm_stats;
const gp:[*]f32=&gates;const betap:[*]u16=&beta_bits;const cp:[*]u32=&control;const sp:[*]u32=&state;
const pr:[*]u32=&probes;const po:[*]u16=&probe_output;
comptime{
 @export_symbol(hp,"history");@export_symbol(wp,"weights");@export_symbol(ip,"input");@export_symbol(pp,"parameters");
 @export_symbol(fp,"stages");@export_symbol(bp,"casts");@export_symbol(op,"outputs");@export_symbol(np,"norm_stats");
 @export_symbol(gp,"gates");@export_symbol(betap,"beta_bits");@export_symbol(cp,"control");@export_symbol(sp,"state");
 @export_symbol(pr,"probes");@export_symbol(po,"probe_output");@export_symbol(initialize);@export_symbol(token);@export_symbol(finalize);
}
