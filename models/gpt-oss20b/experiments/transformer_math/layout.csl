const memcpy=@import_module("<memcpy/get_params>",.{.width=2,.height=1});
layout {
  @set_rectangle(2,1);
  for(@range(i16,2))|x|{@set_tile_code(x,0,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.rank=@as(u16,x)});}
  @export_name("hidden",[*]u16,false);@export_name("gain",[*]u16,false);@export_name("normalized",[*]u16,false);
  @export_name("rotary_input",[*]u16,false);@export_name("rotary_output",[*]u16,false);
  @export_name("frequencies",[*]f32,false);@export_name("position",[*]u32,false);
  @export_name("query",[*]u16,false);@export_name("new_key",[*]u16,false);@export_name("new_value",[*]u16,false);
  @export_name("keys",[*]u16,false);@export_name("values",[*]u16,false);@export_name("sinks",[*]u16,false);
  @export_name("attention",[*]u16,false);@export_name("calls",[*]u32,false);
  @export_name("normalize",fn()void);@export_name("rotate",fn()void);@export_name("step",fn()void);
}
