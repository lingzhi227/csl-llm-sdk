param memcpy_params;param parity:u16;param tail:bool;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var identity=@zeros([4]u32);var counters=@zeros([6]u32);var frame=@zeros([3]u32);var index:u16=0;
const ip:[*]u32=&identity;const cp:[*]u32=&counters;
const local_iq=@get_input_queue(2);const vertical_iq=@get_input_queue(3);const oq=@get_output_queue(2);
const rx_dst=@get_dsr(dsr_dest,3);const rx_src=@get_dsr(dsr_src1,3);
const tx_dst=@get_dsr(dsr_dest,4);const tx_src=@get_dsr(dsr_src1,4);
const recv_task=@get_local_task_id(8);const sent_task=@get_local_task_id(9);
fn receive(comptime queue:input_queue) void {
  const mem=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=3});
  const wire=@get_dsd(fabin_dsd,.{.input_queue=queue,.extent=3});
  @load_to_dsr(rx_dst,mem);@load_to_dsr(rx_src,wire,.{.async=true,.activate=recv_task,.ut_id=@get_ut_id(3)});
  @mov32(rx_dst,rx_src,.{.async=true});
}
task received() void {
  @assert(frame[0]==counters[0]);counters[1]+=1;
  const mem=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=3});
  const wire=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=3});
  @load_to_dsr(tx_src,mem);@load_to_dsr(tx_dst,wire,.{.async=true,.activate=sent_task,.ut_id=@get_ut_id(4)});
  @mov32(tx_dst,tx_src,.{.async=true});
}
task sent() void {counters[2]+=1;if(index==37){counters[4]+=1;}sys.unblock_cmd_stream();}
fn step(phase:u16,layer:u16,row:u16) void {
  if(phase==15){@assert(counters[0]==counters[4]);counters[0]+=1;sys.unblock_cmd_stream();}
  else if(phase==16){
    @assert(row<38);index=row;const target:u32=29+30*@as(u32,row);
    if(identity[1]>target){sys.unblock_cmd_stream();}
    else if(identity[1]==target){receive(local_iq);}else{receive(vertical_iq);}
  }else{sys.unblock_cmd_stream();}
}
comptime {
  @initialize_queue(local_iq,.{.color=@get_color(15)});
  if(!tail){@initialize_queue(vertical_iq,.{.color=@get_color(if(parity==0) 16 else 17)});}
  @initialize_queue(oq,.{.color=@get_color(if(parity==1) 16 else 17)});
  @bind_local_task(received,recv_task);@bind_local_task(sent,sent_task);
  @export_symbol(ip,"identity");@export_symbol(cp,"counters");@export_symbol(step);
}
