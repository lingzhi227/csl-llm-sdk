param memcpy_params;param ingress:bool;param metadata:bool;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var identity=@zeros([4]u32);var counters=@zeros([6]u32);var routing=@zeros([if(metadata) 8 else 1]u32);
var hidden_words=@zeros([if(ingress) 1440 else 1]u32);
const ip:[*]u32=&identity;const cp:[*]u32=&counters;const hp:[*]u32=&hidden_words;
const iq=@get_input_queue(2);const oq=@get_output_queue(2);
const done=@get_local_task_id(8);const dest=@get_dsr(dsr_dest,3);const src=@get_dsr(dsr_src1,3);
task completed() void {sys.unblock_cmd_stream();}
fn step(phase:u16,layer:u16,index:u16) void {
  if(identity[0]!=@as(u32,layer)){sys.unblock_cmd_stream();return;}
  if(phase==10){
    if(comptime ingress){
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&hidden_words,.extent=1440});
    const wire=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=1440});
    @load_to_dsr(src,mem);@load_to_dsr(dest,wire,.{.async=true,.activate=done,.ut_id=@get_ut_id(3)});
    @mov32(dest,src,.{.async=true});
    }else{sys.unblock_cmd_stream();}
  }else if(phase==11){
    if(comptime metadata){
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&routing,.extent=8});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=8});
    @load_to_dsr(dest,mem);@load_to_dsr(src,wire,.{.async=true,.activate=done,.ut_id=@get_ut_id(3)});
    @mov32(dest,src,.{.async=true});
    }else{sys.unblock_cmd_stream();}
  }else{
    if(phase==12){counters[0]+=1;counters[4]+=1;}
    sys.unblock_cmd_stream();
  }
}
comptime {
  if(metadata){@initialize_queue(iq,.{.color=@get_color(19)});}
  if(ingress){@initialize_queue(oq,.{.color=@get_color(17)});}
  @bind_local_task(completed,done);@export_symbol(ip,"identity");@export_symbol(cp,"counters");
  @export_symbol(hp,"hidden");@export_symbol(step);
}
