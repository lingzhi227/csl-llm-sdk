param memcpy_params;param first:bool;param last:bool;param parity:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const kernel=@import_module("bf16_gemv.csl",.{.rows=32,.columns=96});
const math=@import_module("moe_math.csl");
var identity=@zeros([4]u32);var counters=@zeros([6]u32);
var weights=@zeros([3072]u16);var bias=@zeros([if(last) 32 else 1]u16);
var input=@zeros([96]f32);var partial=@zeros([32]f32);var previous=@zeros([if(first) 1 else 32]f32);
const ip:[*]u32=&identity;const cp:[*]u32=&counters;const wp:[*]u16=&weights;const bp:[*]u16=&bias;const xp:[*]f32=&input;
const iq=@get_input_queue(2);const rq=@get_input_queue(3);const oq=@get_output_queue(3);
const input_task=@get_local_task_id(8);const reduction_task=@get_local_task_id(9);const sent_task=@get_local_task_id(10);
const rx_dst=@get_dsr(dsr_dest,3);const rx_src=@get_dsr(dsr_src1,3);
const tx_dst=@get_dsr(dsr_dest,4);const tx_src=@get_dsr(dsr_src1,4);
const sum_dst=@get_dsr(dsr_dest,5);const sum_src=@get_dsr(dsr_src1,5);
fn send() void {
  const mem=@get_dsd(mem1d_dsd,.{.base_address=&partial,.extent=32});
  const wire=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=32});
  @load_to_dsr(tx_src,mem);@load_to_dsr(tx_dst,wire,.{.async=true,.activate=sent_task,.ut_id=@get_ut_id(4)});
  @mov32(tx_dst,tx_src,.{.async=true});
}
task received() void {
  kernel.compute(wp,xp,&partial);
  if(comptime first){send();}
  else{
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&previous,.extent=32});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=rq,.extent=32});
    @load_to_dsr(sum_dst,mem);@load_to_dsr(sum_src,wire,.{.async=true,.activate=reduction_task,.ut_id=@get_ut_id(5)});
    @mov32(sum_dst,sum_src,.{.async=true});
  }
}
task reduced() void {
  for(@range(u16,32))|i|{
    partial[i]+=previous[i];
    if(comptime last){partial[i]=math.rounded(partial[i]+math.f32_from_bf16(bias[i]));}
  }
  send();
}
task sent() void {counters[4]+=1;sys.unblock_cmd_stream();}
fn step(phase:u16,layer:u16,index:u16) void {
  if(phase!=10 or identity[0]!=@as(u32,layer)){sys.unblock_cmd_stream();return;}
  @assert(counters[0]==counters[4]);counters[0]+=1;
  const mem=@get_dsd(mem1d_dsd,.{.base_address=xp,.extent=96});
  const wire=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=96});
  @load_to_dsr(rx_dst,mem);@load_to_dsr(rx_src,wire,.{.async=true,.activate=input_task,.ut_id=@get_ut_id(3)});
  @mov32(rx_dst,rx_src,.{.async=true});
}
comptime {
  @initialize_queue(iq,.{.color=@get_color(15)});
  if(!first){@initialize_queue(rq,.{.color=@get_color(if(parity==1) 4 else 5)});@bind_local_task(reduced,reduction_task);}
  @initialize_queue(oq,.{.color=@get_color(if(last) 16 else if(parity==0) 4 else 5)});
  @bind_local_task(received,input_task);@bind_local_task(sent,sent_task);
  @export_symbol(ip,"identity");@export_symbol(cp,"counters");@export_symbol(wp,"weights");@export_symbol(bp,"bias");
  @export_symbol(xp,"input");@export_symbol(step);
}
