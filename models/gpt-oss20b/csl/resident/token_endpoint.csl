param memcpy_params;param west:bool;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var identity=@zeros([4]u32);var counters=@zeros([6]u32);var token=@zeros([1]u32);var frame=@zeros([3]u32);
const ip:[*]u32=&identity;const cp:[*]u32=&counters;const tp:[*]u32=&token;
const iq=@get_input_queue(2);const oq=@get_output_queue(2);
const dest=@get_dsr(dsr_dest,3);const src=@get_dsr(dsr_src1,3);const done=@get_local_task_id(8);
task completed() void {
  if(comptime !west){@assert(frame[0]==counters[0] and frame[1]<201088);token[0]=frame[1];}
  counters[4]+=1;sys.unblock_cmd_stream();
}
fn step(phase:u16,layer:u16,index:u16) void {
  if(comptime west){
    if(phase==1){
      @assert(token[0]<201088 and counters[0]==counters[4]);counters[0]+=1;frame[0]=counters[0];frame[1]=token[0];
      const mem=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=2});
      const wire=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=2});
      @load_to_dsr(src,mem);@load_to_dsr(dest,wire,.{.async=true,.activate=done,.ut_id=@get_ut_id(3)});
      @mov32(dest,src,.{.async=true});return;
    }
  }else{
    if(phase==16 and index==37){
      @assert(counters[0]==counters[4]);counters[0]+=1;
      const mem=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=3});
      const wire=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=3});
      @load_to_dsr(dest,mem);@load_to_dsr(src,wire,.{.async=true,.activate=done,.ut_id=@get_ut_id(3)});
      @mov32(dest,src,.{.async=true});return;
    }
  }
  sys.unblock_cmd_stream();
}
comptime {
  if(west){@initialize_queue(oq,.{.color=@get_color(12)});}else{@initialize_queue(iq,.{.color=@get_color(13)});}
  @bind_local_task(completed,done);@export_symbol(ip,"identity");@export_symbol(cp,"counters");@export_symbol(tp,"token");@export_symbol(step);
}
