param memcpy_params;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const norm=@import_module("normalization_rope.csl");const math=@import_module("moe_math.csl");
var identity=@zeros([4]u32);var counters=@zeros([6]u32);
var hidden=@zeros([1440]u32);var gain=@zeros([2880]u16);var input=@zeros([2880]f32);
var hidden_ready:bool=false;
var best=@zeros([3]u32);var candidate=@zeros([3]u32);var phase:u16=0;var index:u16=0;
const ip:[*]u32=&identity;const cp:[*]u32=&counters;const hp:[*]u32=&hidden;const gp:[*]u16=&gain;const xp:[*]f32=&input;
const hidden_iq=@get_input_queue(2);const result_iq=@get_input_queue(3);
const input_oq=@get_output_queue(2);const token_oq=@get_output_queue(3);
const rx_dst=@get_dsr(dsr_dest,3);const rx_src=@get_dsr(dsr_src1,3);
const tx_dst=@get_dsr(dsr_dest,4);const tx_src=@get_dsr(dsr_src1,4);
const recv_task=@get_local_task_id(8);const sent_task=@get_local_task_id(9);
fn send(data:[*]u32,count:u16,comptime queue:output_queue) void {
  const mem=@get_dsd(mem1d_dsd,.{.base_address=data,.extent=count});
  const wire=@get_dsd(fabout_dsd,.{.output_queue=queue,.extent=1});
  @load_to_dsr(tx_src,mem);@load_to_dsr(tx_dst,@set_dsd_length(wire,count),.{.async=true,.activate=sent_task,.ut_id=@get_ut_id(4)});
  @mov32(tx_dst,tx_src,.{.async=true});
}
task received() void {
  if(phase==14){hidden_ready=true;sys.unblock_cmd_stream();}
  else if(phase==15){
    const bits:[*]u16=@ptrcast([*]u16,&input);norm.normalize(@ptrcast([*]u16,&hidden),gp,bits);
    var i:u16=2880;while(i>0){i-=1;input[i]=math.f32_from_bf16(bits[i]);}send(@ptrcast([*]u32,&input),2880,input_oq);
  }else{
    @assert(candidate[0]==counters[0]);const a:f32=@bitcast(f32,candidate[2]);const b:f32=@bitcast(f32,best[2]);
    if(index==0 or a>b or (a==b and candidate[1]<best[1])){best=candidate;}
    counters[1]+=1;
    if(index==37){@assert(best[1]<201088);send(&best,3,token_oq);}else{sys.unblock_cmd_stream();}
  }
}
task sent() void {if(phase==16){counters[4]+=1;}sys.unblock_cmd_stream();}
fn step(requested:u16,layer:u16,row:u16) void {
  phase=requested;index=row;
  if(phase==14 and layer==23){
    @assert(!hidden_ready and counters[0]==counters[4]);
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&hidden,.extent=1440});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=hidden_iq,.extent=1440});
    @load_to_dsr(rx_dst,mem);@load_to_dsr(rx_src,wire,.{.async=true,.activate=recv_task,.ut_id=@get_ut_id(3)});
    @mov32(rx_dst,rx_src,.{.async=true});
  }else if(phase==15){
    @assert(hidden_ready and counters[0]==counters[4]);hidden_ready=false;counters[0]+=1;@activate(recv_task);
  }else if(phase==16){
    @assert(row<38 and counters[1]==(counters[0]-1)*38+@as(u32,row));
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&candidate,.extent=3});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=result_iq,.extent=3});
    @load_to_dsr(rx_dst,mem);@load_to_dsr(rx_src,wire,.{.async=true,.activate=recv_task,.ut_id=@get_ut_id(3)});
    @mov32(rx_dst,rx_src,.{.async=true});
  }else{sys.unblock_cmd_stream();}
}
comptime {
  @initialize_queue(hidden_iq,.{.color=@get_color(12)});@initialize_queue(result_iq,.{.color=@get_color(16)});
  @initialize_queue(input_oq,.{.color=@get_color(3)});@initialize_queue(token_oq,.{.color=@get_color(13)});
  @bind_local_task(received,recv_task);@bind_local_task(sent,sent_task);
  @export_symbol(ip,"identity");@export_symbol(cp,"counters");@export_symbol(hp,"hidden");
  @export_symbol(gp,"gain");@export_symbol(xp,"input");@export_symbol(step);
}
