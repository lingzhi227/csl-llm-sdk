// Original attention BF16 matrices: 128 output rows, 96 contraction columns.
param memcpy_params;param kind:u16;param first:bool;param last:bool;param parity:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const kernel=@import_module("bf16_gemv.csl",.{.rows=128,.columns=96});
const math=@import_module("moe_math.csl");
var identity=@zeros([4]u32);var counters=@zeros([6]u32);
var weights=@zeros([12288]u16);var bias=@zeros([if(last) 128 else 1]u16);
var input=@zeros([96]f32);var partial=@zeros([128]f32);var previous=@zeros([if(first) 1 else 128]f32);
var packed_values=@zeros([if(last) 64 else 1]u32);var gathering:bool=false;
const ip:[*]u32=&identity;const cp:[*]u32=&counters;const wp:[*]u16=&weights;const bp:[*]u16=&bias;
const xp:[*]f32=&input;const op:[*]u32=&packed_values;
const iq=@get_input_queue(2);const rq=@get_input_queue(3);
const oq=@get_output_queue(3);const reply_oq=@get_output_queue(4);
const input_task=@get_local_task_id(8);const reduction_task=@get_local_task_id(9);const sent_task=@get_local_task_id(10);
const rx_dst=@get_dsr(dsr_dest,3);const rx_src=@get_dsr(dsr_src1,3);
const tx_dst=@get_dsr(dsr_dest,4);const tx_src=@get_dsr(dsr_src1,4);
const sum_dst=@get_dsr(dsr_dest,5);const sum_src=@get_dsr(dsr_src1,5);
fn transmit(data:[*]u32,count:u16,comptime queue:output_queue) void {
  const mem=@get_dsd(mem1d_dsd,.{.base_address=data,.extent=count});
  const wire=@get_dsd(fabout_dsd,.{.output_queue=queue,.extent=1});
  @load_to_dsr(tx_src,mem);@load_to_dsr(tx_dst,@set_dsd_length(wire,count),.{.async=true,.activate=sent_task,.ut_id=@get_ut_id(4)});
  @mov32(tx_dst,tx_src,.{.async=true});
}
fn ready() void {
  if(comptime last){
    const out:[*]u16=@ptrcast([*]u16,&packed_values);
    for(@range(u16,128))|i|{out[i]=math.round_bf16(partial[i]+math.f32_from_bf16(bias[i]));}
    counters[4]+=1;sys.unblock_cmd_stream();
  }else{transmit(@ptrcast([*]u32,&partial),128,oq);}
}
task received() void {
  kernel.compute(wp,xp,&partial);counters[1]+=1;
  if(comptime first){ready();}
  else{
    const mem=@get_dsd(mem1d_dsd,.{.base_address=&previous,.extent=128});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=rq,.extent=128});
    @load_to_dsr(sum_dst,mem);@load_to_dsr(sum_src,wire,.{.async=true,.activate=reduction_task,.ut_id=@get_ut_id(5)});
    @mov32(sum_dst,sum_src,.{.async=true});
  }
}
task reduced() void {
  for(@range(u16,128))|i|{partial[i]+=previous[i];}counters[2]+=1;ready();
}
task sent() void {
  if(gathering){counters[5]+=1;}else{counters[4]+=1;}sys.unblock_cmd_stream();
}
fn step(phase:u16,layer:u16,index:u16) void {
  if(identity[0]!=@as(u32,layer)){sys.unblock_cmd_stream();return;}
  if(phase==(if(kind==2) 7 else 3)){
    @assert(counters[0]==counters[4]);counters[0]+=1;gathering=false;
    const mem=@get_dsd(mem1d_dsd,.{.base_address=xp,.extent=96});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=96});
    @load_to_dsr(rx_dst,mem);@load_to_dsr(rx_src,wire,.{.async=true,.activate=input_task,.ut_id=@get_ut_id(3)});
    @mov32(rx_dst,rx_src,.{.async=true});
  }else if(phase==(if(kind==2) 8 else 4)){
    if(comptime last){
      if(identity[2]==@as(u32,index)){
        @assert(counters[4]==counters[5]+1);gathering=true;transmit(op,64,reply_oq);return;
      }
    }
    sys.unblock_cmd_stream();
  }else{sys.unblock_cmd_stream();}
}
comptime {
  @initialize_queue(iq,.{.color=@get_color(if(kind==2) 7 else 3)});
  @bind_local_task(received,input_task);@bind_local_task(sent,sent_task);
  if(!first){@initialize_queue(rq,.{.color=@get_color(if(parity==1) 4 else 5)});@bind_local_task(reduced,reduction_task);}
  if(!last){@initialize_queue(oq,.{.color=@get_color(if(parity==0) 4 else 5)});}
  if(last){@initialize_queue(reply_oq,.{.color=@get_color(if(kind==0) 6 else if(kind==1) 8 else 16)});}
  @export_symbol(ip,"identity");@export_symbol(cp,"counters");@export_symbol(wp,"weights");@export_symbol(bp,"bias");
  @export_symbol(xp,"input");@export_symbol(op,"output");@export_symbol(step);
}
