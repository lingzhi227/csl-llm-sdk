 @set_color_config(1,0,@get_color(5),.{.routes=.{.rx=.{SOUTH},.tx=.{RAMP}}});
 @set_color_config(1,1,@get_color(5),.{.routes=.{.rx=.{RAMP},.tx=.{NORTH}}});
