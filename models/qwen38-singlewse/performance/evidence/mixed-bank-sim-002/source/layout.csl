 @set_tile_code(1,2,"pe.csl",.{.memcpy_params=memcpy.get_params(1),.rank=5,.children=0,.subtree=1,.fp8_slots=112,.bf16_slots=12,.left_color=3,.right_color=4,.out_color=5,.left_iq=2,.right_iq=3,.tree_oq=2,.left_task=8,.right_task=9,.send_task=10,.left_dsr=3,.right_dsr=5,.send_dsr=6});
