// Synthetic producer cohort. Input and output have independent microthreads,
// allowing a later cohort to consume multicast while its return path is gated.
param memcpy_params;param group:u16;param first_frame:u16;
param total_frames:u16;param total_workers:u16;param segments:[total_workers]u16;
param input_color:u16;param output_color:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const ctrl=@import_module("<control>");const tile=@import_module("<tile_config>");
const iq=@get_input_queue(2);const oq=@get_output_queue(2);
const rs=@get_dsr(dsr_src0,3);const rd=@get_dsr(dsr_dest,3);const rt=@get_local_task_id(9);
const ds=@get_dsr(dsr_src0,2);const dd=@get_dsr(dsr_dest,2);const done=@get_local_task_id(8);
var wire=@zeros([1161]u32);var frame=@zeros([5]u32);var audit=@zeros([8]u32);
const wp:[*]u32=&wire;const ap:[*]u32=&audit;
var waiting:bool=false;var phase:u16=0;var receive_phase:u16=0;
var frames:u16=0;var next_marker:u16=0;var token:u32=0;
fn progress() void {
 if(phase==0 and receive_phase==0){audit[0]=1;audit[1]=frames;
  if(waiting){waiting=false;sys.unblock_cmd_stream();}}
}
fn receive(first:u16,length:u16) void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&wire[first]),.extent=1});
 const f=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=1});
 @load_to_dsr(rd,@set_dsd_length(m,length));
 @load_to_dsr(rs,@set_dsd_length(f,length),.{.async=true,.ut_id=@get_ut_id(3),.activate=rt});
 @mov32(rd,rs,.{.async=true});
}
fn emit_frame() void {
 phase=2;const index=first_frame+frames;
 frame[0]=token;frame[1]=@as(u32,group)*384+2*@as(u32,index);frame[2]=2;
 frame[3]=(token*104729)^@as(u32,index)^0x3f807e11;frame[4]=5;
 const m=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=5});
 const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=5});
 @load_to_dsr(ds,m);@load_to_dsr(dd,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=done});
 @mov32(dd,ds,.{.async=true});
}
task received() void {
 if(receive_phase==1){token=wire[0];receive_phase=2;receive(387,774);emit_frame();}
 else{@assert(receive_phase==2 and wire[387]==token and wire[774]==token);
  receive_phase=0;audit[2]=3;progress();}
}
task completed() void {
 if(phase==2){
  frames+=1;
  if(frames==next_marker){
   phase=3;tile.switch_config.clear_current_position(@get_color(output_color));
   frame[0]=ctrl.encode_payload(1,[1]ctrl.opcode{ctrl.opcode.SWITCH_ADV},[1]bool{false},false,@get_control_task_id(40));
   const m=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=1});
   const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=1,.control=true});
   @load_to_dsr(ds,m);@load_to_dsr(dd,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=done});
   @mov32(dd,ds,.{.async=true});
  }else{emit_frame();}
 }else{
  @assert(phase==3);audit[3]+=1;
  if(audit[3]<total_workers){next_marker+=segments[@as(u16,audit[3])];emit_frame();}
  else{@assert(frames==total_frames);phase=0;progress();}
 }
}
fn bridge_stream_arm(new_token:u32) void {
 @assert(phase==0 and receive_phase==0);phase=1;receive_phase=1;frames=0;next_marker=segments[0];
 for(@range(u16,8))|i|{audit[i]=0;}waiting=false;receive(0,387);sys.unblock_cmd_stream();
}
fn probe_send() void {sys.unblock_cmd_stream();}
fn probe_wait() void {waiting=true;progress();}
fn bridge_inspect() void {sys.unblock_cmd_stream();}
comptime {
 @initialize_queue(iq,.{.color=@get_color(input_color)});@initialize_queue(oq,.{.color=@get_color(output_color)});
 @bind_local_task(received,rt);@bind_local_task(completed,done);
 @export_symbol(wp,"wire");@export_symbol(ap,"probe_audit");
 @export_symbol(bridge_stream_arm);@export_symbol(probe_send);@export_symbol(probe_wait);@export_symbol(bridge_inspect);
}
