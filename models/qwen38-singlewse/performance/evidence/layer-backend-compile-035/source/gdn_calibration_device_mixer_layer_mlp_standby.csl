param control_reply_rx:direction;param control_reply_tx:direction;
// Preserve the original mixer/state resident bank in this MLP-only component.
// No mixer operation is executed; it is not a full-layer acceptance artifact.
param memcpy_params;param bank_words:u16;
const sys=@import_module("device_control.csl",.{.command_task=@get_local_task_id(24),.routed=true,.reply_rx=control_reply_rx,.reply_tx=control_reply_tx,.forward_host_commands=true});
var bank=@zeros([if(bank_words>0) bank_words else 1]u32);var audit=@zeros([4]u32);var setup=@zeros([5]u16);
const bp:[*]u32=&bank;const ap:[*]u32=&audit;const sp:[*]u16=&setup;
fn arm(epoch:u32) void {@assert(mixer.drained() and mixer_status[2]==0);audit[0]=epoch;sys.unblock_cmd_stream();}
fn start() void {gdn_reset();gdn_admit();sys.unblock_cmd_stream();}
fn finish() void {sys.unblock_cmd_stream();}
comptime {}

// Composition port: the future conv/gate/residual consumer receives this local
// root notification. Until connected, root data stays leased for explicit
// consume; no synthetic neural result or fake automatic completion is emitted.
param mixer_rank_parity:u16;param mixer_input48_queue:u16;param mixer_can_root:bool;
const mrt=@get_local_task_id(25);const mdt=@get_local_task_id(26);
const mixer=@import_module("mixer_projection.csl",.{.rank_parity=mixer_rank_parity,.bank_words=bank_words,
 .input48_queue=mixer_input48_queue,.can_root=mixer_can_root,.root_ready_task=mrt,.drained_task=mdt});
var mixer_status=@zeros([4]u32);const msp:[*]u32=&mixer_status;
const msetup:[*]u16=mixer.setup_pointer;const maudit:[*]u32=mixer.audit_pointer;
const mout:[*]u32=mixer.root_output;
task mixer_root_ready() void {
 @assert(mixer_status[2]==0);mixer_status[0]=mout[0];mixer_status[1]=mout[1];mixer_status[2]=1;
}
task mixer_drained() void {mixer_status[3]+=1;}
fn mixer_begin(request:u32,generation:u32,projection:u16) void {
 
 @assert(mixer_status[2]==0);mixer.begin(bp,request,generation,projection);sys.unblock_cmd_stream();
}
fn mixer_consume(generation:u32,row:u16) void {
 @assert(mixer_status[2]==1);mixer_status[2]=0;mixer.root_consumed(generation,row);sys.unblock_cmd_stream();
}
comptime {
 @bind_local_task(mixer_root_ready,mrt);@bind_local_task(mixer_drained,mdt);
 
 
 
}

// Segment IDs are a device ABI, never arbitrary host-provided pointers.
const device_task=@get_local_task_id(24);
fn device_transfer() void {
 const c=sys.command;const segment=c[2];
 @assert(c[4]>0 and c[4]<=256 and c[3]<65536 and c[3]+c[4]<65536);
 const first=@as(u16,c[3]);const length=@as(u16,c[4]);
 var pointer:[*]u32=bp;var half:[*]u16=msetup;var extent:u16=0;var bits:u16=32;var writable:bool=false;
 if(segment==0){pointer=bp;extent=bank_words;writable=true;}
 else if(segment==1){half=msetup;extent=46;bits=16;writable=true;}
 else if(segment==2){pointer=maudit;extent=6;}
 else if(segment==3){pointer=msp;extent=4;}
 else if(segment==4){pointer=mout;extent=5;}
 else if(segment==8){pointer=ap;extent=4;}
 else{@assert(false);}
 @assert(first+length<=extent);
 if(c[1]==0){
  @assert(writable and mixer.drained() and mixer_status[2]==0);
  if(bits==32){sys.write32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{sys.write16(@ptrcast([*]u16,&half[@as(u16,first)]),@as(u16,length));}
 }else{
  @assert(c[1]==1);
  if(bits==32){sys.read32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{if(comptime sys.routed){@assert(first%2==0 and length%2==0);}sys.read16(@ptrcast([*]u16,&half[first]),length);}
 }
}
task device_command() void {
 const c=sys.command;
 if(c[1]<2){device_transfer();}
 else if(c[1]==2){arm(c[2]);}
 else if(c[1]==3){start();}
 else if(c[1]==4){finish();}
 else if(c[1]==5){@assert(c[4]<5);mixer_begin(c[2],c[3],@as(u16,c[4]));}
 else if(c[1]==6){@assert(c[3]<65536);mixer_consume(c[2],@as(u16,c[3]));}
 else{@assert(false);}
}
comptime {@bind_local_task(device_command,device_task);}

// One credited state worker. Input is387 words: [token,decay,beta,V128,K128,Q128].
// V is copied locally, then K/Q reuse the512B projection decoder. Returned
// frames are [token,global_value_row,1,BF16,5]. Full downstream retirement is
// owned by the frontend, not this worker's final local DMA callback.
param gdn_columns:u16;param gdn_first:u16;param gdn_head:u16;
param gdn_state_word:u16;param gdn_input_color:u16;param gdn_output_color:u16;
param gdn_input_queue:u16;
const gdn_math=@import_module("gdn_columns.csl",.{.columns=gdn_columns});
const gdn_round=@import_module("qwen_math.csl");
inline fn gdn_state() [*]f32 {return @ptrcast([*]f32,&bank[gdn_state_word]);}
inline fn gdn_workspace() [*]f32 {return @ptrcast([*]f32,&mixer.native.decoded);}
inline fn gdn_values() [*]f32 {return @ptrcast([*]f32,&mixer.native.encoded);}
const gdn_iq=@get_input_queue(gdn_input_queue);const gdn_oq=@get_output_queue(6);
const gdn_ds=@get_dsr(dsr_src0,5);const gdn_dd=@get_dsr(dsr_dest,5);
const gdn_task=@get_local_task_id(10);
var gdn_header=@zeros([3]u32);var gdn_invocation:u32=0;
var gdn_phase:u16=0;var gdn_output:u16=0;
fn gdn_local_idle() bool {return gdn_phase==0;}
fn gdn_receive(address:[*]u32,length:u16) void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=address,.extent=1});
 const f=@get_dsd(fabin_dsd,.{.input_queue=gdn_iq,.extent=1});
 @load_to_dsr(gdn_dd,@set_dsd_length(m,length));
 @load_to_dsr(gdn_ds,@set_dsd_length(f,length),.{.async=true,.ut_id=@get_ut_id(7),.activate=gdn_task});
 @mov32(gdn_dd,gdn_ds,.{.async=true});
}
fn gdn_admit() void {
 @assert(gdn_local_idle());@assert(mixer.drained() and mixer_status[2]==0);
 gdn_phase=1;gdn_receive(&gdn_header,3);
}
fn gdn_reset() void {
 @assert(gdn_local_idle());@assert(mixer.drained() and mixer_status[2]==0);
 const all=@get_dsd(mem1d_dsd,.{.base_address=gdn_state(),.extent=128*gdn_columns});
 @fmovs(all,0.0);gdn_invocation=0;
}
fn gdn_send() void {
 const frame=@ptrcast([*]u32,gdn_workspace());const values=gdn_values();
 frame[0]=gdn_invocation;frame[1]=@as(u32,gdn_head*128+gdn_first+gdn_output);
 frame[2]=1;frame[3]=@as(u32,gdn_round.round(values[gdn_output]));frame[4]=5;
 const m=@get_dsd(mem1d_dsd,.{.base_address=frame,.extent=5});
 const f=@get_dsd(fabout_dsd,.{.output_queue=gdn_oq,.extent=5});
 @load_to_dsr(gdn_ds,m);@load_to_dsr(gdn_dd,f,.{.async=true,.ut_id=@get_ut_id(7),.activate=gdn_task});
 @mov32(gdn_dd,gdn_ds,.{.async=true});
}
task gdn_completed() void {
 const workspace=gdn_workspace();const values=gdn_values();
 if(gdn_phase==1){
  @assert(gdn_header[0]>gdn_invocation);gdn_invocation=gdn_header[0];
 }else if(gdn_phase==2){
  const src=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&workspace[gdn_first]),.extent=gdn_columns});
  const dst=@get_dsd(mem1d_dsd,.{.base_address=values,.extent=gdn_columns});@fmovs(dst,src);
 }else if(gdn_phase==3){
  gdn_math.key(gdn_state(),workspace,values,@bitcast(f32,gdn_header[1]),@bitcast(f32,gdn_header[2]));
 }else if(gdn_phase==4){
  gdn_math.reduce(gdn_state(),workspace,values);gdn_phase=5;gdn_output=0;gdn_send();return;
 }else{
  @assert(gdn_phase==5);gdn_output+=1;
  if(gdn_output<gdn_columns){gdn_send();}else{gdn_phase=0;}return;
 }
 gdn_phase+=1;gdn_receive(@ptrcast([*]u32,workspace),128);
}
comptime {
 @comptime_assert(gdn_head<48 and gdn_first+gdn_columns<=128);
 @comptime_assert(@as(u32,gdn_state_word)+128*@as(u32,gdn_columns)<=@as(u32,bank_words));
 @initialize_queue(gdn_iq,.{.color=@get_color(gdn_input_color)});
 @initialize_queue(gdn_oq,.{.color=@get_color(gdn_output_color)});
 @bind_local_task(gdn_completed,gdn_task);
}

comptime {}
