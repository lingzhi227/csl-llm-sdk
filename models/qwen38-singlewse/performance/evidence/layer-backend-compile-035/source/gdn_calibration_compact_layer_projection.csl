// Real retained-input native row loop plus complete-K arrival-driven reduction.
// The root emits rounded original BF16 projection values directly to its next
// consumer. Every worker waits for local send and the consumer's group credit.
// Ingress distribution, root->consumer routes and credit fanout are supplied by
// the layer fabric; a selected-role compile alone does not connect this graph.
param memcpy_params;param rows:u16;param columns:u16;param branches:u16;
param max_parts:u16;param bank_words:u16;param root:bool;
param children:u16;param subtree_k:u16;param left_k:u16;param right_k:u16;
param left_color:u16;param right_color:u16;param out_color:u16;
// Optional static P25 root transports. The prefix of a split group goes to
// the preceding actor; all remaining rows go to this root's own actor.
param fused_root:bool=false;param boundary_rows:u16=0;
param boundary_out_color:u16=0;param main_credit_color:u16=18;
param boundary_credit_color:u16=1;
param mlp_component:bool=false;
param shared_inputs:bool=false;
param copy_transport:bool=false;param tagged_input:bool=false;
param bus_rx:direction=WEST;param bus_tx:direction=EAST;
param mlp_sender:bool=false;param sender_id:u16=0;param input_quantizer:bool=false;param input_group:u16=0;
param output_sink:bool=false;param sink_color:u16=0;param sink_index:u16=0;param sink_first:u16=0;param sink_rows:u16=4;
param fusion_actor:bool=false;param actor_main_color:u16=0;param actor_suffix_color:u16=1;
param actor_main_credit_color:u16=0;param actor_suffix_credit_color:u16=1;
param actor_has_suffix:bool=false;param actor_first_output:u16=0;param actor_output_rows:u16=128;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const native=@import_module("compact_layer_native.csl",.{.rows=rows,.columns=columns,.branches=branches,.max_parts=max_parts,.direct_single=true,.require_consumer_credit=!copy_transport});
const math=@import_module("qwen_math.csl");
const partials:u16=rows*branches;const reduction_words:u16=partials+3;
const output_words:u16=if(root) partials/2+3 else reduction_words;
const input_words:u16=if(tagged_input) columns+5 else columns/2+3;
var bank=@zeros([bank_words]u32);var credit=@zeros([2]u32);
// The native decoder's512B arena is dead after compute and before the next
// output is released. Operand ingress, decoded weights and reduction packets
// are disjoint phases. Child receives are armed only after native.compute.
// Epoch, captured input slices, released output rows, terminal flag.
var audit=@zeros([4]u32);
var setup=@zeros([5]u16);
const bp:[*]u32=&bank;const ap:[*]u32=&audit;const sp:[*]u16=&setup;
const iq=@get_input_queue(2);const lq=@get_input_queue(3);const rq=@get_input_queue(4);const cq=@get_input_queue(5);const oq=@get_output_queue(2);
const bcq=@get_input_queue(6);const boq=@get_output_queue(3);const coq=@get_output_queue(4);
const id=@get_dsr(dsr_dest,2);const is=@get_dsr(dsr_src0,2);
const ld=@get_dsr(dsr_dest,3);const ls=@get_dsr(dsr_src0,3);
const cd=@get_dsr(dsr_dest,1);const cs=@get_dsr(dsr_src0,1);
const od=@get_dsr(dsr_dest,6);const os=@get_dsr(dsr_src0,6);
const fd=@get_dsr(dsr_dest,5);const fs=@get_dsr(dsr_src0,5);
const it=@get_local_task_id(8);const lt=@get_local_task_id(9);
const ot=@get_local_task_id(11);const ct=@get_local_task_id(12);
const ft=@get_local_task_id(13);
const at=@get_local_task_id(17);
const actor=@import_module("layer_fusion_transport.csl",.{.enabled=fusion_actor,.copy_transport=copy_transport,.use_silu_lut=mlp_component,
 .main_color=actor_main_color,.suffix_color=actor_suffix_color,.main_credit_color=actor_main_credit_color,
 .suffix_credit_color=actor_suffix_credit_color,.has_suffix=actor_has_suffix,
 .first_output=actor_first_output,.output_rows=actor_output_rows,.ready_task=at,
});
const sender=@import_module("layer_mlp_sender.csl",.{.enabled=mlp_sender,.drained_task=ft,.bus_rx=bus_rx,.bus_tx=bus_tx,.actor=actor,.fusion_actor=fusion_actor,
 .sender_id=sender_id,.input_quantizer=input_quantizer,.input_group=input_group,.output_sink=output_sink,
 .sink_color=sink_color,.sink_index=sink_index,.sink_first=sink_first,.sink_rows=sink_rows});
const nip:[*]u16=&native.inputs;const nsp:[*]f32=&native.scales;
const qp:[*]u32=sender.input;const sa:[*]u32=sender.status_pointer;const sl:[*]u16=actor.ingress.lut_pointer;
var finish_requested:bool=false;
var fusion_signal=@zeros([2]u32);const fp:[*]u32=&fusion_signal;
var running:bool=false;var joined:bool=false;
var child_index:u16=0;var contributors:u32=0;
var epoch:u32=0;var row:u16=0;var output_start:u16=0;var captured:u16=0;

fn receive_operand() void {
 const operand=@ptrcast([*]u32,&native.decoded);
 const length:u16=if(gdn_phase==1) 3 else if(gdn_phase>1) 128 else input_words;
 const m0=@get_dsd(mem1d_dsd,.{.base_address=operand,.extent=1});const m=@set_dsd_length(m0,length);
 const f0=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=1});const f=@set_dsd_length(f0,length);
 const g0=@get_dsd(fabin_dsd,.{.input_queue=gdn_iq,.extent=1});const g=@set_dsd_length(g0,length);
 @load_to_dsr(id,m);
 if(gdn_phase>0){@load_to_dsr(is,g,.{.async=true,.ut_id=@get_ut_id(2),.activate=it});}
 else{@load_to_dsr(is,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=it});}
 @mov32(id,is,.{.async=true});
}
fn emit_result() void {
 const outgoing=@ptrcast([*]u32,&native.decoded);
 @assert(!joined and child_index==children and contributors==@as(u32,subtree_k));joined=true;
 const total=@get_dsd(mem1d_dsd,.{.base_address=native.result,.extent=partials});
 outgoing[0]=epoch;outgoing[1]=@as(u32,row);
 if(comptime root){
  // Full-K FP32 -> original ties-to-even BF16 -> branch-major packed pairs.
  outgoing[2]=@as(u32,output_start+row*rows);
  const packed_out=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u16,&outgoing[3]),.extent=partials});
  @map(math.round,total,packed_out);
 }else{
  outgoing[2]=contributors;
  const dest=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&outgoing[3]),.extent=partials});@fmovs(dest,total);
 }
 send_result_frame();
}
fn send_result_frame() void {
 const outgoing=@ptrcast([*]u32,&native.decoded);
 const m0=@get_dsd(mem1d_dsd,.{.base_address=outgoing,.extent=output_words});const m=if(gdn_phase==5) @set_dsd_length(m0,5) else m0;
 const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=output_words});
 @load_to_dsr(os,m);
 if(gdn_phase==5){
  const g=@get_dsd(fabout_dsd,.{.output_queue=gdn_oq,.extent=5});
  @load_to_dsr(od,g,.{.async=true,.ut_id=@get_ut_id(5),.activate=ot});
 }else if(comptime fused_root and boundary_rows>0){
  const bf=@get_dsd(fabout_dsd,.{.output_queue=boq,.extent=output_words});
  if(row<boundary_rows){@load_to_dsr(od,bf,.{.async=true,.ut_id=@get_ut_id(5),.activate=ot});}
  else{@load_to_dsr(od,f,.{.async=true,.ut_id=@get_ut_id(5),.activate=ot});}
 }else{@load_to_dsr(od,f,.{.async=true,.ut_id=@get_ut_id(5),.activate=ot});}
 @mov32(od,os,.{.async=true});
}
fn receive_child() void {
 @assert(child_index<children);
 const memory=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&native.decoded),.extent=reduction_words});
 const lf=@get_dsd(fabin_dsd,.{.input_queue=lq,.extent=reduction_words});
 const rf=@get_dsd(fabin_dsd,.{.input_queue=rq,.extent=reduction_words});
 @load_to_dsr(ld,memory);
 if(child_index==0){@load_to_dsr(ls,lf,.{.async=true,.ut_id=@get_ut_id(3),.activate=lt});}
 else{@load_to_dsr(ls,rf,.{.async=true,.ut_id=@get_ut_id(3),.activate=lt});}
 @mov32(ld,ls,.{.async=true});
}
fn begin_row() void {
 joined=false;child_index=0;contributors=@as(u32,native.parts);
 native.compute(bp,bank_words);
 if(comptime !copy_transport){
 const cm=@get_dsd(mem1d_dsd,.{.base_address=&credit,.extent=2});const cf=@get_dsd(fabin_dsd,.{.input_queue=cq,.extent=2});
 @load_to_dsr(cd,cm);
 if(comptime fused_root and boundary_rows>0){
  const bcf=@get_dsd(fabin_dsd,.{.input_queue=bcq,.extent=2});
  if(row<boundary_rows){@load_to_dsr(cs,bcf,.{.async=true,.ut_id=@get_ut_id(6),.activate=ct});}
  else{@load_to_dsr(cs,cf,.{.async=true,.ut_id=@get_ut_id(6),.activate=ct});}
 }else{@load_to_dsr(cs,cf,.{.async=true,.ut_id=@get_ut_id(6),.activate=ct});}
 @mov32(cd,cs,.{.async=true});
 }
 if(comptime children>0){receive_child();}else{emit_result();}
}
fn advance_if_released() void {
 if(!native.pending){
  @assert(native.iteration==row+1);row+=1;audit[2]=@as(u32,row);
  if(native.done()){running=false;audit[3]=1;if(comptime mlp_component){finish_if_drained();}}else{begin_row();}
 }
}
task operand_arrived() void {
 if(gdn_phase>0){gdn_completed();return;}
 const operand=@ptrcast([*]u32,&native.decoded);
 if(comptime tagged_input){
  const observed=(operand[0]&65535)|((operand[1]&65535)<<16);
  // Shared full/tail wire uses tail-part header; a single-slice owner stores part0.
  const part:u32=if(shared_inputs and max_parts==1) 0 else operand[2]&65535;
  const scale=(operand[3+columns]&65535)|((operand[4+columns]&65535)<<16);
  // Forward overlapping compaction: destination precedes every unread source.
  const src=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u16,&operand[3]),.extent=columns,.stride=2});
  const dst=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u16,&operand[2]),.extent=columns});@mov16(dst,src);
  operand[0]=observed;operand[1]=part;operand[2+columns/2]=scale;
 }
 @assert(running and row==0 and operand[0]==epoch);
 const part=@as(u16,operand[1]);@assert(operand[1]==@as(u32,part));
 native.capture(epoch,part,@ptrcast([*]u32,&operand[2]));captured+=1;audit[1]+=1;
 if(captured==native.parts){
  if(comptime fusion_actor){actor.begin(epoch);}
  begin_row();
 }else{receive_operand();}
}
task child_arrived() void {
 @assert(child_index<children and !joined);
 const incoming=@ptrcast([*]u32,&native.decoded);
 const expected:u16=if(child_index==0) left_k else right_k;
 @assert(incoming[0]==epoch and incoming[1]==@as(u32,row) and incoming[2]==@as(u32,expected));
 const total=@get_dsd(mem1d_dsd,.{.base_address=native.result,.extent=partials});
 const term=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&incoming[3]),.extent=partials});
 @fadds(total,total,term);contributors+=incoming[2];child_index+=1;
 if(child_index==children){emit_result();}else{receive_child();}
}
task sent() void {if(gdn_phase==5){gdn_return_sent();return;}native.send_completed(epoch,row);advance_if_released();}
task consumed() void {
 @assert(credit[0]==epoch and credit[1]==@as(u32,row));
 if(comptime fused_root){
  // The credit buffer stays leased until its multicast send completes. The
  // root cannot start another row/receive and overwrite it before this event.
  const m=@get_dsd(mem1d_dsd,.{.base_address=&credit,.extent=2});
  const f=@get_dsd(fabout_dsd,.{.output_queue=coq,.extent=2});
  @load_to_dsr(fs,m);@load_to_dsr(fd,f,.{.async=true,.ut_id=@get_ut_id(4),.activate=ft});@mov32(fd,fs,.{.async=true});
 }else{native.consumer_credit(epoch,row);advance_if_released();}
}
task credit_forwarded() void {native.consumer_credit(epoch,row);advance_if_released();}
// This ready endpoint is exposed for composition with the actual down-input
// distributor. No downstream network is supplied by this compile-admission core.
task fusion_ready() void {
 if(comptime mlp_sender){sender.pump();}
 else{fusion_signal[0]=@as(u32,actor.ingress.current);fusion_signal[1]=1;}
}
fn fusion_step(op:u16,new_epoch:u32,group:u16,fragment:u16) void {
 if(comptime fusion_actor){
  if(op==0){@assert(fusion_signal[1]==1);fusion_signal[1]=0;actor.prepare_fragment();}
  else if(op==1){actor.sent(new_epoch,group,fragment);}
  else if(op==2){actor.consumed(new_epoch,group,fragment);}
  else{@assert(false);}
 }else{@assert(false);}
 sys.unblock_cmd_stream();
}
fn finish_if_drained() void {
 if(!finish_requested or running){return;}
 if(comptime mlp_sender){if(!sender.drained()){return;}}
 finish_requested=false;sys.unblock_cmd_stream();
}
task sender_drained() void {finish_if_drained();}
fn start() void {gdn_reset();gdn_admit();sys.unblock_cmd_stream();}
fn finish() void {@assert(!finish_requested and epoch>0);finish_requested=true;finish_if_drained();}
fn arm(new_epoch:u32) void {
 @assert(gdn_local_idle() and !running);if(comptime mlp_sender){@assert(epoch==0 or sender.drained());sender.begin(new_epoch);}
 if(comptime fusion_actor){@assert(actor.drained());}
 native.configure(new_epoch,setup[0],setup[1],setup[2],setup[3],setup[4]);
 @assert(setup[4]+setup[1]*rows>=setup[4]);
 running=true;epoch=new_epoch;row=0;output_start=setup[4];captured=0;
 for(@range(u16,4))|i|{audit[i]=0;}audit[0]=new_epoch;receive_operand();sys.unblock_cmd_stream();
}
comptime {
 @comptime_assert(children<=2 and subtree_k>0 and (branches==1 or branches==2));
 @comptime_assert(!root or children>0);
 @comptime_assert(reduction_words*4<=512 and output_words*4<=512 and input_words*4<=512);
 @comptime_assert(!fused_root or root);
 @comptime_assert(!fusion_actor or !root);
 @comptime_assert(!mlp_sender or (copy_transport and !root));
 @initialize_queue(iq,.{.color=@get_color(2)});
 if(!copy_transport){@initialize_queue(cq,.{.color=@get_color(main_credit_color)});@bind_local_task(consumed,ct);}
 if(fused_root){
  if(!copy_transport){@initialize_queue(coq,.{.color=@get_color(18)});@bind_local_task(credit_forwarded,ft);}
  if(boundary_rows>0){
   if(!copy_transport){@initialize_queue(bcq,.{.color=@get_color(boundary_credit_color)});}
   @initialize_queue(boq,.{.color=@get_color(boundary_out_color)});
  }
 }
 @initialize_queue(oq,.{.color=@get_color(out_color)});
 if(children>0){@initialize_queue(lq,.{.color=@get_color(left_color)});@bind_local_task(child_arrived,lt);}
 if(children>1){@initialize_queue(rq,.{.color=@get_color(right_color)});}
 @bind_local_task(operand_arrived,it);@bind_local_task(sent,ot);
 if(fusion_actor){@bind_local_task(fusion_ready,at);}
 @export_symbol(bp,"bank");@export_symbol(ap,"audit");@export_symbol(sp,"setup");@export_symbol(arm);
 if(mlp_sender){@export_symbol(qp,"quant_input");@export_symbol(sa,"sender_status");}
 if(mlp_component){
  @comptime_assert(copy_transport);@export_symbol(start);@export_symbol(finish);
  @export_symbol(nip,"native_input");@export_symbol(nsp,"native_scales");
  if(mlp_sender){@bind_local_task(sender_drained,ft);}
  if(fusion_actor){@export_symbol(sl,"silu_lut");}
 }
 @export_symbol(fp,"fusion_signal");@export_symbol(fusion_step);
}

// One credited state worker. Input is387 words: [token,decay,beta,V128,K128,Q128].
// V is copied locally, then K/Q reuse the512B projection decoder. Returned
// frames are [token,global_value_row,1,BF16,5]. Full downstream retirement is
// owned by the frontend, not this worker's final local DMA callback.
param gdn_columns:u16;param gdn_first:u16;param gdn_head:u16;
param gdn_state_word:u16;param gdn_input_color:u16;param gdn_output_color:u16;
param gdn_input_queue:u16;
const gdn_math=@import_module("gdn_columns.csl",.{.columns=gdn_columns});
const gdn_round=@import_module("qwen_math.csl");
inline fn gdn_state() [*]f32 {return @ptrcast([*]f32,&bank[gdn_state_word]);}
inline fn gdn_workspace() [*]f32 {return @ptrcast([*]f32,&native.decoded);}
inline fn gdn_values() [*]f32 {return @ptrcast([*]f32,&native.inputs);}
const gdn_iq=@get_input_queue(gdn_input_queue);const gdn_oq=@get_output_queue(6);
var gdn_header=@zeros([3]u32);var gdn_invocation:u32=0;
var gdn_phase:u16=0;var gdn_output:u16=0;
fn gdn_local_idle() bool {return gdn_phase==0;}
fn gdn_admit() void {
 @assert(gdn_local_idle());@assert(!running and !finish_requested);
 gdn_phase=1;receive_operand();
}
fn gdn_reset() void {
 @assert(gdn_local_idle());@assert(!running and !finish_requested);
 const all=@get_dsd(mem1d_dsd,.{.base_address=gdn_state(),.extent=128*gdn_columns});
 @fmovs(all,0.0);gdn_invocation=0;
}
fn gdn_send() void {
 const frame=@ptrcast([*]u32,gdn_workspace());const values=gdn_values();
 frame[0]=gdn_invocation;frame[1]=@as(u32,gdn_head*128+gdn_first+gdn_output);
 frame[2]=1;frame[3]=@as(u32,gdn_round.round(values[gdn_output]));frame[4]=5;
 send_result_frame();
}
fn gdn_completed() void {
 const workspace=gdn_workspace();const values=gdn_values();
 if(gdn_phase==1){
  const words=@ptrcast([*]u32,workspace);gdn_header[0]=words[0];gdn_header[1]=words[1];gdn_header[2]=words[2];
  @assert(gdn_header[0]>gdn_invocation);gdn_invocation=gdn_header[0];
 }else if(gdn_phase==2){
  const src=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&workspace[gdn_first]),.extent=gdn_columns});
  const dst=@get_dsd(mem1d_dsd,.{.base_address=values,.extent=gdn_columns});@fmovs(dst,src);
 }else if(gdn_phase==3){
  gdn_math.key(gdn_state(),workspace,values,@bitcast(f32,gdn_header[1]),@bitcast(f32,gdn_header[2]));
 }else if(gdn_phase==4){
  gdn_math.reduce(gdn_state(),workspace,values);gdn_phase=5;gdn_output=0;gdn_send();return;
 }else{@assert(false);}
 gdn_phase+=1;receive_operand();
}
fn gdn_return_sent() void {
 if(comptime gdn_columns==1){gdn_phase=0;}
 else{gdn_output+=1;if(gdn_output<gdn_columns){gdn_send();}else{gdn_phase=0;}}
}
comptime {
 @comptime_assert(gdn_head<48 and gdn_first+gdn_columns<=128);
 @comptime_assert(@as(u32,gdn_state_word)+128*@as(u32,gdn_columns)<=@as(u32,bank_words));
 @initialize_queue(gdn_iq,.{.color=@get_color(gdn_input_color)});
 @initialize_queue(gdn_oq,.{.color=@get_color(gdn_output_color)});
}

comptime {@comptime_assert(!fusion_actor and !mlp_sender and gdn_columns*2<=max_parts*columns);}
