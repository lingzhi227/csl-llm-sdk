param memcpy_params;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var operand40=@zeros([133]u32);var operand48=@zeros([133]u32);var observed=@zeros([2]u32);
var cursor40:u16=0;var cursor48:u16=0;
const p40:[*]u32=&operand40;const p48:[*]u32=&operand48;const counts:[*]u32=&observed;
task receive40(value:u32) void {operand40[cursor40]=value;cursor40+=1;if(cursor40==133){cursor40=0;observed[0]+=1;}}
task receive48(value:u32) void {operand48[cursor48]=value;cursor48+=1;if(cursor48==133){cursor48=0;observed[1]+=1;}}
comptime {
 @initialize_queue(@get_input_queue(2),.{.color=@get_color(16)});@bind_data_task(receive40,@get_data_task_id(@get_input_queue(2)));
 @initialize_queue(@get_input_queue(3),.{.color=@get_color(17)});@bind_data_task(receive48,@get_data_task_id(@get_input_queue(3)));
 @export_symbol(p40,"operand40");@export_symbol(p48,"operand48");@export_symbol(counts,"operand_counts");
}
var sentinel=@zeros([2]u32);const sp:[*]u32=&sentinel;
comptime {@export_symbol(sp,"sentinel");}
