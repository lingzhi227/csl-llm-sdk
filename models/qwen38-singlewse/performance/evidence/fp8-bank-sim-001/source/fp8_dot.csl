// Ordered 128-term mixed FP16/FP32 dot; caller owns DSR4 and decoded buffers.
// Weights and input are exact E4M3FN/256 half values, finite; rescale before scales.
param rows:u16;
comptime {@comptime_assert(rows>0 and rows<=16);}
const yd=@get_dsr(dsr_dest,4);const ys=@get_dsr(dsr_src0,4);const ws=@get_dsr(dsr_src1,4);
fn step(value:f16) void {@fmachs(yd,ys,ws,value);}
fn compute(weight:[*]u16,input:[*]u16,output:[*]f32,activation_scale:f32,weight_scale:f32) void {
  const out=@get_dsd(mem1d_dsd,.{.base_address=output,.extent=rows});
  const w=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f16,weight),.extent=rows});
  const x=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f16,input),.extent=128});
  @fmovs(out,0.0);@load_to_dsr(yd,out,.{.save_address=false});@load_to_dsr(ys,out,.{.save_address=false});
  @load_to_dsr(ws,w,.{.save_address=true});@map(step,x);
  for(@range(u16,rows))|i|{output[i]=((output[i]*65536.0)*activation_scale)*weight_scale;}
}
