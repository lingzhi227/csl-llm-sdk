// Full128-key, variable-width FP32 state. No cross-PE key reduction.
// Delta starts from V and accumulates negative state*K products, avoiding a
// second value-width temporary. This reassociation needs its own numerical
// bound; it is not claimed bit-identical to subtracting a completed dot product.
// Exclusive synchronous DSR4/7 math; the caller owns all scratch leases.
param columns:u16;
const yd=@get_dsr(dsr_dest,4);const ys=@get_dsr(dsr_src0,4);const ws=@get_dsr(dsr_src1,4);
const md=@get_dsr(dsr_dest,7);const ms=@get_dsr(dsr_src0,7);const ds=@get_dsr(dsr_src1,7);
fn subtract(value:f32) void {@fmacs(yd,ys,ws,-value);}
fn accumulate(value:f32) void {@fmacs(yd,ys,ws,value);}
fn correct(value:f32) void {@fmacs(md,ms,ds,value);}
fn reduce(state:[*]f32,vector:[*]f32,result:[*]f32) void {
 const out=@get_dsd(mem1d_dsd,.{.base_address=result,.extent=columns});
 const row=@get_dsd(mem1d_dsd,.{.base_address=state,.extent=columns});
 const input=@get_dsd(mem1d_dsd,.{.base_address=vector,.extent=128});
 @fmovs(out,0.0);@load_to_dsr(yd,out,.{.save_address=false});@load_to_dsr(ys,out,.{.save_address=false});
 @load_to_dsr(ws,row,.{.save_address=true});@map(accumulate,input);
}
fn key(state:[*]f32,vector:[*]f32,values:[*]f32,decay:f32,beta:f32) void {
 const all=@get_dsd(mem1d_dsd,.{.base_address=state,.extent=128*columns});
 const input=@get_dsd(mem1d_dsd,.{.base_address=vector,.extent=128});
 const row=@get_dsd(mem1d_dsd,.{.base_address=state,.extent=columns});
 const out=@get_dsd(mem1d_dsd,.{.base_address=values,.extent=columns});
 @fmuls(all,all,decay);
 @load_to_dsr(yd,out,.{.save_address=false});@load_to_dsr(ys,out,.{.save_address=false});
 @load_to_dsr(ws,row,.{.save_address=true});@map(subtract,input);
 @fmuls(out,out,beta);
 @load_to_dsr(md,row,.{.save_address=true});@load_to_dsr(ms,row,.{.save_address=true});
 @load_to_dsr(ds,out,.{.save_address=false});@map(correct,input);
}
comptime {@comptime_assert(columns>0 and columns<=64);}
