// Original spectator storage remains present outside this MLP's active actors.
param memcpy_params;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var bank=@zeros([8814]u32);var audit=@zeros([8]u32);
const bp:[*]u32=&bank;const ap:[*]u32=&audit;
fn arm(layer:u16) void {@assert(layer<64);audit[0]=1;audit[7]=0;sys.unblock_cmd_stream();}
fn start() void {audit[7]=1;sys.unblock_cmd_stream();}
comptime {@export_symbol(bp,"bank");@export_symbol(ap,"audit");@export_symbol(arm);@export_symbol(start);}
