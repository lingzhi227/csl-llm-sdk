// One atlas32x32 FP32 state shard co-resident with111 original FP8 tiles.
param memcpy_params;param key_shard:u16;param value_shard:u16;param fp8_slots:u16;
param request_color:u16;param delta_color:u16;param chain_in:u16;param chain_out:u16;param result_color:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const recurrent=@import_module("gdn_shard32.csl");const unpacker=@import_module("fp8_unpack.csl",.{.max_pairs=128});const fp8=@import_module("fp8_dot.csl",.{.rows=2});
var weights=@zeros([fp8_slots*128]u16);var scale=@zeros([fp8_slots]f32);var decoded=@zeros([256]u16);
var state=@zeros([1024]f32);var dot_input=@zeros([65]u32);var dot_output=@zeros([2]f32);
var request=@zeros([387]u32);var local_value=@zeros([32]f32);var delta=@zeros([32]f32);
var child=@zeros([35]u32);var aggregate=@zeros([35]u32);var audit=@zeros([8]u32);
const wp:[*]u16=&weights;const scp:[*]f32=&scale;const sp:[*]f32=&state;const dip:[*]u32=&dot_input;const dop:[*]f32=&dot_output;const ap:[*]u32=&audit;
const qp:[*]f32=@ptrcast([*]f32,&request[1]);const kp:[*]f32=@ptrcast([*]f32,&request[129]);
const lp:[*]f32=&local_value;const dp:[*]f32=&delta;
const qi=@get_input_queue(2);const qr=@get_input_queue(4);const qd=@get_input_queue(5);
const qo=@get_output_queue(2);const qb=@get_output_queue(3);
const reqd=@get_dsr(dsr_dest,2);const reqs=@get_dsr(dsr_src0,2);const cd=@get_dsr(dsr_dest,3);const cs=@get_dsr(dsr_src0,3);
const dd=@get_dsr(dsr_dest,5);const ds=@get_dsr(dsr_src0,5);const sd=@get_dsr(dsr_dest,6);const ss=@get_dsr(dsr_src0,6);
const rt=@get_local_task_id(8);const ct=@get_local_task_id(9);const dt=@get_local_task_id(10);const st=@get_local_task_id(11);
var running:bool=false;var local_ready:bool=false;var child_ready:bool=false;var joined:bool=false;var delta_sent:bool=false;var result_ready:bool=false;
var phase:u16=0;var sending:u16=0;var remaining:u16=0;
fn arm_request() void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=&request,.extent=387});const f=@get_dsd(fabin_dsd,.{.input_queue=qr,.extent=387});
 @load_to_dsr(reqd,m);@load_to_dsr(reqs,f,.{.async=true,.ut_id=@get_ut_id(4),.activate=rt});@mov32(reqd,reqs,.{.async=true});
}
fn arm_child() void {
 local_ready=false;child_ready=key_shard==3;joined=false;
 if(comptime key_shard<3){
  const m=@get_dsd(mem1d_dsd,.{.base_address=&child,.extent=35});const f=@get_dsd(fabin_dsd,.{.input_queue=qi,.extent=35});
  @load_to_dsr(cd,m);@load_to_dsr(cs,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=ct});@mov32(cd,cs,.{.async=true});
 }
}
fn transmit(data:[*]u32,comptime count:u16,comptime broadcast:bool) void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=data,.extent=count});const f=@get_dsd(fabout_dsd,.{.output_queue=if(broadcast) qb else qo,.extent=count});
 @load_to_dsr(ss,m);@load_to_dsr(sd,f,.{.async=true,.ut_id=@get_ut_id(5),.activate=st});@mov32(sd,ss,.{.async=true});
}
fn final_send() void {
 if(delta_sent and result_ready){sending=2;transmit(&aggregate,35,false);}
}
fn update() void {
 recurrent.update(sp,@ptrcast([*]f32,&request[1+key_shard*32]),@ptrcast([*]f32,&request[129+key_shard*32]),dp,lp);
 local_ready=true;
}
fn join() void {
 if(local_ready and child_ready and !joined){
  joined=true;
  if(comptime key_shard<3){@assert(child[32]==@as(u32,3-key_shard) and child[33]==audit[1] and child[34]==@as(u32,phase));}
  for(@range(u16,32))|i|{
   var sum:f32=local_value[i];if(comptime key_shard<3){sum+=@bitcast(f32,child[i]);}aggregate[i]=@bitcast(u32,sum);
  }
  aggregate[32]=@as(u32,4-key_shard);aggregate[33]=audit[1];aggregate[34]=@as(u32,phase);audit[3]+=1;
  if(comptime key_shard==0){
   if(phase==0){
    for(@range(u16,32))|i|{const difference:f32=@bitcast(f32,request[257+value_shard*32+i])-@bitcast(f32,aggregate[i]);delta[i]=difference*@bitcast(f32,request[386]);}
    phase=1;delta_sent=false;result_ready=false;arm_child();sending=1;transmit(@ptrcast([*]u32,dp),32,true);update();
   }else{result_ready=true;final_send();}
  }else{sending=phase;transmit(&aggregate,35,false);}
 }
}
fn finish() void {
 audit[1]+=1;remaining-=1;
 if(remaining==0){running=false;audit[6]=1;}else{arm_request();}
}
task received_request() void {
 @assert(running and request[0]==audit[1]);audit[2]+=1;phase=0;arm_child();
 recurrent.predict(sp,@ptrcast([*]f32,&request[129+key_shard*32]),@bitcast(f32,request[385]),lp);local_ready=true;join();
}
task received_child() void {child_ready=true;join();}
task received_delta() void {audit[4]+=1;phase=1;arm_child();update();join();}
task sent() void {
 audit[5]+=1;
 if(comptime key_shard==0){if(sending==1){delta_sent=true;final_send();}else{@assert(sending==2);finish();}}
 else{
  if(sending==0){
   const m=@get_dsd(mem1d_dsd,.{.base_address=&delta,.extent=32});const f=@get_dsd(fabin_dsd,.{.input_queue=qd,.extent=32});
   @load_to_dsr(dd,m);@load_to_dsr(ds,f,.{.async=true,.ut_id=@get_ut_id(6),.activate=dt});@mov32(dd,ds,.{.async=true});
  }else{@assert(sending==1);finish();}
 }
}
fn reset() void {@assert(!running);recurrent.reset(sp);for(@range(u16,8))|i|{audit[i]=0;}sys.unblock_cmd_stream();}
fn initialize(rounds:u16,base:u16) void {
 @assert(!running and rounds>0 and rounds<=8 and audit[1]==@as(u32,base));running=true;remaining=rounds;audit[0]+=1;audit[6]=0;arm_request();sys.unblock_cmd_stream();
}
fn start() void {sys.unblock_cmd_stream();}
fn dot(slot:u16) void {
 @assert(!running and slot<fp8_slots);unpacker.decode(@ptrcast([*]u16,&weights[slot*128]),&decoded,128);
 fp8.compute(&decoded,@ptrcast([*]u16,dip),dop,@bitcast(f32,dot_input[64]),scale[slot]);audit[7]+=1;sys.unblock_cmd_stream();
}
comptime {
 @initialize_queue(qr,.{.color=@get_color(request_color)});@bind_local_task(received_request,rt);
 if(key_shard<3){@initialize_queue(qi,.{.color=@get_color(chain_in)});@bind_local_task(received_child,ct);}
 if(key_shard>0){@initialize_queue(qd,.{.color=@get_color(delta_color)});@bind_local_task(received_delta,dt);}
 if(key_shard==0){@initialize_queue(qb,.{.color=@get_color(delta_color)});}
 @initialize_queue(qo,.{.color=@get_color(if(key_shard==0) result_color else chain_out)});@bind_local_task(sent,st);
 @export_symbol(wp,"weights");@export_symbol(scp,"scale");@export_symbol(sp,"state");@export_symbol(dip,"dot_input");@export_symbol(dop,"dot_output");@export_symbol(ap,"audit");
 @export_symbol(reset);@export_symbol(initialize);@export_symbol(start);@export_symbol(dot);
}
