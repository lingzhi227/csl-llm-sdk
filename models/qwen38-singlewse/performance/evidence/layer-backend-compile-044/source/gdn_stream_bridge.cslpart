// Direct fabric-to-fabric streams, with separate data and control completion.
// Invocation identity is admitted by the phase controller; actual producers
// and consumers retain their packet/value checks. No neural data is rewritten.
param bridge_group:u16;param bridge_frames:u16;param bridge_workers:u16;
param bridge_input:u16;param bridge_output:u16;
param bridge_return_input:u16;param bridge_return_output:u16;
param bridge_forward_queue:u16;param bridge_reverse_queue:u16;
param bridge_switch:bool=false;
const bridge_control=@import_module("<control>");
const bridge_tile=@import_module("<tile_config>");
const bridge_fiq=@get_input_queue(bridge_forward_queue);
const bridge_riq=@get_input_queue(bridge_reverse_queue);
const bridge_foq=@get_output_queue(6);const bridge_roq=@get_output_queue(7);
const bridge_fs=@get_dsr(dsr_src0,5);const bridge_fd=@get_dsr(dsr_dest,5);
const bridge_rs=@get_dsr(dsr_src0,4);const bridge_rd=@get_dsr(dsr_dest,4);
const bridge_ft=@get_local_task_id(10);const bridge_rt=@get_local_task_id(18);
const bridge_fdt=@get_data_task_id(bridge_fiq);const bridge_rdt=@get_data_task_id(bridge_riq);
const bridge_mt=@get_control_task_id(40);const bridge_weighted_mt=@get_control_task_id(41);
var bridge_status=@zeros([8]u32);const bridge_status_pointer:[*]u32=&bridge_status;
var bridge_active:bool=false;var bridge_fp:u16=0;var bridge_rp:u16=0;
var bridge_markers:u16=0;var bridge_token:u32=0;var bridge_marker_word:u32=0;
fn bridge_idle() bool {return !bridge_active and bridge_fp==0 and bridge_rp==0;}
fn bridge_stream_arm(token:u32) void {
 @assert(bridge_idle());BRIDGE_COHOST_IDLE
 bridge_active=true;bridge_token=token;bridge_markers=0;bridge_fp=1;bridge_rp=1;
 for(@range(u16,8))|i|{bridge_status[i]=0;}
 if(comptime bridge_switch){bridge_tile.switch_config.clear_current_position(@get_color(bridge_return_output));}
 const fi=@get_dsd(fabin_dsd,.{.input_queue=bridge_fiq,.extent=1161});
 const fo=@get_dsd(fabout_dsd,.{.output_queue=bridge_foq,.extent=1161});
 @load_to_dsr(bridge_fs,fi,.{.async=true,.ut_id=@get_ut_id(7)});
 @load_to_dsr(bridge_fd,fo,.{.async=true,.ut_id=@get_ut_id(7),.activate=bridge_ft});
 @mov32(bridge_fd,bridge_fs,.{.async=true});
 const ri=@get_dsd(fabin_dsd,.{.input_queue=bridge_riq,.extent=bridge_frames*5});
 const ro=@get_dsd(fabout_dsd,.{.output_queue=bridge_roq,.extent=bridge_frames*5});
 @load_to_dsr(bridge_rs,ri,.{.async=true,.ut_id=@get_ut_id(1)});
 @load_to_dsr(bridge_rd,ro,.{.async=true,.ut_id=@get_ut_id(1),.activate=bridge_rt});
 @mov32(bridge_rd,bridge_rs,.{.async=true});sys.unblock_cmd_stream();
}
fn bridge_inspect() void {
 bridge_status[0]=@as(u32,bridge_active);bridge_status[1]=@as(u32,bridge_fp);
 bridge_status[2]=@as(u32,bridge_rp);bridge_status[5]=@as(u32,bridge_markers);
 bridge_status[6]=bridge_token;sys.unblock_cmd_stream();
}
fn bridge_finish_if_ready() void {
 if(bridge_fp!=0 or bridge_rp!=0 or bridge_markers!=bridge_workers){return;}
 @assert(bridge_active);@block(bridge_rdt);bridge_rp=2;
 const opcode=if(bridge_switch)bridge_control.opcode.SWITCH_ADV else bridge_control.opcode.NOP;
 bridge_marker_word=bridge_control.encode_single_payload(opcode,false,bridge_weighted_mt,bridge_workers);
 const m=@get_dsd(mem1d_dsd,.{.base_address=&bridge_marker_word,.extent=1});
 const f=@get_dsd(fabout_dsd,.{.output_queue=bridge_roq,.extent=1,.control=true});
 @load_to_dsr(bridge_rs,m);
 @load_to_dsr(bridge_rd,f,.{.async=true,.ut_id=@get_ut_id(1),.activate=bridge_rt});
 @mov32(bridge_rd,bridge_rs,.{.async=true});
}
task bridge_forward_done() void {
 @assert(bridge_active and bridge_fp==1);bridge_fp=0;bridge_status[3]=9;bridge_finish_if_ready();
}
task bridge_reverse_done() void {
 if(bridge_rp==1){
  bridge_rp=0;bridge_status[4]=bridge_frames;
  if(bridge_markers<bridge_workers){@unblock(bridge_rdt);}bridge_finish_if_ready();
 }else{
  @assert(bridge_rp==2 and bridge_fp==0 and bridge_markers==bridge_workers);
  bridge_rp=0;bridge_active=false;bridge_status[7]+=1;
 }
}
task bridge_marker() void {
 @assert(bridge_active and bridge_markers<bridge_workers);
 bridge_markers+=1;bridge_finish_if_ready();
}
comptime {
 @comptime_assert(bridge_group<16 and bridge_frames>0 and bridge_frames<=192 and bridge_workers>0);
 @initialize_queue(bridge_fiq,.{.color=@get_color(bridge_input)});
 @initialize_queue(bridge_riq,.{.color=@get_color(bridge_return_input)});
 @initialize_queue(bridge_foq,.{.color=@get_color(bridge_output)});
 @initialize_queue(bridge_roq,.{.color=@get_color(bridge_return_output)});
 @bind_local_task(bridge_forward_done,bridge_ft);@bind_local_task(bridge_reverse_done,bridge_rt);
 @bind_control_task(bridge_marker,bridge_mt);@block(bridge_fdt);@block(bridge_rdt);
 @export_symbol(bridge_stream_arm);@export_symbol(bridge_inspect);@export_symbol(bridge_status_pointer,"bridge_status");
}
