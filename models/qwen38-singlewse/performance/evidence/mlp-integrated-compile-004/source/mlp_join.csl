// Generalization of P20's physically qualified credited chunk helper. Actual
// region parity, leaf collectors, terminal header and up-only relay are explicit.
// New specializations require compile/runtime qualification; P20 is unchanged.
param memcpy_params;param header:bool;param relay_only:bool;param has_child:bool;
param own_color:u16;param child_color:u16;param out_color:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);const tile=@import_module("<tile_config>");
const iq=@get_input_queue(2);const cq=@get_input_queue(3);const oq=@get_output_queue(2);
const rd=@get_dsr(dsr_dest,2);const rs=@get_dsr(dsr_src0,2);
const cd=@get_dsr(dsr_dest,3);const cs=@get_dsr(dsr_src0,3);
const sd=@get_dsr(dsr_dest,6);const ss=@get_dsr(dsr_src0,6);
const ot=@get_local_task_id(8);const ct=@get_local_task_id(9);const st=@get_local_task_id(10);const ft=@get_local_task_id(11);
var bank=@zeros([if(relay_only) 1 else 8814]u32);var values=@zeros([128]u32);var child=@zeros([8]u32);var audit=@zeros([8]u32);
const bp:[*]u32=&bank;const vp:[*]u32=&values;const ap:[*]u32=&audit;
var armed:bool=false;var started:bool=false;var complete:bool=false;
var child_ready:bool=false;var sending:bool=false;var forward_done:bool=false;
var own_received:u16=0;var output_index:u16=0;
fn finish() void {if(started and complete){started=false;armed=false;audit[7]=1;sys.unblock_cmd_stream();}}
fn transmit(base:[*]u32,comptime words:u16) void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=base,.extent=words});const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=words});
 @load_to_dsr(ss,m);@load_to_dsr(sd,f,.{.async=true,.ut_id=@get_ut_id(5),.activate=st});@mov32(sd,ss,.{.async=true});
}
fn receive_own() void {
 @assert(own_received<16);
 const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&values[own_received*8]),.extent=8});const f=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=8});
 @load_to_dsr(rd,m);@load_to_dsr(rs,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=ot});@mov32(rd,rs,.{.async=true});
}
fn receive_child() void {
 if(comptime has_child){
  @assert(!child_ready and output_index<16);
  const m=@get_dsd(mem1d_dsd,.{.base_address=&child,.extent=8});const f=@get_dsd(fabin_dsd,.{.input_queue=cq,.extent=8});
  @load_to_dsr(cd,m);@load_to_dsr(cs,f,.{.async=true,.ut_id=@get_ut_id(3),.activate=ct});@mov32(cd,cs,.{.async=true});
 }
}
fn join() void {
 if(forward_done and own_received>output_index and child_ready and !sending){
  if(comptime has_child){
   const own=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&values[output_index*8]),.extent=8});
   const rhs=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&child),.extent=8});@fadds(own,own,rhs);
  }
  audit[4]+=1;sending=true;transmit(@ptrcast([*]u32,&values[output_index*8]),8);
 }
}
task own_arrived() void {own_received+=1;audit[1]+=1;join();if(own_received<16){receive_own();}}
task child_arrived() void {child_ready=true;audit[2]+=1;join();}
task ingress_arrived() void {audit[5]+=1;transmit(vp,65);}
task sent() void {
 audit[3]+=1;
 if(!forward_done){
  if(comptime relay_only){complete=true;finish();}
  else{
   forward_done=true;audit[6]+=1;
   tile.output_queue_config.encode_output_queue(2,@as(i16,out_color));
   tile.input_queue_config.encode_input_queue(2,@as(i16,own_color),false);receive_own();join();
  }
 }else{
  sending=false;child_ready=!has_child;output_index+=1;
  if(output_index==16){complete=true;finish();}else{receive_child();join();}
 }
}
fn arm(layer:u16) void {
 @assert(!armed and !started and layer<64);armed=true;complete=false;child_ready=!has_child;sending=false;
 own_received=0;output_index=0;forward_done=!header;
 for(@range(u16,8))|i|{audit[i]=0;}audit[0]=1;
 if(comptime !relay_only){receive_child();}
 if(comptime header){
  tile.input_queue_config.encode_input_queue(2,2,false);tile.output_queue_config.encode_output_queue(2,3);
  const m=@get_dsd(mem1d_dsd,.{.base_address=&values,.extent=65});const f=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=65});
  @load_to_dsr(rd,m);@load_to_dsr(rs,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=ft});@mov32(rd,rs,.{.async=true});
 }else{receive_own();}
 sys.unblock_cmd_stream();
}
fn start() void {@assert(armed and !started);started=true;finish();}
fn embedding_lookup(slot:u16,half:u16) void {
 @assert(!armed and !started and slot<68 and half<2);
 if(comptime !relay_only){
  const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&bank[slot*128+half*64]),.extent=64});
  const out=@get_dsd(mem1d_dsd,.{.base_address=&values,.extent=64});@mov32(out,m);
 }
 sys.unblock_cmd_stream();
}
comptime {
 @initialize_queue(oq,.{.color=@get_color(if(header) 3 else out_color)});
 @initialize_queue(iq,.{.color=@get_color(if(header) 2 else own_color)});
 if(has_child){@initialize_queue(cq,.{.color=@get_color(child_color)});@bind_local_task(child_arrived,ct);}
 if(header){@bind_local_task(ingress_arrived,ft);}
 if(!relay_only){@bind_local_task(own_arrived,ot);}
 @bind_local_task(sent,st);@export_symbol(bp,"bank");@export_symbol(vp,"packet");@export_symbol(ap,"audit");
 @export_symbol(arm);@export_symbol(start);@export_symbol(embedding_lookup);
}
