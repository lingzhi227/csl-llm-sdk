// Complete group128 producer: spatial max, identical scale/division/FP8 codec,
// exact half encoding, and ordered gather into the65-word GEMV operand packet.
param memcpy_params;param x:u16;param y:u16;param width:u16;param height:u16;param items:u16;
param max_east_color:u16;param max_south_color:u16;param max_out_color:u16;param scale_color:u16;
param gather_east_color:u16;param gather_south_color:u16;param gather_out_color:u16;
param max_east_iq:u16;param max_south_iq:u16;param scale_iq:u16;param gather_east_iq:u16;param gather_south_iq:u16;
param max_oq:u16;param scale_oq:u16;param gather_oq:u16;
param max_sent_task:u16;param scale_task:u16;param east_task:u16;param south_task:u16;param gather_sent_task:u16;
param max_dsr:u16;param scale_dsr:u16;param east_dsr:u16;param south_dsr:u16;param gather_dsr:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);const clock=@import_module("<time>");const codec=@import_module("fp8_encode.csl");
const unpacker=@import_module("fp8_unpack.csl",.{.max_pairs=128});const dot=@import_module("fp8_dot.csl",.{.rows=2});
var weights=@zeros([128]u16);var weight_scale=@zeros([1]f32);var decoded=@zeros([256]u16);var product=@zeros([2]f32);var prepared=@zeros([1]u32);
const wp:[*]u16=&weights;const wsp:[*]f32=&weight_scale;const productp:[*]f32=&product;const readyp:[*]u32=&prepared;
const root:bool=x==0 and y==0;const local_words:u16=items/2;
const east_words:u16=(width-x-1)*local_words;const south_words:u16=(height-y-1)*width*local_words;
const total_words:u16=if(x==0) (height-y)*width*local_words else (width-x)*local_words;
var input=@zeros([items]f32);var codes=@zeros([items]u16);var scale=@zeros([1]u32);
var packet=@zeros([65]u32);var maximum=@zeros([1]u32);var audit=@zeros([10]u32);var ticks=@zeros([18]u16);
const ip:[*]f32=&input;const cp:[*]u16=&codes;const sp:[*]u32=&scale;const pp:[*]u32=&packet;const ap:[*]u32=&audit;const tp:[*]u16=&ticks;
var armed:bool=false;var local_max_ready:bool=false;var max_east_ready:bool=false;var max_south_ready:bool=false;var max_started:bool=false;var max_sent:bool=false;
var local_payload_ready:bool=false;var east_ready:bool=false;var south_ready:bool=false;var gather_started:bool=false;var gather_sent:bool=false;var scale_credit:bool=false;var finished:bool=false;
const qme=@get_input_queue(max_east_iq);const qms=@get_input_queue(max_south_iq);const qscale=@get_input_queue(scale_iq);const qge=@get_input_queue(gather_east_iq);const qgs=@get_input_queue(gather_south_iq);
const qmo=@get_output_queue(max_oq);const qso=@get_output_queue(scale_oq);const qgo=@get_output_queue(gather_oq);
const md=@get_dsr(dsr_dest,max_dsr);const ms=@get_dsr(dsr_src0,max_dsr);
const sd=@get_dsr(dsr_dest,scale_dsr);const ss=@get_dsr(dsr_src0,scale_dsr);
const ed=@get_dsr(dsr_dest,east_dsr);const es=@get_dsr(dsr_src0,east_dsr);
const bd=@get_dsr(dsr_dest,south_dsr);const bs=@get_dsr(dsr_src0,south_dsr);
const gd=@get_dsr(dsr_dest,gather_dsr);const gs=@get_dsr(dsr_src0,gather_dsr);
const mt=@get_local_task_id(max_sent_task);const st=@get_local_task_id(scale_task);const et=@get_local_task_id(east_task);const bt=@get_local_task_id(south_task);const gt=@get_local_task_id(gather_sent_task);
fn finish() void {
 if(gather_sent and max_sent and scale_credit and !finished){finished=true;armed=false;audit[9]=1;
  if(comptime root){
   @assert(prepared[0]==1);clock.get_timestamp(@ptrcast(*[3]u16,&ticks[6]));
   dot.compute(&decoded,@ptrcast([*]u16,pp),&product,@bitcast(f32,scale[0]),weight_scale[0]);
   clock.get_timestamp(@ptrcast(*[3]u16,&ticks[9]));clock.disable_tsc();
  }sys.unblock_cmd_stream();}
}
fn join_payload() void {
 if(local_payload_ready and east_ready and south_ready and !gather_started){gather_started=true;
  if(comptime root){audit[8]=1;clock.get_timestamp(@ptrcast(*[3]u16,&ticks[3]));gather_sent=true;finish();}
  else{
   const m=@get_dsd(mem1d_dsd,.{.base_address=&packet,.extent=total_words});const f=@get_dsd(fabout_dsd,.{.output_queue=qgo,.extent=total_words});
   @load_to_dsr(gs,m);@load_to_dsr(gd,f,.{.async=true,.activate=gt});@mov32(gd,gs,.{.async=true});
  }
 }
}
fn encode_local() void {
 @assert(!local_payload_ready);const scaling:f32=@bitcast(f32,scale[0]);
 for(@range(u16,items))|i|{codes[i]=codec.encode(input[i]/scaling);}
 for(@range(u16,local_words))|i|{
  const a:u16=((codes[2*i]&127)<<7)|((codes[2*i]&128)<<8);const b:u16=((codes[2*i+1]&127)<<7)|((codes[2*i+1]&128)<<8);
  packet[i]=@as(u32,a)|(@as(u32,b)<<16);
 }
 packet[64]=scale[0];audit[4]=1;local_payload_ready=true;join_payload();
}
fn join_maximum() void {
 if(local_max_ready and max_east_ready and max_south_ready and !max_started){max_started=true;
  if(comptime root){
   scale[0]=@bitcast(u32,@bitcast(f32,maximum[0])*0.002232142857142857);
   const m=@get_dsd(mem1d_dsd,.{.base_address=&scale,.extent=1});const f=@get_dsd(fabout_dsd,.{.output_queue=qso,.extent=1});
   @load_to_dsr(ss,m);@load_to_dsr(sd,f,.{.async=true,.activate=st});@mov32(sd,ss,.{.async=true});encode_local();
  }else{
   const m=@get_dsd(mem1d_dsd,.{.base_address=&maximum,.extent=1});const f=@get_dsd(fabout_dsd,.{.output_queue=qmo,.extent=1});
   @load_to_dsr(ms,m);@load_to_dsr(md,f,.{.async=true,.activate=mt});@mov32(md,ms,.{.async=true});
  }
 }
}
task received_max_east(value:u32) void {@block(qme);@assert(armed and !max_east_ready);max_east_ready=true;if(value>maximum[0]){maximum[0]=value;}audit[2]+=1;join_maximum();}
task received_max_south(value:u32) void {@block(qms);@assert(armed and !max_south_ready);max_south_ready=true;if(value>maximum[0]){maximum[0]=value;}audit[2]+=1;join_maximum();}
task sent_maximum() void {max_sent=true;audit[3]=1;finish();}
task scale_event() void {if(comptime root){scale_credit=true;audit[5]=1;finish();}else{encode_local();}}
task received_east() void {east_ready=true;audit[6]+=1;join_payload();}
task received_south() void {south_ready=true;audit[6]+=1;join_payload();}
task sent_gather() void {gather_sent=true;audit[7]=1;finish();}
fn prepare_weight() void {
 if(comptime root){clock.enable_tsc();clock.get_timestamp(@ptrcast(*[3]u16,&ticks[12]));unpacker.decode(wp,&decoded,128);clock.get_timestamp(@ptrcast(*[3]u16,&ticks[15]));clock.disable_tsc();prepared[0]=1;}
 sys.unblock_cmd_stream();
}
fn arm() void {
 @assert(!armed);armed=true;local_max_ready=false;max_east_ready=x+1==width;max_south_ready=x>0 or y+1==height;max_started=false;max_sent=root;
 local_payload_ready=false;east_ready=x+1==width;south_ready=x>0 or y+1==height;gather_started=false;gather_sent=false;scale_credit=!root;finished=false;
 maximum[0]=@bitcast(u32,@as(f32,0.0000000001));scale[0]=0;
 for(@range(u16,65))|i|{packet[i]=2774181210;}for(@range(u16,items))|i|{codes[i]=65535;}
 for(@range(u16,10))|i|{audit[i]=0;}audit[0]=1;
 if(comptime x+1<width){
  @unblock(qme);const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&packet[local_words]),.extent=east_words});const f=@get_dsd(fabin_dsd,.{.input_queue=qge,.extent=east_words});
  @load_to_dsr(ed,m);@load_to_dsr(es,f,.{.async=true,.activate=et});@mov32(ed,es,.{.async=true});
 }
 if(comptime x==0 and y+1<height){
  @unblock(qms);const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&packet[width*local_words]),.extent=south_words});const f=@get_dsd(fabin_dsd,.{.input_queue=qgs,.extent=south_words});
  @load_to_dsr(bd,m);@load_to_dsr(bs,f,.{.async=true,.activate=bt});@mov32(bd,bs,.{.async=true});
 }
 if(comptime !root){
  const m=@get_dsd(mem1d_dsd,.{.base_address=&scale,.extent=1});const f=@get_dsd(fabin_dsd,.{.input_queue=qscale,.extent=1});
  @load_to_dsr(sd,m);@load_to_dsr(ss,f,.{.async=true,.activate=st});@mov32(sd,ss,.{.async=true});
 }
 sys.unblock_cmd_stream();
}
fn start() void {
 @assert(armed and !local_max_ready);if(comptime root){clock.enable_tsc();clock.get_timestamp(@ptrcast(*[3]u16,&ticks[0]));}
 for(@range(u16,items))|i|{const magnitude:u32=@bitcast(u32,input[i])&2147483647;@assert(magnitude<2139095040);if(magnitude>maximum[0]){maximum[0]=magnitude;}}
 local_max_ready=true;audit[1]=1;join_maximum();
}
comptime {
 if(x+1<width){@initialize_queue(qme,.{.color=@get_color(max_east_color)});@bind_data_task(received_max_east,@get_data_task_id(qme));@initialize_queue(qge,.{.color=@get_color(gather_east_color)});@bind_local_task(received_east,et);}
 if(x==0 and y+1<height){@initialize_queue(qms,.{.color=@get_color(max_south_color)});@bind_data_task(received_max_south,@get_data_task_id(qms));@initialize_queue(qgs,.{.color=@get_color(gather_south_color)});@bind_local_task(received_south,bt);}
 @bind_local_task(scale_event,st);
 if(root){@initialize_queue(qso,.{.color=@get_color(scale_color)});}
 else{
  @initialize_queue(qmo,.{.color=@get_color(max_out_color)});@bind_local_task(sent_maximum,mt);
  @initialize_queue(qscale,.{.color=@get_color(scale_color)});@initialize_queue(qgo,.{.color=@get_color(gather_out_color)});@bind_local_task(sent_gather,gt);
 }
 @export_symbol(wp,"weights");@export_symbol(wsp,"weight_scale");@export_symbol(productp,"product");@export_symbol(readyp,"prepared");@export_symbol(prepare_weight);
 @export_symbol(ip,"input");@export_symbol(cp,"codes");@export_symbol(sp,"scale");@export_symbol(pp,"packet");@export_symbol(ap,"audit");@export_symbol(tp,"ticks");@export_symbol(arm);@export_symbol(start);
}
