// Immutable resident request bank; each result gates the next autonomous epoch.
param memcpy_params;param active:u16;param cases:u16;param max_rounds:u16;param request_color:u16;param result_color:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);const clock=@import_module("<time>");
var requests=@zeros([cases*66]u32);var results=@zeros([max_rounds*4]u32);var ticks=@zeros([max_rounds*6]u16);var audit=@zeros([8]u16);
const pp:[*]u32=&requests;const rp:[*]u32=&results;const tp:[*]u16=&ticks;const ap:[*]u16=&audit;
const qi=@get_input_queue(2);const qo=@get_output_queue(2);const sd=@get_dsr(dsr_dest,3);const ss=@get_dsr(dsr_src0,3);const rd=@get_dsr(dsr_dest,5);const rs=@get_dsr(dsr_src0,5);
const st=@get_local_task_id(8);const rt=@get_local_task_id(9);
var running:bool=false;var sent_ready:bool=false;var result_ready:bool=false;var limit:u16=0;var completed:u16=0;var current:u16=0;
fn issue() void {
 sent_ready=false;result_ready=false;clock.get_timestamp(@ptrcast(*[3]u16,&ticks[completed*6]));
 const out=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&results[completed*4]),.extent=4});const fi=@get_dsd(fabin_dsd,.{.input_queue=qi,.extent=4});
 @load_to_dsr(rd,out);@load_to_dsr(rs,fi,.{.async=true,.activate=rt});@mov32(rd,rs,.{.async=true});
 const payload=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&requests[current*66]),.extent=66});const fo=@get_dsd(fabout_dsd,.{.output_queue=qo,.extent=66});
 @load_to_dsr(ss,payload);@load_to_dsr(sd,fo,.{.async=true,.activate=st});@mov32(sd,ss,.{.async=true});
}
fn advance() void {
 if(sent_ready and result_ready){
  completed+=1;current+=1;if(current==cases){current=0;}
  if(completed==limit){running=false;audit[6]=1;clock.disable_tsc();sys.unblock_cmd_stream();}else{issue();}
 }
}
task sent() void {audit[1]+=1;sent_ready=true;advance();}
task received() void {clock.get_timestamp(@ptrcast(*[3]u16,&ticks[completed*6+3]));@assert(results[completed*4+3]==@as(u32,completed) and results[completed*4+2]==6);audit[2]+=1;result_ready=true;advance();}
fn initialize(rounds:u16,first:u16) void {
 @assert(!running and rounds>0 and rounds<=max_rounds and first<cases);limit=rounds;completed=0;current=first;
 for(@range(u16,8))|i|{audit[i]=0;}audit[0]=1;sys.unblock_cmd_stream();
}
fn start() void {
 if(comptime active>0){@assert(!running);running=true;clock.enable_tsc();issue();}else{audit[6]=1;sys.unblock_cmd_stream();}
}
comptime {
 if(active>0){@initialize_queue(qi,.{.color=@get_color(result_color)});@initialize_queue(qo,.{.color=@get_color(request_color)});@bind_local_task(sent,st);@bind_local_task(received,rt);}
 @export_symbol(pp,"requests");@export_symbol(rp,"results");@export_symbol(tp,"ticks");@export_symbol(ap,"audit");@export_symbol(initialize);@export_symbol(start);
}
