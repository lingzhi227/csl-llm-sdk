param control_reply_rx:direction;param control_reply_tx:direction;
// Preserve the original mixer/state resident bank in this MLP-only component.
// No mixer operation is executed; it is not a full-layer acceptance artifact.
param memcpy_params;param bank_words:u16;
const sys=@import_module("device_control.csl",.{.command_task=@get_local_task_id(24),.routed=true,.reply_rx=control_reply_rx,.reply_tx=control_reply_tx,.forward_host_commands=true});
var bank=@zeros([if(bank_words>0) bank_words else 1]u32);var audit=@zeros([4]u32);var setup=@zeros([5]u16);
const bp:[*]u32=&bank;const ap:[*]u32=&audit;const sp:[*]u16=&setup;
fn arm(epoch:u32) void {@assert(gdn_graph_drained());@assert(mixer.drained() and mixer_status[2]==0);audit[0]=epoch;sys.unblock_cmd_stream();}
fn start() void {sys.unblock_cmd_stream();}
fn finish() void {sys.unblock_cmd_stream();}
comptime {}

// Composition port: the future conv/gate/residual consumer receives this local
// root notification. Until connected, root data stays leased for explicit
// consume; no synthetic neural result or fake automatic completion is emitted.
param mixer_rank_parity:u16;param mixer_input48_queue:u16;param mixer_can_root:bool;
const mrt=@get_local_task_id(25);const mdt=@get_local_task_id(26);
const mixer=@import_module("mixer_projection.csl",.{.rank_parity=mixer_rank_parity,.bank_words=bank_words,
 .input48_queue=mixer_input48_queue,.can_root=mixer_can_root,.root_ready_task=mrt,.drained_task=mdt});
var mixer_status=@zeros([4]u32);const msp:[*]u32=&mixer_status;
const msetup:[*]u16=mixer.setup_pointer;const maudit:[*]u32=mixer.audit_pointer;
const mout:[*]u32=mixer.root_output;
task mixer_root_ready() void {
 @assert(mixer_status[2]==0);mixer_status[0]=mout[0];mixer_status[1]=mout[1];mixer_status[2]=1;
}
task mixer_drained() void {mixer_status[3]+=1;}
fn mixer_begin(request:u32,generation:u32,projection:u16) void {
 
 @assert(mixer_status[2]==0);mixer.begin(bp,request,generation,projection);sys.unblock_cmd_stream();
}
fn mixer_consume(generation:u32,row:u16) void {
 @assert(mixer_status[2]==1);mixer_status[2]=0;mixer.root_consumed(generation,row);sys.unblock_cmd_stream();
}
comptime {
 @bind_local_task(mixer_root_ready,mrt);@bind_local_task(mixer_drained,mdt);
 
 
 
}

// Segment IDs are a device ABI, never arbitrary host-provided pointers.
const device_task=@get_local_task_id(24);
fn device_transfer() void {
 const c=sys.command;const segment=c[2];frontend_snapshot();
 @assert(c[4]>0 and c[4]<=256 and c[3]<65536 and c[3]+c[4]<65536);
 const first=@as(u16,c[3]);const length=@as(u16,c[4]);
 var pointer:[*]u32=bp;var half:[*]u16=msetup;var extent:u16=0;var bits:u16=32;var writable:bool=false;
 if(segment==0){pointer=bp;extent=bank_words;writable=true;}
 else if(segment==1){half=msetup;extent=46;bits=16;writable=true;}
 else if(segment==2){pointer=maudit;extent=6;}
 else if(segment==3){pointer=msp;extent=4;}
 else if(segment==4){pointer=mout;extent=5;}
 else if(segment==8){pointer=ap;extent=4;}
 else if(segment==9){half=frontend.wp;extent=2560;bits=16;writable=true;}
 else if(segment==10){half=frontend.hp;extent=1920;bits=16;}
 else if(segment==11){half=frontend.gp;extent=128;bits=16;writable=true;}
 else if(segment==12){half=frontend.pp;extent=6;bits=16;writable=true;}
 else if(segment==13){pointer=@ptrcast([*]u32,frontend.vp);extent=256;}
 else if(segment==14){half=frontend.zp;extent=384;bits=16;}
 else if(segment==15){pointer=@ptrcast([*]u32,&frontend.gates);extent=6;}
 else if(segment==16){pointer=frontend.packet_pointer;extent=387;}
 else if(segment==17){half=frontend.op;extent=384;bits=16;}
 else if(segment==18){pointer=frontend.ap;extent=8;}
 else if(segment==19){pointer=fsp;extent=10;}
 else if(segment==20){half=frontend.vvp;extent=384;bits=16;}
 
 else{@assert(false);}
 @assert(first+length<=extent);
 if(c[1]==0){
  @assert(writable and mixer.drained() and mixer_status[2]==0 and gdn_graph_drained());
  if(bits==32){sys.write32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{sys.write16(@ptrcast([*]u16,&half[@as(u16,first)]),@as(u16,length));}
 }else{
  @assert(c[1]==1);
  if(bits==32){sys.read32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{if(comptime sys.routed){@assert(first%2==0 and length%2==0);}sys.read16(@ptrcast([*]u16,&half[first]),length);}
 }
}
task device_command() void {
 const c=sys.command;
 if(c[1]<2){device_transfer();}
 else if(c[1]==2){arm(c[2]);}
 else if(c[1]==3){start();}
 else if(c[1]==4){finish();}
 else if(c[1]==5){@assert(c[4]<5);mixer_begin(c[2],c[3],@as(u16,c[4]));}
 else if(c[1]==6){@assert(c[3]<65536);mixer_consume(c[2],@as(u16,c[3]));}
 else if(c[1]==7){@assert(frontend_transport_drained() and mixer.drained());frontend_begin(c[2]);sys.unblock_cmd_stream();}
 else if(c[1]==8){@assert(frontend_transport_drained() and mixer.drained());frontend_reset();sys.unblock_cmd_stream();}
 else if(c[1]==11){@assert(c[3]<3);frontend.output_consumed(c[2],@as(u16,c[3]));sys.unblock_cmd_stream();}
 
 else{@assert(false);}
}
comptime {@bind_local_task(device_command,device_task);}

// Native root frame [token,row,rows,packed-BF16,matrix] is multicast only to
// groups needed by this source. Foreign rows are skipped at their destination,
// leaving root code small enough for its full-K group's weight capacity.
param frontend_group:u16;param frontend_projected_packets:u16;
const frontend_ready=@get_local_task_id(18);const frontend_output=@get_local_task_id(19);
const frontend=@import_module("resident_frontend_native.csl",.{.group=frontend_group,.ready_task=frontend_ready,.output_task=frontend_output});
const frontend_iq=@get_input_queue(1);
var frontend_frame=@zeros([5]u32);var frontend_cursor:u16=0;
var frontend_wire_active:bool=false;var frontend_wire_packets:u32=0;
var frontend_status=@zeros([10]u32);const fsp:[*]u32=&frontend_status;
fn frontend_transport_drained() bool {return !frontend_wire_active and frontend_cursor==0;}
fn frontend_snapshot() void {
 frontend_status[0]=frontend.invocation;frontend_status[1]=@as(u32,frontend.notified);
 frontend_status[2]=@as(u32,frontend.consumed);frontend_status[3]=@as(u32,frontend.completed);
 frontend_status[4]=@as(u32,frontend.retired);frontend_status[5]=0;
 if(frontend.packet_busy){frontend_status[5]=1;}frontend_status[6]=@as(u32,frontend_cursor);
 frontend_status[7]=0;if(gdn_graph_drained()){frontend_status[7]=1;}
 frontend_status[8]=frontend_wire_packets;frontend_status[9]=@as(u32,frontend_projected_packets)+192;
}
fn frontend_begin(token:u32) void {
 @assert(gdn_graph_drained());gdn_next_head=0;gdn_markers=gdn_worker_count;gdn_core_left=192;frontend.begin(token);frontend_wire_packets=0;frontend_wire_active=true;
}
fn frontend_reset() void {
 @assert(gdn_graph_drained());gdn_next_head=3;gdn_markers=0;gdn_core_left=0;frontend.reset();frontend_wire_packets=0;
}
fn frontend_deliver() void {
 const token=frontend_frame[0];@assert(token==frontend.invocation and frontend_wire_active);
 @assert(frontend_frame[1]<10240 and frontend_frame[4]<4);
 const row=@as(u16,frontend_frame[1]);const matrix=@as(u16,frontend_frame[4]);
 var wanted:bool=false;var index:u16=row;
 if(matrix==0){
  @assert(frontend_frame[2]==2 and row%2==0);
  wanted=(row>=128*frontend_group and row<128*frontend_group+128) or
         (row>=2048+128*frontend_group and row<2048+128*frontend_group+128) or
         (row>=4096+384*frontend_group and row<4096+384*frontend_group+384);
 }else if(matrix==1){
  @assert(frontend_frame[2]==2 and row%2==0 and row<6144);
  wanted=row>=384*frontend_group and row<384*frontend_group+384;
  index=10240+row;
 }else{
  @assert(frontend_frame[2]==1 and row<48 and frontend_frame[3]<65536);
  wanted=row>=3*frontend_group and row<3*frontend_group+3;index=16384+(matrix-2)*48+row;
 }
 if(wanted){frontend.accept(token,index,@as(u16,frontend_frame[3]&65535),@as(u16,frontend_frame[3]>>16));}
 frontend_wire_packets+=1;
 @assert(frontend_wire_packets<=@as(u32,frontend_projected_packets)+192);
 if(frontend_wire_packets==@as(u32,frontend_projected_packets)+192){frontend_wire_active=false;}
}
task frontend_arrived(value:u32) void {
 @assert(frontend_cursor<5);frontend_frame[frontend_cursor]=value;frontend_cursor+=1;
 if(frontend_cursor==5){frontend_deliver();frontend_cursor=0;}
}
task frontend_packet_ready() void {gdn_pump();}
task frontend_output_ready() void {frontend_snapshot();}
comptime {
 @comptime_assert(frontend_projected_packets>=518);
 @initialize_queue(frontend_iq,.{.color=@get_color(3)});
 @bind_data_task(frontend_arrived,@get_data_task_id(frontend_iq));
 @bind_local_task(frontend_packet_ready,frontend_ready);@bind_local_task(frontend_output_ready,frontend_output);
}

// The packet DMA lease and the successor output lease retire independently.
param gdn_worker_count:u16;param gdn_send_color:u16;param gdn_return_color:u16;
const gdn_source_oq=@get_output_queue(3);const gdn_core_iq=@get_input_queue(3);
const gdn_tx_s=@get_dsr(dsr_src0,1);const gdn_tx_d=@get_dsr(dsr_dest,1);
const gdn_tx_done=@get_local_task_id(8);const gdn_marker_task=@get_control_task_id(40);
var gdn_next_head:u16=3;var gdn_markers:u16=0;var gdn_core_cursor:u16=0;
var gdn_core_left:u16=0;var gdn_core_frame=@zeros([5]u32);
fn gdn_graph_drained() bool {
 return frontend.drained() and frontend_transport_drained() and gdn_core_cursor==0 and
  gdn_markers==0 and gdn_next_head==3 and gdn_core_left==0;
}
fn gdn_pump() void {
 if(gdn_next_head==3 or frontend.packet_busy){return;}
 const bit:u16=@as(u16,1)<<gdn_next_head;if((frontend.notified&bit)==0){return;}
 frontend.prepare(gdn_next_head);
 const source=@get_dsd(mem1d_dsd,.{.base_address=frontend.packet_pointer,.extent=387});
 const target=@get_dsd(fabout_dsd,.{.output_queue=gdn_source_oq,.extent=387});
 frontend.packet_launched(frontend.invocation,gdn_next_head);
 @load_to_dsr(gdn_tx_s,source);
 @load_to_dsr(gdn_tx_d,target,.{.async=true,.ut_id=@get_ut_id(1),.activate=gdn_tx_done});
 @mov32(gdn_tx_d,gdn_tx_s,.{.async=true});
}
task gdn_packet_sent() void {
 frontend.packet_consumed(frontend.invocation,gdn_next_head);gdn_next_head+=1;gdn_pump();
}
task gdn_returned(value:u32) void {
 @assert(gdn_core_cursor<5);gdn_core_frame[gdn_core_cursor]=value;gdn_core_cursor+=1;
 if(gdn_core_cursor==5){
  @assert(gdn_core_frame[0]==frontend.invocation and gdn_core_frame[2]==2 and gdn_core_frame[4]==5);
  @assert(gdn_core_frame[1]<6144);
  const row=@as(u16,gdn_core_frame[1]);
  @assert(row>=384*frontend_group and row<384*frontend_group+384 and row%2==0);
  frontend.accept(gdn_core_frame[0],16480+row,@as(u16,gdn_core_frame[3]&65535),@as(u16,gdn_core_frame[3]>>16));
  gdn_core_cursor=0;@assert(gdn_core_left>0);gdn_core_left-=1;
  frontend_wire_packets+=1;@assert(frontend_wire_packets<=@as(u32,frontend_projected_packets)+192);
  if(frontend_wire_packets==@as(u32,frontend_projected_packets)+192){frontend_wire_active=false;}
 }
}
task gdn_marker() void {@assert(gdn_markers>0);gdn_markers-=1;}
comptime {
 @initialize_queue(gdn_source_oq,.{.color=@get_color(gdn_send_color)});
 @initialize_queue(gdn_core_iq,.{.color=@get_color(gdn_return_color)});
 @bind_local_task(gdn_packet_sent,gdn_tx_done);
 @bind_data_task(gdn_returned,@get_data_task_id(gdn_core_iq));
 @bind_control_task(gdn_marker,gdn_marker_task);
}

const gdn_weighted_marker_task=@get_control_task_id(41);
task gdn_weighted_marker(count:u16) void {
 @assert(count>0 and count<=gdn_markers);gdn_markers-=count;
}
comptime {@bind_control_task(gdn_weighted_marker,gdn_weighted_marker_task);}
