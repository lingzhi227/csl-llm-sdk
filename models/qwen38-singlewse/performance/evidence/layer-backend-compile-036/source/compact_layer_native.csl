// Resident region row loop. Keep a PE's selected K slices throughout the matrix.
// Stream one output block with explicit send+consumer ownership, not a large
// per-PE array of partial outputs. Original BF16 rounding belongs after full K.
param rows:u16;param columns:u16;param branches:u16;param max_parts:u16;
param direct_single:bool=false;
// A copied, lossless FIFO fabric stream releases its private source arena at
// DMA completion. Request/state completion still belongs to the stage lease.
param require_consumer_credit:bool=true;
comptime {@comptime_assert(rows*columns==256 and (branches==1 or branches==2) and max_parts*columns<=128);}
const unpacker=@import_module("fp8_unpack_shift.csl",.{.max_pairs=128});
const dot=@import_module("fp8_shape.csl",.{.rows=rows,.columns=columns,.vector_scales=true});
var decoded=@zeros([256]u16);
var inputs=@zeros([max_parts*columns]u16);
var scales=@zeros([max_parts]f32);
var local=@zeros([if(direct_single and max_parts==1) 1 else rows]f32);
var partial=@zeros([branches*rows]f32);
var base=@zeros([branches]u16);
var scale_first:u16=0;
var parts:u16=0;var iterations:u16=0;var iteration:u16=0;var mask:u16=0;
var epoch:u32=0;var pending:bool=false;var sent:bool=false;var credited:bool=false;
const result:[*]f32=&partial;

fn configure(new_epoch:u32,k_parts:u16,output_iterations:u16,base0:u16,base1:u16,first_output:u16) void {
 @assert(!pending and iteration==iterations and new_epoch>epoch);
 @assert(k_parts>0 and k_parts<=max_parts and output_iterations>0);
 scale_first=first_output%128;epoch=new_epoch;parts=k_parts;iterations=output_iterations;iteration=0;mask=0;
 base[0]=base0;if(comptime branches==2){base[1]=base1;}
}
fn capture(observed_epoch:u32,part:u16,packet:[*]u32) void {
 @assert(observed_epoch==epoch and part<parts and iteration==0 and !pending);
 const bit=@as(u16,1)<<part;@assert((mask&bit)==0);
 const source=@ptrcast([*]u16,packet);
 const input=@get_dsd(mem1d_dsd,.{.base_address=source,.extent=columns});
 const saved=@get_dsd(mem1d_dsd,.{.base_address=&inputs[part*columns],.extent=columns});
 @mov16(saved,input);scales[part]=@bitcast(f32,packet[columns/2]);mask|=bit;
}
fn ready() bool {return !pending and iteration<iterations and mask==(@as(u16,1)<<parts)-1;}
fn compute(bank:[*]u32,bank_words:u16) void {
 @assert(ready());
 if(comptime direct_single and max_parts==1){
  for(@range(u16,branches))|branch|{
   const offset=base[branch]+iteration*64;const scale_word=base[branch]+iterations*64+((scale_first+iteration*rows)>>7);@assert(offset+64<=bank_words and scale_word<bank_words);
   unpacker.decode(@ptrcast([*]u16,&bank[offset]),&decoded,128);
   dot.compute(&decoded,&inputs,@ptrcast([*]f32,&partial[branch*rows]),scales[0],@bitcast(f32,bank[scale_word]));
  }
  pending=true;sent=false;credited=false;return;
 }
 const all=@get_dsd(mem1d_dsd,.{.base_address=&partial,.extent=branches*rows});@fmovs(all,0.0);
 for(@range(u16,branches))|branch|{
  var part:u16=0;
  while(part<parts){
   const offset=base[branch]+(iteration*parts+part)*64;const scale_word=base[branch]+iterations*parts*64+((scale_first+iteration*rows)>>7)*parts+part;@assert(offset+64<=bank_words and scale_word<bank_words);
   unpacker.decode(@ptrcast([*]u16,&bank[offset]),&decoded,128);
   dot.compute(&decoded,@ptrcast([*]u16,&inputs[part*columns]),&local,scales[part],@bitcast(f32,bank[scale_word]));
   const acc=@get_dsd(mem1d_dsd,.{.base_address=&partial[branch*rows],.extent=rows});
   const term=@get_dsd(mem1d_dsd,.{.base_address=&local,.extent=rows});@fadds(acc,acc,term);
   part+=1;
  }
 }
 pending=true;sent=false;credited=false;
}
fn release_if_done() void {if(sent and (credited or !require_consumer_credit)){pending=false;iteration+=1;}}
fn send_completed(observed_epoch:u32,row:u16) void {
 @assert(pending and observed_epoch==epoch and row==iteration and !sent);sent=true;release_if_done();
}
fn consumer_credit(observed_epoch:u32,row:u16) void {
 @assert(pending and observed_epoch==epoch and row==iteration and !credited);credited=true;release_if_done();
}
fn done() bool {return !pending and iteration==iterations;}
