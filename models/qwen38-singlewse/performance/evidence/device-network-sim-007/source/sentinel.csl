param memcpy_params;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
var sentinel=@zeros([2]u32);const sp:[*]u32=&sentinel;
fn sentinel_ping(value:u32) void {sentinel[0]=value;sentinel[1]+=1;sys.unblock_cmd_stream();}
comptime {@export_symbol(sp,"sentinel");@export_symbol(sentinel_ping);}
