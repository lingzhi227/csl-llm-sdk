const memcpy=@import_module("<memcpy/get_params>",.{.width=4,.height=1});
layout {
 @set_rectangle(4,1);
 @set_tile_code(0,0,"pe.csl",.{.memcpy_params=memcpy.get_params(0),.rows=2,.columns=128});
 @set_tile_code(1,0,"pe.csl",.{.memcpy_params=memcpy.get_params(1),.rows=4,.columns=64});
 @set_tile_code(2,0,"pe.csl",.{.memcpy_params=memcpy.get_params(2),.rows=8,.columns=32});
 @set_tile_code(3,0,"pe.csl",.{.memcpy_params=memcpy.get_params(3),.rows=16,.columns=16});
 @export_name("bank",[*]u32,false);
 @export_name("packet",[*]u32,false);
 @export_name("output",[*]f32,false);
 @export_name("ticks",[*]u16,false);
 @export_name("audit",[*]u32,false);
 @export_name("measure",fn(u16,u16)void);
}
