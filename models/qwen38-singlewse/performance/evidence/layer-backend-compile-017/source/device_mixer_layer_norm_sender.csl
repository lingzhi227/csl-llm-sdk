// Adjacent companion of one residual/RMS owner. Its first arrival is quantized
// and sent to the original MLP; its second is the successor normalized output.
// Separate PEs keep both actual programs inside the original resident bank map.
param memcpy_params;param bank_words:u16;param rank:u16;
param sender_id:u16;param bus_rx:direction;param bus_tx:direction;
const sys=@import_module("device_control.csl",.{.command_task=@get_local_task_id(24)});
const helper=@import_module("mlp_fused.csl");const dt=@get_local_task_id(9);
const sender=@import_module("layer_mlp_sender.csl",.{.enabled=true,.norm_bridge=true,
 .drained_task=dt,.bus_rx=bus_rx,.bus_tx=bus_tx,.actor=helper,.fusion_actor=false,
 .sender_id=sender_id,.input_quantizer=true,.input_group=rank,
 .output_sink=false,.sink_color=0,.sink_index=0,.sink_first=0,.sink_rows=4});
var bank=@zeros([if(bank_words>0) bank_words else 1]u32);var incoming=@zeros([66]u32);
var first_normalized=@zeros([64]u32);const np:[*]u32=&first_normalized;
var audit=@zeros([4]u32);var setup=@zeros([5]u16);var epoch:u32=0;var received:u16=0;
var active:bool=false;var finish_requested:bool=false;
const bp:[*]u32=&bank;const ap:[*]u32=&audit;const sp:[*]u16=&setup;const sa:[*]u32=sender.status_pointer;
const iq=@get_input_queue(2);const id=@get_dsr(dsr_dest,2);const is=@get_dsr(dsr_src0,2);const it=@get_local_task_id(8);
fn receive() void {
 const m=@get_dsd(mem1d_dsd,.{.base_address=&incoming,.extent=66});const f=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=66});
 @load_to_dsr(id,m);@load_to_dsr(is,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=it});@mov32(id,is,.{.async=true});
}
fn finish_if_drained() void {
 if(received!=2 or !sender.drained()){return;}active=false;audit[3]=1;
 if(finish_requested){finish_requested=false;sys.unblock_cmd_stream();}
}
task arrived() void {
 @assert(active and received<2 and incoming[0]==epoch and incoming[1]==@as(u32,received));
 const src=@get_dsd(mem1d_dsd,.{.base_address=&incoming[2],.extent=64});
 const dst=@get_dsd(mem1d_dsd,.{.base_address=sender.input,.extent=64});@mov32(dst,src);
 received+=1;audit[1]+=1;
 if(received==1){
  const capture=@get_dsd(mem1d_dsd,.{.base_address=&first_normalized,.extent=64});@mov32(capture,src);
  sender.input_available();receive();}else{sender.successor_available();finish_if_drained();}
}
task drained() void {finish_if_drained();}
fn arm(new_epoch:u32) void {@assert(mixer.drained() and mixer_status[2]==0);
 @assert(!active and (epoch==0 or sender.drained()) and new_epoch>epoch);
 epoch=new_epoch;received=0;active=true;for(@range(u16,4))|i|{audit[i]=0;}audit[0]=epoch;
 sender.begin(epoch);receive();sys.unblock_cmd_stream();
}
fn start() void {sys.unblock_cmd_stream();}
fn finish() void {@assert(!finish_requested and epoch>0);finish_requested=true;finish_if_drained();}
comptime {
 @initialize_queue(iq,.{.color=@get_color(8)});@bind_local_task(arrived,it);@bind_local_task(drained,dt);
 
 
}

// Composition port: the future conv/gate/residual consumer receives this local
// root notification. Until connected, root data stays leased for explicit
// consume; no synthetic neural result or fake automatic completion is emitted.
param mixer_rank_parity:u16;param mixer_input48_queue:u16;param mixer_can_root:bool;
const mrt=@get_local_task_id(25);const mdt=@get_local_task_id(26);
const mixer=@import_module("mixer_projection.csl",.{.rank_parity=mixer_rank_parity,.bank_words=bank_words,
 .input48_queue=mixer_input48_queue,.can_root=mixer_can_root,.root_ready_task=mrt,.drained_task=mdt});
var mixer_status=@zeros([4]u32);const msp:[*]u32=&mixer_status;
const msetup:[*]u16=mixer.setup_pointer;const maudit:[*]u32=mixer.audit_pointer;
const mout:[*]u32=mixer.root_output;
task mixer_root_ready() void {
 @assert(mixer_status[2]==0);mixer_status[0]=mout[0];mixer_status[1]=mout[1];mixer_status[2]=1;
}
task mixer_drained() void {mixer_status[3]+=1;}
fn mixer_begin(request:u32,generation:u32,projection:u16) void {
 @assert(!active);
 @assert(mixer_status[2]==0);mixer.begin(bp,request,generation,projection);sys.unblock_cmd_stream();
}
fn mixer_consume(generation:u32,row:u16) void {
 @assert(mixer_status[2]==1);mixer_status[2]=0;mixer.root_consumed(generation,row);sys.unblock_cmd_stream();
}
comptime {
 @bind_local_task(mixer_root_ready,mrt);@bind_local_task(mixer_drained,mdt);
 
 
 
}

// Segment IDs are a device ABI, never arbitrary host-provided pointers.
const device_task=@get_local_task_id(24);
fn device_transfer() void {
 const c=sys.command;const segment=c[2];const first=c[3];const length=c[4];
 @assert(length>0 and length<=256 and first<65536 and first+length<65536);
 var pointer:[*]u32=bp;var half:[*]u16=msetup;var extent:u32=0;var bits:u16=32;var writable:bool=false;
 if(segment==0){pointer=bp;extent=@as(u32,bank_words);writable=true;}
 else if(segment==1){half=msetup;extent=40;bits=16;writable=true;}
 else if(segment==2){pointer=maudit;extent=6;}
 else if(segment==3){pointer=msp;extent=4;}
 else if(segment==4){pointer=mout;extent=5;}
 else if(segment==5){pointer=np;extent=64;}
 else if(segment==6){pointer=sa;extent=4;}
 else if(segment==8){pointer=ap;extent=4;}
 else{@assert(false);}
 @assert(first+length<=extent);
 if(c[1]==0){
  @assert(writable and mixer.drained() and mixer_status[2]==0);@assert(!active);
  if(bits==32){sys.write32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{sys.write16(@ptrcast([*]u16,&half[@as(u16,first)]),@as(u16,length));}
 }else{
  @assert(c[1]==1);
  if(bits==32){sys.read32(@ptrcast([*]u32,&pointer[@as(u16,first)]),@as(u16,length));}
  else{sys.read16(@ptrcast([*]u16,&half[@as(u16,first)]),@as(u16,length));}
 }
}
task device_command() void {
 const c=sys.command;
 if(c[1]<2){device_transfer();}
 else if(c[1]==2){arm(c[2]);}
 else if(c[1]==3){start();}
 else if(c[1]==4){finish();}
 else if(c[1]==5){@assert(c[4]<5);mixer_begin(c[2],c[3],@as(u16,c[4]));}
 else if(c[1]==6){@assert(c[3]<65536);mixer_consume(c[2],@as(u16,c[3]));}
 else{@assert(false);}
}
comptime {@bind_local_task(device_command,device_task);}
