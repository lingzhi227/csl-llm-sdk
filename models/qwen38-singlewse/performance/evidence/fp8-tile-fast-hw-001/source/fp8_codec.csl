// E4M3FN scalar codec. Adapted from the simulator-qualified weight decoder.
const magnitude_bf16 = [128]u16 {
  0,15104,15232,15296,15360,15392,15424,15456,15488,15504,15520,15536,15552,15568,15584,15600,
  15616,15632,15648,15664,15680,15696,15712,15728,15744,15760,15776,15792,15808,15824,15840,15856,
  15872,15888,15904,15920,15936,15952,15968,15984,16000,16016,16032,16048,16064,16080,16096,16112,
  16128,16144,16160,16176,16192,16208,16224,16240,16256,16272,16288,16304,16320,16336,16352,16368,
  16384,16400,16416,16432,16448,16464,16480,16496,16512,16528,16544,16560,16576,16592,16608,16624,
  16640,16656,16672,16688,16704,16720,16736,16752,16768,16784,16800,16816,16832,16848,16864,16880,
  16896,16912,16928,16944,16960,16976,16992,17008,17024,17040,17056,17072,17088,17104,17120,17136,
  17152,17168,17184,17200,17216,17232,17248,17264,17280,17296,17312,17328,17344,17360,17376,32704
};

fn decode(code: u16) f32 {
  const bits: u16 = magnitude_bf16[code & 127] | ((code & 128) << 8);
  return @bitcast(f32, @as(u32, bits) << 16);
}

fn encode(value: f32) u16 {
  const bits: u32 = @bitcast(u32, value);
  @assert((bits & 2139095040) != 2139095040);
  const sign: u16 = @as(u16, (bits >> 24) & 128);
  const magnitude: f32 = @bitcast(f32, bits & 2147483647);
  if (magnitude >= 448.0) { return sign | 126; }
  var lower: u16 = 0;
  var upper: u16 = 126;
  while (lower < upper) {
    const middle: u16 = (lower + upper) / 2;
    if (decode(middle) < magnitude) { lower = middle + 1; }
    else { upper = middle; }
  }
  if (upper == 0) { return sign; }
  const before: u16 = upper - 1;
  const lower_distance: f32 = magnitude - decode(before);
  const upper_distance: f32 = decode(upper) - magnitude;
  if (upper_distance < lower_distance or (upper_distance == lower_distance and (upper & 1) == 0)) {
    return sign | upper;
  }
  return sign | before;
}
