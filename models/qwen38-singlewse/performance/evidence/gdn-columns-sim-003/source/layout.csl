const memcpy=@import_module("<memcpy/get_params>",.{.width=3,.height=2});
layout {
 @set_rectangle(3,2);
 @set_tile_code(0,0,"source.csl",.{.memcpy_params=memcpy.get_params(0),.columns=8});
 @set_tile_code(0,1,"worker.csl",.{.memcpy_params=memcpy.get_params(0),.gdn_columns=8,.gdn_first=0,.gdn_head=47,.gdn_state_word=0,.gdn_input_color=3,.gdn_output_color=4,.gdn_input_queue=2});
 @set_color_config(0,0,@get_color(3),.{.routes=.{.rx=.{RAMP},.tx=.{SOUTH}}});
 @set_color_config(0,1,@get_color(3),.{.routes=.{.rx=.{NORTH},.tx=.{RAMP}}});
 @set_color_config(0,1,@get_color(4),.{.routes=.{.rx=.{RAMP},.tx=.{NORTH}}});
 @set_color_config(0,0,@get_color(4),.{.routes=.{.rx=.{SOUTH},.tx=.{RAMP}}});
 @set_tile_code(1,0,"source.csl",.{.memcpy_params=memcpy.get_params(1),.columns=8});
 @set_tile_code(1,1,"worker.csl",.{.memcpy_params=memcpy.get_params(1),.gdn_columns=8,.gdn_first=120,.gdn_head=45,.gdn_state_word=0,.gdn_input_color=3,.gdn_output_color=4,.gdn_input_queue=2});
 @set_color_config(1,0,@get_color(3),.{.routes=.{.rx=.{RAMP},.tx=.{SOUTH}}});
 @set_color_config(1,1,@get_color(3),.{.routes=.{.rx=.{NORTH},.tx=.{RAMP}}});
 @set_color_config(1,1,@get_color(4),.{.routes=.{.rx=.{RAMP},.tx=.{NORTH}}});
 @set_color_config(1,0,@get_color(4),.{.routes=.{.rx=.{SOUTH},.tx=.{RAMP}}});
 @set_tile_code(2,0,"source.csl",.{.memcpy_params=memcpy.get_params(2),.columns=32});
 @set_tile_code(2,1,"worker.csl",.{.memcpy_params=memcpy.get_params(2),.gdn_columns=32,.gdn_first=0,.gdn_head=2,.gdn_state_word=0,.gdn_input_color=3,.gdn_output_color=4,.gdn_input_queue=2});
 @set_color_config(2,0,@get_color(3),.{.routes=.{.rx=.{RAMP},.tx=.{SOUTH}}});
 @set_color_config(2,1,@get_color(3),.{.routes=.{.rx=.{NORTH},.tx=.{RAMP}}});
 @set_color_config(2,1,@get_color(4),.{.routes=.{.rx=.{RAMP},.tx=.{NORTH}}});
 @set_color_config(2,0,@get_color(4),.{.routes=.{.rx=.{SOUTH},.tx=.{RAMP}}});
 @export_name("state",[*]u32,false);
 @export_name("status",[*]u32,false);
 @export_name("wire",[*]u32,false);
 @export_name("frames",[*]u32,false);
 @export_name("begin",fn()void);
 @export_name("clear",fn()void);
 @export_name("inspect",fn()void);
 @export_name("exchange",fn()void);
}
