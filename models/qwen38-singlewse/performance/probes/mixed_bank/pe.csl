// Full resident 112 FP8 / 12 BF16 banks; typed local dispatch and static tree.
param memcpy_params;param rank:u16;param children:u16;param subtree:u16;param fp8_slots:u16;param bf16_slots:u16;
param left_color:u16;param right_color:u16;param out_color:u16;param left_iq:u16;param right_iq:u16;param tree_oq:u16;
param left_task:u16;param right_task:u16;param send_task:u16;param left_dsr:u16;param right_dsr:u16;param send_dsr:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);const clock=@import_module("<time>");
const unpacker=@import_module("fp8_unpack.csl",.{.max_pairs=128});const fp8=@import_module("fp8_dot.csl",.{.rows=2});const bf_dot=@import_module("bf16_dot.csl",.{.rows=2});
var weights=@zeros([fp8_slots*128]u16);var scale=@zeros([fp8_slots]f32);var bfweights=@zeros([bf16_slots*256]u16);
var control=@zeros([2]u16);var packet=@zeros([65]u32);var decoded=@zeros([256]u16);
var local_result=@zeros([2]f32);var aggregate=@zeros([3]u32);var left=@zeros([3]u32);var right=@zeros([3]u32);var audit=@zeros([6]u32);var ticks=@zeros([6]u16);
const wp:[*]u16=&weights;const sp:[*]f32=&scale;const bp:[*]u16=&bfweights;const cp:[*]u16=&control;const pp:[*]u32=&packet;
const lp:[*]f32=&local_result;const gp:[*]u32=&aggregate;const ap:[*]u32=&audit;const tp:[*]u16=&ticks;
const qi=@get_input_queue(left_iq);const qj=@get_input_queue(right_iq);const qo=@get_output_queue(tree_oq);
const ld=@get_dsr(dsr_dest,left_dsr);const ls=@get_dsr(dsr_src0,left_dsr);const rd=@get_dsr(dsr_dest,right_dsr);const rs=@get_dsr(dsr_src0,right_dsr);const sd=@get_dsr(dsr_dest,send_dsr);const ss=@get_dsr(dsr_src0,send_dsr);
const lt=@get_local_task_id(left_task);const rt=@get_local_task_id(right_task);const st=@get_local_task_id(send_task);
var armed:bool=false;var local_ready:bool=false;var left_ready:bool=false;var right_ready:bool=false;var joined:bool=false;
fn finish() void {audit[5]=1;armed=false;sys.unblock_cmd_stream();}
fn join() void {
 if(local_ready and left_ready and right_ready and !joined){joined=true;
  var a:f32=local_result[0];var b:f32=local_result[1];var contributors:u32=1;
  if(comptime children>0){a+=@bitcast(f32,left[0]);b+=@bitcast(f32,left[1]);contributors+=left[2];}
  if(comptime children>1){a+=@bitcast(f32,right[0]);b+=@bitcast(f32,right[1]);contributors+=right[2];}
  aggregate[0]=@bitcast(u32,a);aggregate[1]=@bitcast(u32,b);aggregate[2]=contributors;audit[3]=1;@assert(contributors==@as(u32,subtree));
  if(comptime rank==0){clock.get_timestamp(@ptrcast(*[3]u16,&ticks[3]));clock.disable_tsc();finish();}
  else{
   const m=@get_dsd(mem1d_dsd,.{.base_address=&aggregate,.extent=3});const f=@get_dsd(fabout_dsd,.{.output_queue=qo,.extent=3});
   @load_to_dsr(ss,m);@load_to_dsr(sd,f,.{.async=true,.activate=st});@mov32(sd,ss,.{.async=true});
  }
 }
}
task received_left() void {left_ready=true;audit[2]+=1;join();}
task received_right() void {right_ready=true;audit[2]+=1;join();}
task sent() void {audit[4]=1;finish();}
fn arm() void {
 @assert(!armed and control[0]<=1);if(control[0]==0){@assert(control[1]<fp8_slots);}else{@assert(control[1]<bf16_slots);}
 armed=true;local_ready=false;joined=false;left_ready=children==0;right_ready=children<2;
 for(@range(u16,6))|i|{audit[i]=0;}audit[0]=1;
 if(comptime children>0){
  const m=@get_dsd(mem1d_dsd,.{.base_address=&left,.extent=3});const f=@get_dsd(fabin_dsd,.{.input_queue=qi,.extent=3});
  @load_to_dsr(ld,m);@load_to_dsr(ls,f,.{.async=true,.activate=lt});@mov32(ld,ls,.{.async=true});
 }
 if(comptime children>1){
  const m=@get_dsd(mem1d_dsd,.{.base_address=&right,.extent=3});const f=@get_dsd(fabin_dsd,.{.input_queue=qj,.extent=3});
  @load_to_dsr(rd,m);@load_to_dsr(rs,f,.{.async=true,.activate=rt});@mov32(rd,rs,.{.async=true});
 }
 sys.unblock_cmd_stream();
}
fn start() void {
 @assert(armed and !local_ready);
 if(comptime rank==0){clock.enable_tsc();clock.get_timestamp(@ptrcast(*[3]u16,&ticks[0]));}
 const slot=control[1];
 if(control[0]==0){unpacker.decode(@ptrcast([*]u16,&weights[slot*128]),&decoded,128);fp8.compute(&decoded,@ptrcast([*]u16,pp),lp,@bitcast(f32,packet[64]),scale[slot]);}
 else{bf_dot.compute(@ptrcast([*]u16,&bfweights[slot*256]),@ptrcast([*]u16,pp),lp);}
 local_ready=true;audit[1]=1;join();
}
comptime {
 if(children>0){@initialize_queue(qi,.{.color=@get_color(left_color)});@bind_local_task(received_left,lt);}
 if(children>1){@initialize_queue(qj,.{.color=@get_color(right_color)});@bind_local_task(received_right,rt);}
 if(rank>0){@initialize_queue(qo,.{.color=@get_color(out_color)});@bind_local_task(sent,st);}
 @export_symbol(wp,"weights");@export_symbol(sp,"scale");@export_symbol(bp,"bfweights");@export_symbol(cp,"control");@export_symbol(pp,"packet");@export_symbol(lp,"local_result");@export_symbol(gp,"aggregate");@export_symbol(ap,"audit");@export_symbol(tp,"ticks");@export_symbol(arm);@export_symbol(start);
}
