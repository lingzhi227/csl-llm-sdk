param memcpy_params;param group:u16;param total_frames:u16;param total_workers:u16;param input_color:u16;param output_color:u16;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const ctrl=@import_module("<control>");const tile=@import_module("<tile_config>");
const iq=@get_input_queue(2);const oq=@get_output_queue(2);
const ds=@get_dsr(dsr_src0,2);const dd=@get_dsr(dsr_dest,2);const done=@get_local_task_id(8);
var wire=@zeros([1161]u32);var frame=@zeros([5]u32);var audit=@zeros([8]u32);
const wp:[*]u32=&wire;const ap:[*]u32=&audit;
var waiting:bool=false;var phase:u16=0;var heads:u16=0;var frames:u16=0;var target:u16=0;var token:u32=0;
fn receive() void {
 phase=1;
 const m=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u32,&wire[387*heads]),.extent=387});
 const f=@get_dsd(fabin_dsd,.{.input_queue=iq,.extent=387});
 @load_to_dsr(dd,m);@load_to_dsr(ds,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=done});@mov32(dd,ds,.{.async=true});
}
fn emit_frame() void {
 phase=2;frame[0]=token;frame[1]=@as(u32,group)*384+2*@as(u32,frames);frame[2]=2;
 frame[3]=(token*104729)^@as(u32,frames)^0x3f807e11;frame[4]=5;
 const m=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=5});
 const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=5});
 @load_to_dsr(ds,m);@load_to_dsr(dd,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=done});@mov32(dd,ds,.{.async=true});
}
fn advance() void {
 if(frames<target){emit_frame();}
 else if(heads<3){receive();}
 else{phase=0;audit[0]=1;audit[1]=frames;audit[2]=heads;if(waiting){waiting=false;sys.unblock_cmd_stream();}}
}
task completed() void {
 if(phase==1){
  if(heads==0){token=wire[0];}else{@assert(wire[387*heads]==token);}
  heads+=1;target=if(heads==1)total_frames/3 else if(heads==2)(2*total_frames+2)/3 else total_frames;emit_frame();
 }else if(phase==2){
  frames+=1;
  if(@as(u32,frames)*@as(u32,total_workers)/@as(u32,total_frames)>audit[3]){
   phase=3;tile.switch_config.clear_current_position(@get_color(output_color));
   frame[0]=ctrl.encode_payload(1,[1]ctrl.opcode{ctrl.opcode.SWITCH_ADV},[1]bool{false},false,@get_control_task_id(40));
   const m=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=1});
   const f=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=1,.control=true});
   @load_to_dsr(ds,m);@load_to_dsr(dd,f,.{.async=true,.ut_id=@get_ut_id(2),.activate=done});@mov32(dd,ds,.{.async=true});
  }else{advance();}
 }else{@assert(phase==3);audit[3]+=1;advance();}
}
fn probe_arm() void {@assert(phase==0);heads=0;frames=0;for(@range(u16,8))|i|{audit[i]=0;}receive();sys.unblock_cmd_stream();}
fn probe_send() void {sys.unblock_cmd_stream();}
fn probe_wait() void {if(phase==0){sys.unblock_cmd_stream();}else{waiting=true;}}
fn bridge_inspect() void {sys.unblock_cmd_stream();}
comptime {
 @initialize_queue(iq,.{.color=@get_color(input_color)});@initialize_queue(oq,.{.color=@get_color(output_color)});@bind_local_task(completed,done);
 @export_symbol(wp,"wire");@export_symbol(ap,"probe_audit");
 @export_symbol(probe_arm);@export_symbol(probe_send);@export_symbol(probe_wait);@export_symbol(bridge_inspect);
}
