// Cold control ABI for a native MLP PE. No neural buffers are writable while
// their projection, sender or fused-consumer lease remains active.
const device_task=@get_local_task_id(24);
fn device_idle() void {
 @assert(!running and !finish_requested);
 if(comptime mlp_sender){@assert(epoch==0 or sender.drained());}
 if(comptime fusion_actor){@assert(actor.drained());}
}
fn device_transfer() void {
 const c=sys.command;const segment=c[2];
 @assert(c[4]>0 and c[4]<=256 and c[3]<65536 and c[3]+c[4]<65536);
 const first=@as(u16,c[3]);const length=@as(u16,c[4]);
 var pointer:[*]u32=bp;var half:[*]u16=sp;var extent:u16=0;var bits:u16=32;var writable:bool=false;
 if(segment==0){pointer=bp;extent=bank_words;writable=true;}
 else if(segment==1){half=sp;extent=6;bits=16;writable=true;}
 else if(segment==2){pointer=ap;extent=4;}
 else if(segment==3){half=nip;extent=max_parts*columns;bits=16;}
 else if(segment==4){pointer=@ptrcast([*]u32,nsp);extent=max_parts;}
 else if(segment==5){
  if(comptime mlp_sender){pointer=qp;extent=if(input_quantizer) 64 else 1;writable=input_quantizer;}
  else{@assert(false);}
 }
 else if(segment==6){if(comptime mlp_sender){pointer=sa;extent=4;}else{@assert(false);}}
 else if(segment==7){
  if(comptime fusion_actor and mlp_component){half=sl;extent=3328;bits=16;writable=true;}else{@assert(false);}
 }
 else if(segment==8){pointer=fp;extent=2;}
 else{@assert(false);}
 @assert(first+length<=extent);
 if(c[1]==0){
  @assert(writable);device_idle();
  if(bits==32){sys.write32(@ptrcast([*]u32,&pointer[first]),length);}
  else{sys.write16(@ptrcast([*]u16,&half[first]),length);}
 }else{
  @assert(c[1]==1);
  if(bits==32){sys.read32(@ptrcast([*]u32,&pointer[first]),length);}
  else{if(comptime sys.routed){@assert(first%2==0 and length%2==0);}sys.read16(@ptrcast([*]u16,&half[first]),length);}
 }
}
task device_command() void {
 const c=sys.command;
 if(c[1]<2){device_transfer();}
 else if(c[1]==2){device_idle();arm(c[2]);}
 else if(c[1]==3){start();}
 else if(c[1]==4){finish();}
 else if(c[1]==5){
  @assert(c[2]<3 and c[4]<65536 and c[5]<65536);
  fusion_step(@as(u16,c[2]),c[3],@as(u16,c[4]),@as(u16,c[5]));
 }
 else{@assert(false);}
}
comptime {@bind_local_task(device_command,device_task);}
