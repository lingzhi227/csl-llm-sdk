// Serialized stage-control gateway. Borrow the idle controller's frame and
// packet; preserve neural output/successor arrays. Commands use two tagged
// low-half words per logical32-bit word. Responses are ordinary32-bit words.
// A reply can overwrite frame only after every command word has been encoded:
// the selected worker replies only after consuming the complete command body.
const device_command:[*]u32=&frame;const device_response:[*]u32=&frame;
var device_submission=@zeros([4]u32);var device_submit_cursor:u16=0;
var device_audit=@zeros([4]u32);const device_ap:[*]u32=&device_audit;
var device_gateway_active:bool=false;var device_tx_done:bool=false;var device_rx_done:bool=false;
var device_words:u16=0;var device_replies:u16=0;var device_cursor:u16=0;
var device_reply_values:u16=0;var device_reply_bits:u16=32;
var device_target:u16=0;var device_sequence:u32=0;
const device_tile=@import_module("<tile_config>");
var device_ack_mode:u16=0;
// IQ4/C14 accepts four-word commits. Selector bit30 requests one batch-complete
// event on the SDK C15 stream; bit31 means the command body
// follows inline; clear bit31 retains the P37 preloaded-frame ABI. Blocking
// this private IQ backpressures a coalesced SDK stream until the entire device
// operation retires. No device task changes the SDK-owned command queue.
// Target DEVICE_TARGET_COUNT invokes the shared original operand producer:
// its67-word body is invocation,group,parts and64 original packed BF16 pairs.
const device_submit_iq=@get_input_queue(4);
task device_submit_word(value:u32) void {
 @assert(!device_gateway_active);
 if(device_submit_cursor==0){device_idle();}
 if(device_submit_cursor<4){
  device_submission[device_submit_cursor]=value;device_submit_cursor+=1;
  if(device_submit_cursor<4){return;}
  @assert(device_submission[3]>0 and device_submission[3]==device_audit[0]+1);
  @assert((device_submission[0]&1073741823)<=DEVICE_TARGET_COUNT);
  @assert(device_submission[1]>=6 and device_submission[1]<=262 and device_submission[2]<=260);
  if((device_submission[0]&2147483648)!=0){return;}
 }else{
  @assert((device_submission[0]&2147483648)!=0);
  @assert(@as(u32,device_submit_cursor-4)<device_submission[1]);
  frame[device_submit_cursor-4]=value;device_submit_cursor+=1;
  if(@as(u32,device_submit_cursor-4)<device_submission[1]){return;}
 }
 device_submit_cursor=0;@block(device_submit_iq);
 const target=@as(u16,device_submission[0]&1073741823);const words=@as(u16,device_submission[1]);const replies=@as(u16,device_submission[2]);
 if(target==DEVICE_TARGET_COUNT){
  @assert(words==67 and replies==0 and frame[0]>0);
  @assert((frame[2]==40 or frame[2]==48) and frame[1]<frame[2]);
  mixer_emit_operand(@ptrcast([*]u32,&frame[3]),frame[0],@as(u16,frame[1]),@as(u16,frame[2]));
  // Local tasks do not preempt this task. Publish ownership before the
  // asynchronous producer completion callback can run.
  device_gateway_active=true;device_target=target;
  device_audit[1]=@as(u32,target);device_audit[2]=frame[0];device_audit[3]=7;
 }else{device_exchange(target,words,replies);}
}
const device_oq=@get_output_queue(7);const device_iq=@get_input_queue(3);
const device_td=@get_dsr(dsr_dest,4);const device_ts=@get_dsr(dsr_src0,4);
const device_rd=@get_dsr(dsr_dest,5);const device_rs=@get_dsr(dsr_src0,5);
const device_tt=@get_local_task_id(12);const device_rt=@get_local_task_id(13);
fn device_finish() void {
 if(!device_tx_done or !device_rx_done){return;}
 @assert(device_gateway_active and frame[0]==device_sequence and frame[1]==0);
 @assert(frame[2]==@as(u32,device_reply_values) and frame[3]==@as(u32,device_reply_bits));
 device_retire();
}
fn device_retire() void {
 device_audit[0]+=1;
 if((device_submission[0]&1073741824)!=0){
  // Borrow OQ7 only after its command data drains; every other OQ belongs to
  // the retained neural/SDK programs. Keep IQ4 blocked through the event drain.
  @assert(device_ack_mode==0);device_ack_mode=1;@queue_flush(device_oq);
 }else{device_gateway_active=false;@unblock(device_submit_iq);}
}
fn device_output_empty() void {
 @assert(device_gateway_active and (device_ack_mode==1 or device_ack_mode==3));
 device_tile.queue_flush.exit(device_oq);
 if(device_ack_mode==1){
  device_tile.output_queue_config.encode_output_queue(7,15);device_ack_mode=2;
  const m=@get_dsd(mem1d_dsd,.{.base_address=&device_audit,.extent=4});
  const f=@get_dsd(fabout_dsd,.{.output_queue=device_oq,.extent=4});
  @load_to_dsr(device_ts,m);@load_to_dsr(device_td,f,.{.async=true,.ut_id=@get_ut_id(6),.activate=device_tt});@mov32(device_td,device_ts,.{.async=true});
 }else{
  device_tile.output_queue_config.encode_output_queue(7,12);device_ack_mode=0;
  device_gateway_active=false;@unblock(device_submit_iq);
 }
}
fn device_operand_complete() void {
 @assert(device_gateway_active and device_target==DEVICE_TARGET_COUNT and device_audit[3]==7);
 device_retire();
}
fn device_send_chunk() void {
 @assert(device_gateway_active and !device_tx_done and device_cursor<device_words);
 var count:u16=device_words-device_cursor;if(count>packet_words/2){count=packet_words/2;}
 const source0=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u16,&frame[device_cursor]),.extent=2});
 const source=@set_dsd_length(source0,2*count);
 const low0=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]u16,&packet),.extent=2,.stride=2});
 const low=@set_dsd_length(low0,2*count);const high=@increment_dsd_offset(low,1,u16);
 @load_to_dsr(device_ts,source);@load_to_dsr(device_td,low);@mov16(device_td,device_ts);
 @load_to_dsr(device_td,high);@mov16(device_td,device_target);
 device_cursor+=count;
 const memory0=@get_dsd(mem1d_dsd,.{.base_address=&packet,.extent=2});const memory=@set_dsd_length(memory0,2*count);
 const fabric0=@get_dsd(fabout_dsd,.{.output_queue=device_oq,.extent=2});const fabric=@set_dsd_length(fabric0,2*count);
 @load_to_dsr(device_ts,memory);@load_to_dsr(device_td,fabric,.{.async=true,.ut_id=@get_ut_id(6),.activate=device_tt});@mov32(device_td,device_ts,.{.async=true});
}
task device_sent() void {
 if(device_ack_mode==2){device_ack_mode=3;@queue_flush(device_oq);return;}
 @assert(device_gateway_active and !device_tx_done);
 if(device_cursor<device_words){device_send_chunk();}else{device_tx_done=true;device_finish();}
}
task device_received() void {
 @assert(device_gateway_active and !device_rx_done and device_cursor==device_words);
 device_rx_done=true;device_finish();
}
fn device_exchange(target:u16,words:u16,replies:u16) void {
 @assert(!device_gateway_active);device_idle();
 @assert(target<DEVICE_TARGET_COUNT and words>=6 and words<=262 and replies>=4 and replies<=260);
 if(frame[1]==0){@assert(frame[4]>0 and frame[4]<=256);}
 @assert(words==6+(if(frame[1]==0) @as(u16,frame[4]) else @as(u16,0)));
 device_reply_values=0;device_reply_bits=32;
 var body:u16=0;
 if(frame[1]==1){
  @assert(frame[4]>0 and frame[4]<=256);device_reply_values=@as(u16,frame[4]);body=device_reply_values;
  if(frame[2]==1){@assert(frame[3]%2==0 and frame[4]%2==0);device_reply_bits=16;body/=2;}
 }
 @assert(replies==4+body);
 device_gateway_active=true;device_tx_done=false;device_rx_done=false;device_words=words;device_replies=replies;device_cursor=0;
 device_target=target;device_sequence=frame[0];device_audit[1]=@as(u32,target);device_audit[2]=frame[0];device_audit[3]=frame[1];
 const memory0=@get_dsd(mem1d_dsd,.{.base_address=&frame,.extent=1});const memory=@set_dsd_length(memory0,replies);
 const fabric0=@get_dsd(fabin_dsd,.{.input_queue=device_iq,.extent=1});const fabric=@set_dsd_length(fabric0,replies);
 @load_to_dsr(device_rd,memory);@load_to_dsr(device_rs,fabric,.{.async=true,.ut_id=@get_ut_id(7),.activate=device_rt});@mov32(device_rd,device_rs,.{.async=true});
 device_send_chunk();
}
fn device_idle() void {
 @assert(!active and !mixer_operand_busy and !response_pending and !frame_ready and !packet_busy and !grant_busy);
 @assert(epoch==0 or cursor==grant_count);
}
comptime {
 @comptime_assert(packet_words>=12);
 @initialize_queue(device_oq,.{.color=@get_color(12)});@initialize_queue(device_iq,.{.color=@get_color(13)});
 @initialize_queue(device_submit_iq,.{.color=@get_color(14)});@bind_data_task(device_submit_word,@get_data_task_id(device_submit_iq));
 @bind_local_task(device_sent,device_tt);@bind_local_task(device_received,device_rt);
 @set_empty_queue_handler(device_output_empty,device_oq);@unblock(device_tile.teardown.get_task_id());
 @export_symbol(device_command,"device_command");@export_symbol(device_response,"device_response");
 @export_symbol(device_ap,"device_audit");
}
