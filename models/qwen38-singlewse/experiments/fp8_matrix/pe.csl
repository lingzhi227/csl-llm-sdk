// Complete 17408x5120 gate projection: broadcast down, reduce across each row.
param memcpy_params;
param column:u16;
param tile_row:u16;
param quantizer:bool;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const quant=@import_module("fp8_activation.csl");
const kernel=@import_module("fp8_matrix_block.csl",.{.rows=272,.row_phase=(tile_row*272)%128});
var weights=@zeros([if(quantizer) 1 else 17408]u16);
var scales=@zeros([if(quantizer) 1 else 3]f32);
var input=@zeros([if(quantizer) 128 else 1]f32);
var codes=@zeros([if(quantizer) 128 else 1]u16);
var activation_scale=@zeros([1]f32);
var packet=@zeros([33]u32);
var output=@zeros([if(quantizer) 1 else 272]f32);
var calls=@zeros([1]u32);
const wp:[*]u16=&weights;const sp:[*]f32=&scales;
const xp:[*]f32=&input;const pp:[*]u32=&packet;
const yp:[*]f32=&output;const cp:[*]u32=&calls;
const input_done=@get_local_task_id(8);
const sent_done=@get_local_task_id(9);
const reduction_done=@get_local_task_id(10);
const iq_input=@get_input_queue(2);
const iq_reduce=@get_input_queue(3);
const oq=@get_output_queue(if(quantizer) 2 else 3);
const rx_dst=@get_dsr(dsr_dest,3);const rx_src=@get_dsr(dsr_src1,3);
const tx_dst=@get_dsr(dsr_dest,4);const tx_src=@get_dsr(dsr_src1,4);
fn finish() void {calls[0]+=1;sys.unblock_cmd_stream();}
fn send(data:[*]u32,count:u16) void {
  const mem=@get_dsd(mem1d_dsd,.{.base_address=data,.extent=count});
  const wire=@get_dsd(fabout_dsd,.{.output_queue=oq,.extent=1});
  @load_to_dsr(tx_src,mem);
  @load_to_dsr(tx_dst,@set_dsd_length(wire,count),.{.async=true,.activate=sent_done});
  @mov32(tx_dst,tx_src,.{.async=true});
}
fn projection_ready() void {
  if(comptime column==39){finish();}
  else {send(@ptrcast([*]u32,yp),272);}
}
task input_received() void {
  kernel.compute(wp,sp,pp,yp);
  if(comptime column==0){projection_ready();}
  else {
    const mem=@get_dsd(mem1d_dsd,.{.base_address=kernel.reduction_buffer(),.extent=272});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=iq_reduce,.extent=272});
    @load_to_dsr(rx_dst,mem);
    @load_to_dsr(rx_src,wire,.{.async=true,.activate=reduction_done});
    @mov32(rx_dst,rx_src,.{.async=true});
  }
}
task reduced() void {kernel.add_previous(yp);projection_ready();}
task sent() void {finish();}
fn compute() void {
  if(comptime quantizer){
    quant.quantize(xp,&codes,&activation_scale);
    for(@range(u16,32))|i|{
      packet[i]=@as(u32,codes[4*i])|(@as(u32,codes[4*i+1])<<8)
        |(@as(u32,codes[4*i+2])<<16)|(@as(u32,codes[4*i+3])<<24);
    }
    packet[32]=@bitcast(u32,activation_scale[0]);send(pp,33);
  }else{
    const mem=@get_dsd(mem1d_dsd,.{.base_address=pp,.extent=33});
    const wire=@get_dsd(fabin_dsd,.{.input_queue=iq_input,.extent=33});
    @load_to_dsr(rx_dst,mem);
    @load_to_dsr(rx_src,wire,.{.async=true,.activate=input_done});
    @mov32(rx_dst,rx_src,.{.async=true});
  }
}
comptime {
  if(!quantizer){
    @initialize_queue(iq_input,.{.color=@get_color(3)});
    @bind_local_task(input_received,input_done);
    if(column>0){
      @initialize_queue(iq_reduce,.{.color=@get_color(4+(column+1)%2)});
      @bind_local_task(reduced,reduction_done);
    }
  }
  if(quantizer or column<39){
    @initialize_queue(oq,.{.color=@get_color(if(quantizer) 3 else 4+column%2)});
    @bind_local_task(sent,sent_done);
  }
  @export_symbol(wp,"weights");@export_symbol(sp,"scales");
  @export_symbol(xp,"input");@export_symbol(pp,"packet");
  @export_symbol(yp,"output");@export_symbol(cp,"calls");
  @export_symbol(compute);
}
