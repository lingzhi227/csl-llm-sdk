// Commands1=BF16 operand,2=reduce,3=collect,4=finish,5=embedding row. Every endpoint drains each frame.
// This finite test controller is not a complete model executor.
param memcpy_params;param x:u16;param y:u16;
param controller:bool;param weight:bool;param first:bool;param last:bool;param embedding:bool;
const sys=@import_module("<memcpy/memcpy>",memcpy_params);
const kernel=@import_module("bf16_resident.csl",.{.rows=140});
var weights=@zeros([if(weight) 17920 else 1]u16);
var controls=@zeros([2]u32);var winner=@zeros([2]u32);
// Once-loaded matrix identity and local contraction index.
var config=@zeros([2]u32);
var frame=@zeros([70]u32);
var output=@zeros([if(weight) 140 else 1]f32);
var input=@zeros([if(controller) 384 else 1]u16);
var results=@zeros([if(controller) 792 else 1]f32);

// Frames received, projections computed, reductions completed, returned rows,
// request calls, last command sequence.
var trace=@zeros([6]u32);
var matrix:u16=1;var group:u16=0;var row:u16=0;var stage:u16=0;
var sequence:u32=0;
var call_pending:bool=false;var call_done:bool=false;
const wp:[*]u16=&weights;const ctl:[*]u32=&controls;const win:[*]u32=&winner;const cfg:[*]u32=&config;
const xp:[*]u16=&input;const resultp:[*]f32=&results;const tp:[*]u32=&trace;
const fp:[*]u32=&frame;const op:[*]f32=&output;
const broadcast_iq=@get_input_queue(2);const broadcast_oq=@get_output_queue(2);
const reduce_iq=@get_input_queue(3);const reduce_oq=@get_output_queue(3);
const east_iq=@get_input_queue(4);const east_oq=@get_output_queue(4);
const south_iq=@get_input_queue(5);const south_oq=@get_output_queue(5);
const command_done=@get_local_task_id(8);const broadcast_done=@get_local_task_id(9);
const reduce_done=@get_local_task_id(10);const reduce_sent=@get_local_task_id(11);
const return_done=@get_local_task_id(12);
const relay_done=@get_local_task_id(13);
const command_dst=@get_dsr(dsr_dest,2);const command_src=@get_dsr(dsr_src1,2);
const link_dst=@get_dsr(dsr_dest,5);const link_src=@get_dsr(dsr_src1,5);
const return_dst=@get_dsr(dsr_dest,6);const return_src=@get_dsr(dsr_src1,6);
fn arm() void {
  const dst=@get_dsd(mem1d_dsd,.{.base_address=fp,.extent=70});
  const src=@get_dsd(fabin_dsd,.{.input_queue=broadcast_iq,.extent=70});
  @load_to_dsr(command_dst,dst);
  @load_to_dsr(command_src,src,.{.async=true,.activate=command_done});
  @mov32(command_dst,command_src,.{.async=true});
}
fn broadcast() void {
  sequence+=1;frame[4]=sequence;
  const src=@get_dsd(mem1d_dsd,.{.base_address=fp,.extent=70});
  const dst=@get_dsd(fabout_dsd,.{.output_queue=broadcast_oq,.extent=70});
  @load_to_dsr(command_src,src);
  @load_to_dsr(command_dst,dst,.{.async=true,.activate=broadcast_done});
  @mov32(command_dst,command_src,.{.async=true});
}
fn issue() void {
  frame[1]=@as(u32,matrix);frame[2]=0;frame[3]=0;
  if(stage==0){frame[0]=5;frame[2]=controls[matrix-1];}
  else if(stage==1){
    frame[0]=3;frame[2]=@as(u32,group);frame[3]=@as(u32,matrix-1);frame[6]=128;
    if(matrix==2){frame[2]+=4;}
  }else if(stage==2){
    frame[0]=1;frame[2]=@as(u32,group);
    for(@range(u16,64))|i|{frame[5+i]=@as(u32,input[group*128+2*i])|(@as(u32,input[group*128+2*i+1])<<16);}
  }else if(stage==3){frame[0]=2;}
  else if(stage==4){
    frame[0]=3;frame[2]=3;frame[3]=@as(u32,row+2);frame[6]=140;
    if(row==1){frame[2]=6;}
  }else{frame[0]=4;}
  broadcast();
}
task broadcast_sent() void {
  if(stage==0){stage=1;group=0;issue();}
  else if(stage==2){group+=1;if(group==3){stage=3;}issue();}
  else if(stage==3){stage=4;row=0;issue();}
  else if(stage==1 or stage==4){
    var offset:u16=(matrix-1)*256+group*128;
    if(stage==4){offset=512+row*140;}
    var mem=@get_dsd(mem1d_dsd,.{.base_address=@ptrcast([*]f32,&results[offset]),.extent=1});
    var wire=@get_dsd(fabin_dsd,.{.input_queue=south_iq,.extent=1});
    mem=@set_dsd_length(mem,@as(u16,frame[6]));wire=@set_dsd_length(wire,@as(u16,frame[6]));
    @load_to_dsr(return_dst,mem);@load_to_dsr(return_src,wire,.{.async=true,.activate=return_done});
    @mov32(return_dst,return_src,.{.async=true});
  }else{trace[4]+=1;sys.unblock_cmd_stream();}
}
fn reduced_ready() void {
  trace[2]+=1;
  if(comptime last){arm();}
  else{
    const mem=@get_dsd(mem1d_dsd,.{.base_address=op,.extent=140});
    const wire=@get_dsd(fabout_dsd,.{.output_queue=reduce_oq,.extent=140});
    @load_to_dsr(link_src,mem);
    @load_to_dsr(link_dst,wire,.{.async=true,.activate=reduce_sent});
    @mov32(link_dst,link_src,.{.async=true});
  }
}
task reduction_received() void {kernel.add_previous(op);reduced_ready();}
task reduction_sent() void {arm();}
fn send_result(data:[*]f32) void {
  var mem=@get_dsd(mem1d_dsd,.{.base_address=data,.extent=140});
  var wire=@get_dsd(fabout_dsd,.{.output_queue=if(x==8) south_oq else east_oq,.extent=140});
  mem=@set_dsd_length(mem,@as(u16,frame[6]));wire=@set_dsd_length(wire,@as(u16,frame[6]));
  @load_to_dsr(return_src,mem);
  @load_to_dsr(return_dst,wire,.{.async=true,.activate=return_done});
  @mov32(return_dst,return_src,.{.async=true});
}
fn relay(comptime queue:input_queue) void {
  // The expansion/reduction scratch is dead after row reduction. Reuse it;
  // never overwrite another strip's retained projection output while relaying.
  var mem=@get_dsd(mem1d_dsd,.{.base_address=kernel.reduction_buffer(),.extent=140});
  var wire=@get_dsd(fabin_dsd,.{.input_queue=queue,.extent=140});
  mem=@set_dsd_length(mem,@as(u16,frame[6]));wire=@set_dsd_length(wire,@as(u16,frame[6]));
  @load_to_dsr(return_dst,mem);
  @load_to_dsr(return_src,wire,.{.async=true,.activate=relay_done});
  @mov32(return_dst,return_src,.{.async=true});
}
task relayed() void {send_result(kernel.reduction_buffer());}
fn finish_call() void {
  if(call_pending and call_done){
    call_pending=false;call_done=false;trace[4]+=1;sys.unblock_cmd_stream();
  }
}
task command_received() void {
  @assert(frame[4]==trace[5]+1);trace[5]=frame[4];trace[0]+=1;
  if(frame[0]==1){
    if(comptime weight and !embedding){if(frame[1]==config[0] and frame[2]==config[1]){
      kernel.compute(wp,@ptrcast([*]u32,&frame[5]),op);trace[1]+=1;
    }}
    arm();
  }else if(frame[0]==5){
    if(comptime embedding){if(frame[1]==config[0]){kernel.embedding(wp,@as(u16,frame[2]),op);trace[1]+=1;}}
    arm();
  }else if(frame[0]==2){
    if(comptime weight and !embedding){if(frame[1]==config[0]){
      if(comptime first){reduced_ready();}
      else{
        const mem=@get_dsd(mem1d_dsd,.{.base_address=kernel.reduction_buffer(),.extent=140});
        const wire=@get_dsd(fabin_dsd,.{.input_queue=reduce_iq,.extent=140});
        @load_to_dsr(link_dst,mem);
        @load_to_dsr(link_src,wire,.{.async=true,.activate=reduce_done});
        @mov32(link_dst,link_src,.{.async=true});
      }
      return;
    }}
    arm();
  }else if(frame[0]==4){
    call_done=true;arm();finish_call();
  }else{
    @assert(frame[0]==3);
    if(frame[3]==@as(u32,y) and frame[2]<=@as(u32,x)){
      if(frame[2]==@as(u32,x)){
        @assert(weight and (last or embedding) and config[0]==frame[1]);
        send_result(op);
      }else{relay(east_iq);}
    }else if(comptime x==8){
      if(frame[3]<@as(u32,y)){
        relay(south_iq);
      }else{arm();}
    }else{arm();}
  }
}
fn round_bf16(value:f32) f32 {
  const bits=@bitcast(u32,value);return @bitcast(f32,(bits+0x7fff+((bits>>16)&1))&0xffff0000);
}
fn select_token() void {
  var best:f32=round_bf16(results[512]);var id:u32=0;
  for(@range(u16,280))|i|{
    // The last global vocabulary tile contains100 real rows, then40 padding.
    if(i<240){
      const value=round_bf16(results[512+i]);var token:u32=@as(u32,i);
      if(i>=140){token=@as(u32,i-140)+248220;}
      if(value>best or (value==best and token<id)){best=value;id=token;}
    }
  }
  winner[0]=id;winner[1]=@bitcast(u32,best);
}
task returned() void {
  trace[3]+=1;
  if(comptime controller){
    if(stage==1){
      group+=1;
      if(group<2){issue();}
      else if(matrix==1){matrix=2;stage=0;issue();}
      else{matrix=3;stage=2;group=0;issue();}
    }else{
      row+=1;if(row<2){issue();}else{select_token();stage=5;issue();}
    }
  }else{arm();}
}
fn start() void {
  if(comptime !controller){arm();}
  sys.unblock_cmd_stream();
}
fn run_test() void {
  if(comptime controller){matrix=1;stage=0;group=0;row=0;issue();}
  else{call_pending=true;finish_call();}
}
comptime {
  if(controller){
    @initialize_queue(broadcast_oq,.{.color=@get_color(3)});
    @bind_local_task(broadcast_sent,broadcast_done);
  }else{
    @initialize_queue(broadcast_iq,.{.color=@get_color(3)});
    @bind_local_task(command_received,command_done);
  }
  if(weight and !embedding){
    if(!first){@initialize_queue(reduce_iq,.{.color=@get_color(4+(x+1)%2)});@bind_local_task(reduction_received,reduce_done);}
    if(!last){@initialize_queue(reduce_oq,.{.color=@get_color(4+x%2)});@bind_local_task(reduction_sent,reduce_sent);}
  }
  if(x>0){@initialize_queue(east_iq,.{.color=@get_color(8+(x+1)%2)});}
  if(x<8){@initialize_queue(east_oq,.{.color=@get_color(8+x%2)});}
  if(x==8){
    if(y>0){@initialize_queue(south_iq,.{.color=@get_color(10+(y+1)%2)});}
    if(y<4){@initialize_queue(south_oq,.{.color=@get_color(10+y%2)});}
  }
  @bind_local_task(returned,return_done);
  if(!controller){@bind_local_task(relayed,relay_done);}
  @export_symbol(wp,"weights");@export_symbol(ctl,"controls");@export_symbol(win,"winner");@export_symbol(cfg,"config");
  @export_symbol(xp,"input");@export_symbol(resultp,"results");@export_symbol(tp,"trace");
  @export_symbol(start);@export_symbol(run_test);
}
