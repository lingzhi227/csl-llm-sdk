const memcpy=@import_module("<memcpy/get_params>",.{.width=2,.height=1});
layout {
 @set_rectangle(2,1);
 for(@range(i16,2))|x|{@set_tile_code(x,0,"pe.csl",.{.memcpy_params=memcpy.get_params(x),.compensated=x==1});}
 @export_name("input",[*]u16,false);@export_name("gain",[*]u16,false);@export_name("calls",[*]u32,false);
 @export_name("normalize",fn()void);
}
